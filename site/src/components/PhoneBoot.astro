---
import { currentPhone } from "../data/phones.ts";

const { phone: id } = Astro.locals.starlightRoute.entry.data;
if (!id) throw new Error("Phone boot instructions require a phone page.");
const phone = currentPhone(id);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<p>
	Start the launcher from your{" "}
	<a href={`${base}/guides/standalone-archive/`}>ZIP</a>, or run{" "}
	<code>./fplinux run {phone.id}</code> from a{" "}
	<a href={`${base}/start/run/`}>source checkout</a>. Wait until it asks for the
	phone. {phone.bootInstructions}
</p>
