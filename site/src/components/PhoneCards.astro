---
// Phone cards with available screen renders and key support status.
import { LinkButton } from "@astrojs/starlight/components";
import SupportBadge from "./SupportBadge.astro";
import { loadSupport, type SupportStatus } from "../data/support/index.ts";
import { loadPhones } from "../data/phones.ts";

const { phones } = loadPhones();
const support = loadSupport();

const renders = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/screens/terminal-keypad*.png",
	{
		eager: true,
	}
);
const render = (name: string) =>
	renders[`../assets/screens/${name}.png`]?.default;
const highlights = [
	{ feature: "bluetooth", label: "Bluetooth" },
	{ feature: "fm-radio", label: "FM radio" },
	{ feature: "removable-system-root", label: "microSD system" },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const status = (feature: string, phone: string): SupportStatus =>
	support.features.find((item) => item.id === feature)?.phones[phone]?.status ??
	"untested";
---

<div class="fp-phone-cards not-content">
	{phones.map((phone): astroHTML.JSX.Children => {
		const image = phone.render ? render(phone.render) : undefined;
		const scale = phone.renderScale ?? 1;
		const size = `${phone.display.width}×${phone.display.height}`;
		return (
			<article class="card">
				<div class:list={["mini-phone", { "no-render": !image }]}>
					{image && (
						<img
							alt={`FPLinux terminal on the ${phone.name}`}
							class="fp-pixel"
							height={image.height * scale}
							src={image.src}
							width={image.width * scale}
						/>
					)}
					{!image && (
						<p class="screen-note">
							{size} display
							<br />
							<small>
								See the phone checklist for display and input support.
							</small>
						</p>
					)}
				</div>
				<h3>{phone.name}</h3>
				<p class="meta">{`${phone.id} · ${size} display`}</p>
				<ul class="chips">
					{highlights.map((item): astroHTML.JSX.Children => {
						const state = status(item.feature, phone.id);
						return (
							<li>
								<span>{item.label}:</span> <SupportBadge status={state} />
							</li>
						);
					})}
				</ul>
				<LinkButton
					href={`${base}/${phone.slug}/`}
					icon="right-arrow"
					variant="secondary"
				>
					Phone page
				</LinkButton>
			</article>
		);
	})}
</div>

<style>
	.fp-phone-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1.25rem;
		margin-block: 1.5rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1.5rem 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-gray-7);
		text-align: center;
	}

	.mini-phone {
		display: grid;
		place-items: center;
		width: 268px;
		max-width: 100%;
		height: 348px;
		margin-bottom: 0.5rem;
		border-radius: 22px;
		background: #202d35;
	}

	.mini-phone img {
		max-width: 92%;
		height: auto;
	}

	.no-render {
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 1rem;
		background: transparent;
	}

	.screen-note {
		margin: 0;
		padding: 1rem;
		color: var(--sl-color-gray-2);
		line-height: 1.75;
	}

	.screen-note small {
		display: block;
		margin-top: 0.75rem;
		line-height: 1.4;
	}

	h3 {
		margin: 0;
		font-size: var(--sl-text-xl);
	}

	.meta {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.375rem;
		margin: 0.25rem 0 0.75rem;
		padding: 0;
		list-style: none;
	}

	.chips li {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: var(--sl-text-xs);
	}
</style>
