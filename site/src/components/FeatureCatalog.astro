---
import ImplementationBadge from "./ImplementationBadge.astro";
import { loadSupport } from "../data/support/index.ts";

interface Props {
	platform?: string;
}
const { platform } = Astro.props;
const support = loadSupport();
const selectedPlatform = support.platforms.find((item) => item.id === platform);
if (platform !== undefined && !selectedPlatform)
	throw new Error(`Unknown platform: ${platform}`);
const platforms = selectedPlatform ? [selectedPlatform] : support.platforms;

const rows = support.features.filter((item) => item.scope !== "detail");
const groups = support.groups.filter((group) =>
	rows.some((item) => item.group === group)
);
const groupId = (group: string) =>
	`${selectedPlatform ? `${selectedPlatform.id}-` : ""}${group.toLowerCase().replaceAll(" ", "-")}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const guideLink = (slug: string) =>
	`${base}/${slug.replace("#", "/#")}${slug.includes("#") ? "" : "/"}`;
---

<nav aria-label="Feature groups">
	<ul>
		{groups.map((group): astroHTML.JSX.Children => (
			<li>
				<a href={`#${groupId(group)}`}>{group}</a>
			</li>
		))}
	</ul>
</nav>

{groups.map((group): astroHTML.JSX.Children => (
	<section class="feature-group">
		<h3 id={groupId(group)}>{group}</h3>
		<table>
			<caption>Shared platform implementation</caption>
			<thead>
				<tr>
					<th scope="col">Feature</th>
					{platforms.map((item): astroHTML.JSX.Children => (
						<th scope="col">
							<a href={`${base}/platforms/${item.id}/`}>{item.name}</a>
						</th>
					))}
				</tr>
			</thead>
			<tbody>
				{rows
					.filter((item) => item.group === group)
					.map((item): astroHTML.JSX.Children => (
						<tr>
							<th scope="row">
								<a href={guideLink(item.guide)}>{item.label}</a>
							</th>
							{platforms.map((entry): astroHTML.JSX.Children => (
								<td>
									<a
										class="platform-label"
										href={`${base}/platforms/${entry.id}/`}
									>
										{entry.name}
									</a>
									<ImplementationBadge
										status={item.implementations[entry.id]}
									/>
								</td>
							))}
						</tr>
					))}
			</tbody>
		</table>
	</section>
))}

<style>
	.feature-group + .feature-group {
		margin-top: 2rem;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
	}

	table {
		width: 100%;
	}

	th[scope="row"] {
		font-weight: 500;
	}

	.platform-label {
		display: none;
	}

	@media (width <= 40rem) {
		table,
		tbody {
			display: block;
		}

		thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}

		tr {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			padding-block: 0.875rem;
			border-bottom: 1px solid var(--sl-color-gray-5);
		}

		th[scope="row"] {
			flex-basis: 100%;
		}

		th,
		td {
			padding: 0;
			border: 0;
		}

		td {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.35rem 0.5rem;
			flex-basis: 100%;
			font-size: var(--sl-text-sm);
		}

		.platform-label {
			display: inline;
		}
	}
</style>
