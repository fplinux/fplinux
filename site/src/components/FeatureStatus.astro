---
import ImplementationBadge from "./ImplementationBadge.astro";
import { loadSupport } from "../data/support/index.ts";

interface Props {
	feature: string;
}
const { feature } = Astro.props;
const support = loadSupport();
const entry = support.features.find((item) => item.id === feature);
if (!entry) throw new Error(`Unknown feature: ${feature}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<aside
	aria-label={`${entry.label} shared implementation status`}
	class="feature-status"
>
	<strong>{entry.label}</strong>
	<span>Shared platform implementation:</span>
	{support.platforms.map((platform): astroHTML.JSX.Children => (
		<span class="platform-status">
			<a href={`${base}/platforms/${platform.id}/`}>{platform.name}</a>
			<ImplementationBadge status={entry.implementations[platform.id]} />
		</span>
	))}
	<a class="phone-link" href={`${base}/phones/`}>
		Check your phone
	</a>
</aside>

<style>
	.feature-status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.65rem;
		margin-block: 1rem;
		font-size: var(--sl-text-sm);
	}

	.feature-status strong {
		font-weight: 600;
	}

	.platform-status {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}

	.phone-link {
		margin-left: auto;
	}

	@media (width <= 40rem) {
		.phone-link {
			margin-left: 0;
		}
	}
</style>
