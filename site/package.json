{
  "name": "fplinux-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "packageManager": "npm@12.2.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:offline": "node scripts/build-offline.ts",
    "preview": "astro preview",
    "test:offline": "node --test scripts/build-offline.test.ts scripts/offline-search-index.test.ts scripts/phones.test.ts scripts/support.test.ts scripts/notices-markdown.test.ts",
    "test:format": "node --test scripts/mdx-format.test.ts",
    "check": "astro sync && oxlint && eslint . && prettier --config config/prettier.config.mjs --check . && stylelint \"src/**/*.{astro,css}\" && tsc --noEmit && astro check && npm run test:offline && npm run test:format",
    "format": "prettier --config config/prettier.config.mjs --write ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.43.1",
    "@expressive-code/plugin-collapsible-sections": "0.44.4",
    "astro": "7.4.13",
    "smol-toml": "1.9.1",
    "starlight-image-zoom": "0.16.3",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tofrankie/prettier-plugin-compact-markdown-table": "0.0.2",
    "@types/wawoff2": "1.0.2",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "parse5": "8.1.1",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "satteri": "0.11.7",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "stylelint-prettier": "5.1.0",
    "typescript": "6.0.3",
    "ultracite": "8.3.1",
    "wawoff2": "2.0.1"
  }
}
