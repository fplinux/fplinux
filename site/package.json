{
  "name": "fplinux-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:offline": "node scripts/build-offline.ts",
    "preview": "astro preview",
    "test:offline": "node --test scripts/offline-search-index.test.ts",
    "check": "astro sync && oxlint && eslint . && prettier --config config/prettier.config.mjs --check . && stylelint \"src/**/*.{astro,css}\" && astro check && npm run test:offline",
    "format": "prettier --config config/prettier.config.mjs --write ."
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "astro": "7.3.5",
    "starlight-image-zoom": "0.16.0",
    "starlight-links-validator": "0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/wawoff2": "1.0.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "parse5": "7.3.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "typescript": "6.0.3",
    "ultracite": "7.12.4",
    "wawoff2": "2.0.1"
  },
  "overrides": {
    "stylelint-config-idiomatic-order": {
      "stylelint-order": "8.1.1"
    }
  }
}
