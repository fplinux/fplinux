%YAML 1.2
---
examples:
  - |
    chip@10 {
        reg = <0x00000010 0x10>;
    };
additionalProperties: false
required: [reg, compatible]
properties:
  reg:
    const: 0x00000010 # address
  label:
    const: "yes"
title: Demo
# Description stays with its field.
description: 'on'
$schema: https://example.test/schema
$id: https://example.test/demo
x-note: keep
