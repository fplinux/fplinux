[kern]
source = "kern"
binary_sha256 = "binary-hash"

[base]
source = "alpine_environment"
arch = "x86_64"

[selection]
arch = "x86_64"
apk_groups = [["z=1", "a=2"], ["b=3"]]

[tools.node]
input = "environment:node"

[tools.sparse]
input = "environment:sparse"

[[input]]
key = "environment:node"
source = "node"
purpose = "environment-source"
arch = "x86_64"

[[input]]
key = "environment:sparse"
source = "sparse"
purpose = "environment-source"
arch = "x86_64"

# APK input
[[input]]
key = "apk:a"
url = "https://example.invalid/a.apk"
sha256 = "apk-sha"
bytes = 456
destination = "downloads/apks/a.apk"
purpose = "environment-package"
arch = "x86_64"
