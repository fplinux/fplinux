bind "w" "+forward"
bind "s" "+back"
bind "a" "+moveleft"
bind "d" "+moveright"
bind "ENTER" "+attack"
bind "[" "impulse 12"
bind "]" "impulse 10"
bind "MOUSE2" "+jump"
bind "MWHEELUP" "impulse 10"
bind "MWHEELDOWN" "impulse 12"
cl_forwardspeed "400"
cl_backspeed "400"
cl_sidespeed "700"
cl_upspeed "400"
