[first]
version = "1"
name = "first.tar.gz"
url = "https://example.invalid/first.tar.gz"
algorithm = "sha256"
checksum = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
archive_prefix = "first-release"

[board]
version = "1"
name = "board.tar.gz"
url = "https://example.invalid/board.tar.gz"
algorithm = "sha256"
checksum = "{board_sha256}"
archive_prefix = "board-release"

[monitor]
version = "1"
name = "monitor.tar.gz"
url = "https://example.invalid/monitor.tar.gz"
algorithm = "sha256"
checksum = "{monitor_sha256}"
archive_prefix = "monitor-release"
