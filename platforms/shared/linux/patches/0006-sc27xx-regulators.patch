+static int sc2720_regulator_enable(struct regulator_dev *rdev)
+{
+	const struct sc27xx_regulator_desc *regulator =
+		container_of(rdev->desc, struct sc27xx_regulator_desc, desc);
+	int ret;
+
+	ret = regmap_update_bits(rdev_get_regmap(rdev), rdev->desc->vsel_reg,
+				 rdev->desc->vsel_mask, regulator->fixed_vsel);
+	if (ret)
+		return ret;
+
+	return regulator_enable_regmap(rdev);
+}
+
+static int sc2720_regulator_is_enabled(struct regulator_dev *rdev)
+{
+	const struct sc27xx_regulator_desc *regulator =
+		container_of(rdev->desc, struct sc27xx_regulator_desc, desc);
+	u32 val;
+	int ret;
+
+	ret = regulator_is_enabled_regmap(rdev);
+	if (ret <= 0)
+		return ret;
+
+	ret = regmap_read(rdev_get_regmap(rdev), rdev->desc->vsel_reg, &val);
+	if (ret)
+		return ret;
+
+	if ((val & rdev->desc->vsel_mask) != regulator->fixed_vsel)
+		return -ERANGE;
+
+	return 1;
+}
