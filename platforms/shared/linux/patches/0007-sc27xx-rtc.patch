+static void sprd_rtc_shutdown(struct platform_device *pdev)
+{
+	struct sprd_rtc *rtc = platform_get_drvdata(pdev);
+	int first_error = 0;
+	int ret;
+
+	if (!rtc->data->one_shot_alarm)
+		return;
+
+	mutex_lock(&rtc->lock);
+	ret = regmap_update_bits(rtc->regmap, rtc->base + SPRD_RTC_INT_EN,
+				 rtc->data->alarm_enable_mask, 0);
+	if (ret)
+		first_error = ret;
+
+	ret = sprd_rtc_clear_alarm_ints(rtc);
+	if (ret && !first_error)
+		first_error = ret;
+
+	ret = sprd_rtc_lock_alarm(rtc, true);
+	if (ret && !first_error)
+		first_error = ret;
+	mutex_unlock(&rtc->lock);
+
+	if (first_error)
+		dev_err(rtc->dev, "failed to shut down RTC alarm: %d\n",
+			first_error);
+}
