diff --git a/drivers/input/tests/input_test.c b/drivers/input/tests/input_test.c
index e105ce7..f6fb67d 100644
--- a/drivers/input/tests/input_test.c
+++ b/drivers/input/tests/input_test.c
@@ -161,11 +161,171 @@ static void input_test_grab(struct kunit *test)
 	input_put_device(input_dev);
 }

+struct input_test_observer {
+	struct input_handler handler;
+	struct input_handle handle;
+	struct input_dev *device;
+	struct input_value keys[6];
+	unsigned int key_count;
+};
+
+static void input_test_observe(struct input_handle *handle, unsigned int type,
+			       unsigned int code, int value)
+{
+	struct input_test_observer *observer = handle->private;
+
+	if (type != EV_KEY)
+		return;
+	if (observer->key_count < ARRAY_SIZE(observer->keys)) {
+		struct input_value *key = &observer->keys[observer->key_count];
+
+		key->type = type;
+		key->code = code;
+		key->value = value;
+	}
+	observer->key_count++;
+}
+
+static bool input_test_observer_match(struct input_handler *handler,
+				      struct input_dev *device)
+{
+	struct input_test_observer *observer = handler->private;
+
+	return device == observer->device;
+}
+
+static int input_test_observer_connect(struct input_handler *handler,
+				       struct input_dev *device,
+				       const struct input_device_id *id)
+{
+	struct input_test_observer *observer = handler->private;
+	struct input_handle *handle = &observer->handle;
+	int ret;
+
+	handle->dev = device;
+	handle->handler = handler;
+	handle->name = handler->name;
+	handle->private = observer;
+	ret = input_register_handle(handle);
+	if (ret)
+		return ret;
+	ret = input_open_device(handle);
+	if (ret)
+		input_unregister_handle(handle);
+	return ret;
+}
+
+static void input_test_observer_disconnect(struct input_handle *handle)
+{
+	if (handle->open)
+		input_close_device(handle);
+	input_unregister_handle(handle);
+}
+
+static void input_test_observer_unregister(void *data)
+{
+	input_unregister_handler(data);
+}
+
+static void input_test_expect_keys(struct kunit *test,
+				   struct input_test_observer *observer,
+				   const int *values, unsigned int count)
+{
+	unsigned int index;
+
+	KUNIT_ASSERT_EQ(test, observer->key_count, count);
+	for (index = 0; index < count; index++) {
+		KUNIT_EXPECT_EQ(test, observer->keys[index].type, EV_KEY);
+		KUNIT_EXPECT_EQ(test, observer->keys[index].code, BTN_LEFT);
+		KUNIT_EXPECT_EQ(test, observer->keys[index].value,
+				values[index]);
+	}
+}
+
+static void input_test_key_tap(struct input_dev *device)
+{
+	input_report_key(device, BTN_LEFT, 1);
+	input_sync(device);
+	input_report_key(device, BTN_LEFT, 0);
+	input_sync(device);
+}
+
+static void input_test_passive_observers_during_grab(struct kunit *test)
+{
+	static const struct input_device_id ids[] = {
+		{
+			.flags = INPUT_DEVICE_ID_MATCH_BUS,
+			.bustype = BUS_VIRTUAL,
+		},
+		{},
+	};
+	static const char *const names[] = {
+		"grab-owner",
+		"active-observer",
+		"passive-observer",
+		"closed-passive-observer",
+	};
+	static const int owner_keys[] = { 1, 0, 1, 0, 1, 0 };
+	static const int active_keys[] = { 1, 0, 1, 0 };
+	struct input_dev *device = test->priv;
+	struct input_test_observer *observers;
+	unsigned int index;
+	int ret;
+
+	observers = kunit_kcalloc(test, ARRAY_SIZE(names), sizeof(*observers),
+				  GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, observers);
+	for (index = 0; index < ARRAY_SIZE(names); index++) {
+		struct input_test_observer *observer = &observers[index];
+		struct input_handler *handler = &observer->handler;
+
+		observer->device = device;
+		handler->name = names[index];
+		handler->private = observer;
+		handler->event = input_test_observe;
+		handler->match = input_test_observer_match;
+		handler->connect = input_test_observer_connect;
+		handler->disconnect = input_test_observer_disconnect;
+		handler->id_table = ids;
+		handler->passive_observer = index >= 2;
+		KUNIT_ASSERT_EQ(test, input_register_handler(handler), 0);
+		ret = kunit_add_action_or_reset(
+			test, input_test_observer_unregister, handler);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+		KUNIT_ASSERT_EQ(test, observer->handle.open, 1);
+	}
+	input_close_device(&observers[3].handle);
+
+	input_test_key_tap(device);
+	KUNIT_EXPECT_EQ(test, observers[0].key_count, 2);
+	KUNIT_EXPECT_EQ(test, observers[1].key_count, 2);
+	KUNIT_EXPECT_EQ(test, observers[2].key_count, 2);
+	KUNIT_EXPECT_EQ(test, observers[3].key_count, 0);
+
+	KUNIT_ASSERT_EQ(test, input_grab_device(&observers[0].handle), 0);
+	input_test_key_tap(device);
+	KUNIT_EXPECT_EQ(test, observers[0].key_count, 4);
+	KUNIT_EXPECT_EQ(test, observers[1].key_count, 2);
+	KUNIT_EXPECT_EQ(test, observers[2].key_count, 4);
+	KUNIT_EXPECT_EQ(test, observers[3].key_count, 0);
+
+	input_release_device(&observers[0].handle);
+	input_test_key_tap(device);
+	input_test_expect_keys(test, &observers[0], owner_keys,
+			       ARRAY_SIZE(owner_keys));
+	input_test_expect_keys(test, &observers[1], active_keys,
+			       ARRAY_SIZE(active_keys));
+	input_test_expect_keys(test, &observers[2], owner_keys,
+			       ARRAY_SIZE(owner_keys));
+	KUNIT_EXPECT_EQ(test, observers[3].key_count, 0);
+}
+
 static struct kunit_case input_tests[] = {
 	KUNIT_CASE(input_test_polling),
 	KUNIT_CASE(input_test_timestamp),
 	KUNIT_CASE(input_test_match_device_id),
 	KUNIT_CASE(input_test_grab),
+	KUNIT_CASE(input_test_passive_observers_during_grab),
 	{ /* sentinel */ }
 };

