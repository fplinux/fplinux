+/* UMS9117's semaphore is acquired by reading zero, not by writing a token. */
+static int sprd_adi_user_lock(struct sprd_adi *sadi, unsigned long *flags)
+{
+	u32 value;
+	int ret;
+
+	raw_spin_lock_irqsave(&sadi->lock, *flags);
+	if (sadi->faulted) {
+		ret = -EIO;
+		goto unlock;
+	}
+	ret = readl_poll_timeout_atomic(sadi->base + REG_ADI_USER_LOCK, value,
+					!value, 1, ADI_USER_TIMEOUT_US);
+	if (!ret) {
+		__release(&sadi->lock);
+		return 0;
+	}
+unlock:
+	raw_spin_unlock_irqrestore(&sadi->lock, *flags);
+	return ret == -ETIMEDOUT ? -EBUSY : ret;
+}
+
+static int sprd_adi_user_unlock(struct sprd_adi *sadi, unsigned long flags)
+{
+	u32 value;
+	int ret;
+
+	__acquire(&sadi->lock);
+	ret = readl_poll_timeout_atomic(sadi->base + REG_ADI_ARM_FIFO_STS,
+					value, value & BIT_FIFO_EMPTY, 1,
+					ADI_USER_TIMEOUT_US);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(sadi->base + REG_ADI_RD_DATA,
+						value,
+						!(value & BIT_RD_CMD_BUSY), 1,
+						ADI_USER_TIMEOUT_US);
+	if (ret) {
+		/* An unfinished transaction must not be handed to another master. */
+		sadi->faulted = true;
+	} else {
+		if (readl(sadi->base + REG_ADI_INT_RAW) &
+		    BIT_ARM_FIFO_OVERFLOW) {
+			writel(BIT_ARM_FIFO_OVERFLOW,
+			       sadi->base + REG_ADI_INT_CLR);
+			ret = -EOVERFLOW;
+		}
+		writel(ADI_USER_UNLOCK, sadi->base + REG_ADI_USER_LOCK);
+	}
+	raw_spin_unlock_irqrestore(&sadi->lock, flags);
+	return ret;
+}
