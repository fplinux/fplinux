+static int sprd_efuse_ums9117_snapshot(struct sprd_efuse *efuse,
+				       struct sprd_efuse_read_state *state)
+{
+	u32 version;
+
+	version = readl(efuse->base + SPRD_EFUSE_IP_VER);
+	if ((version & GENMASK(15, 0)) != UMS9117_EFUSE_IP_VERSION ||
+	    (version & UMS9117_EFUSE_IP_TYPE_MASK))
+		return -ENODEV;
+
+	state->enable = readl(efuse->base + SPRD_EFUSE_ENABLE);
+	state->error = readl(efuse->base + SPRD_EFUSE_ERR_FLAG);
+	state->magic = readl(efuse->base + SPRD_EFUSE_MAGIC_NUM);
+	state->power = readl(efuse->base + SPRD_EFUSE_PW_SWT);
+
+	if (state->enable || state->magic ||
+	    (state->power & UMS9117_EFUSE_POWER_MODE_MASK) !=
+		    UMS9117_EFUSE_POWER_READ_MODE)
+		return -EBUSY;
+	if (state->error & SPRD_EFUSE_ERR_CLR_MASK)
+		return -EUCLEAN;
+
+	return 0;
+}
+
+static int sprd_efuse_ums9117_restore(struct sprd_efuse *efuse,
+				      const struct sprd_efuse_read_state *state)
+{
+	u32 enable;
+	u32 restored;
+	int ret = 0;
+
+	enable = readl(efuse->base + SPRD_EFUSE_ENABLE);
+	/* Never clear modes that this read path did not enable. */
+	restored = (enable & ~UMS9117_EFUSE_READ_MODE_MASK) |
+		   (state->enable & UMS9117_EFUSE_READ_MODE_MASK);
+	writel(restored, efuse->base + SPRD_EFUSE_ENABLE);
+	/* Complete mode restoration before its confirming register read. */
+	wmb();
+	enable = readl(efuse->base + SPRD_EFUSE_ENABLE);
+	if ((enable & UMS9117_EFUSE_READ_MODE_MASK) !=
+	    (state->enable & UMS9117_EFUSE_READ_MODE_MASK))
+		ret = -EIO;
+
+	usleep_range(UMS9117_EFUSE_SETTLE_MIN_US, UMS9117_EFUSE_SETTLE_MAX_US);
+	enable = readl(efuse->base + SPRD_EFUSE_ENABLE);
+	if ((enable & UMS9117_EFUSE_READ_MODE_MASK) !=
+	    (state->enable & UMS9117_EFUSE_READ_MODE_MASK))
+		ret = -EIO;
+	else if ((enable & ~UMS9117_EFUSE_READ_MODE_MASK) !=
+		 (state->enable & ~UMS9117_EFUSE_READ_MODE_MASK))
+		ret = -EBUSY;
+	if (readl(efuse->base + SPRD_EFUSE_MAGIC_NUM) != state->magic ||
+	    (readl(efuse->base + SPRD_EFUSE_PW_SWT) &
+	     UMS9117_EFUSE_POWER_MODE_MASK) !=
+		    (state->power & UMS9117_EFUSE_POWER_MODE_MASK)) {
+		if (!ret)
+			ret = -EBUSY;
+	}
+
+	return ret;
+}
+
+static int sprd_efuse_ums9117_raw_read(struct sprd_efuse *efuse, int blk,
+				       u32 *val, bool double_read)
+{
+	struct sprd_efuse_read_state state;
+	u32 enable;
+	u32 status;
+	int cleanup_ret;
+	int ret;
+
+	ret = sprd_efuse_ums9117_snapshot(efuse, &state);
+	if (ret)
+		return ret;
+
+	enable = (state.enable & ~UMS9117_EFUSE_READ_MODE_MASK) |
+		 SPRD_EFUSE_VDD_EN;
+	if (double_read)
+		enable |= SPRD_EFUSE_DOUBLE_EN;
+	writel(enable, efuse->base + SPRD_EFUSE_ENABLE);
+	/* Complete mode setup before reading the fuse array. */
+	wmb();
+	if (readl(efuse->base + SPRD_EFUSE_ENABLE) != enable) {
+		ret = -EIO;
+		goto restore;
+	}
+
+	usleep_range(UMS9117_EFUSE_SETTLE_MIN_US, UMS9117_EFUSE_SETTLE_MAX_US);
+	if (readl(efuse->base + SPRD_EFUSE_ENABLE) != enable) {
+		ret = -EIO;
+		goto restore;
+	}
+
+	*val = readl(efuse->base + SPRD_EFUSE_MEM(blk));
+	status = readl(efuse->base + SPRD_EFUSE_ERR_FLAG);
+	if ((status & SPRD_EFUSE_ERR_CLR_MASK) !=
+	    (state.error & SPRD_EFUSE_ERR_CLR_MASK)) {
+		/* Preserve the error flags for explicit recovery and diagnosis. */
+		dev_err(efuse->dev, "read error status %#x of block %d\n",
+			status, blk);
+		ret = -EUCLEAN;
+	} else {
+		ret = 0;
+	}
+
+restore:
+	cleanup_ret = sprd_efuse_ums9117_restore(efuse, &state);
+	if (cleanup_ret) {
+		dev_err(efuse->dev, "failed to restore read state: %d\n",
+			cleanup_ret);
+		if (!ret)
+			ret = cleanup_ret;
+	}
+
+	return ret;
+}
