+static int sc27xx_vibra_suspend(struct device *dev)
+{
+	struct vibra_info *info = dev_get_drvdata(dev);
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&info->state_lock, flags);
+	info->suspended = true;
+	spin_unlock_irqrestore(&info->state_lock, flags);
+
+	ret = sc27xx_vibra_stop(info);
