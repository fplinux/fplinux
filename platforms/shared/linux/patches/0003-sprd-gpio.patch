diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -714,7 +714,7 @@
 
 config GPIO_SPRD
 	tristate "Spreadtrum GPIO support"
-	depends on ARCH_SPRD || COMPILE_TEST
+	depends on ARCH_SPRD || ARCH_UMS9117 || ARCH_SC9820E || COMPILE_TEST
 	select GPIOLIB_IRQCHIP
 	help
 	  Say yes here to support Spreadtrum GPIO device.
diff --git a/drivers/gpio/gpio-sprd.c b/drivers/gpio/gpio-sprd.c
--- a/drivers/gpio/gpio-sprd.c
+++ b/drivers/gpio/gpio-sprd.c
@@ -5,10 +5,12 @@
  */
 
 #include <linux/bitops.h>
+#include <linux/clk.h>
 #include <linux/gpio/driver.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/spinlock.h>
 
 /* GPIO registers definition */
@@ -221,7 +223,9 @@
 static int sprd_gpio_probe(struct platform_device *pdev)
 {
 	struct gpio_irq_chip *irq;
+	struct clk *clk;
 	struct sprd_gpio *sprd_gpio;
+	u32 ngpio = SPRD_GPIO_NR;
 
 	sprd_gpio = devm_kzalloc(&pdev->dev, sizeof(*sprd_gpio), GFP_KERNEL);
 	if (!sprd_gpio)
@@ -231,6 +235,16 @@
 	if (sprd_gpio->irq < 0)
 		return sprd_gpio->irq;
 
+	clk = devm_clk_get_optional_enabled(&pdev->dev, "enable");
+	if (IS_ERR(clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(clk),
+				     "failed to enable GPIO clock\n");
+
+	device_property_read_u32(&pdev->dev, "ngpios", &ngpio);
+	if (!ngpio || ngpio > SPRD_GPIO_NR)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "invalid GPIO line count %u\n", ngpio);
+
 	sprd_gpio->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(sprd_gpio->base))
 		return PTR_ERR(sprd_gpio->base);
@@ -238,7 +252,7 @@
 	raw_spin_lock_init(&sprd_gpio->lock);
 
 	sprd_gpio->chip.label = dev_name(&pdev->dev);
-	sprd_gpio->chip.ngpio = SPRD_GPIO_NR;
+	sprd_gpio->chip.ngpio = ngpio;
 	sprd_gpio->chip.base = -1;
 	sprd_gpio->chip.parent = &pdev->dev;
 	sprd_gpio->chip.request = sprd_gpio_request;
@@ -261,7 +275,12 @@
 }
 
 static const struct of_device_id sprd_gpio_of_match[] = {
-	{ .compatible = "sprd,sc9860-gpio", },
+	{
+		.compatible = "sprd,sc9820e-gpio",
+	},
+	{
+		.compatible = "sprd,sc9860-gpio",
+	},
 	{ /* end of list */ }
 };
 MODULE_DEVICE_TABLE(of, sprd_gpio_of_match);
@@ -274,7 +293,7 @@
 	},
 };
 
-module_platform_driver_probe(sprd_gpio_driver, sprd_gpio_probe);
+module_platform_driver(sprd_gpio_driver);
 
 MODULE_DESCRIPTION("Spreadtrum GPIO driver");
 MODULE_LICENSE("GPL v2");
