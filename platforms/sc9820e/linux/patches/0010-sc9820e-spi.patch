+static int sprd_spi_r4p0_clk_init(struct platform_device *pdev,
+				  struct sprd_spi *ss)
+{
+	struct clk *clk_spi, *clk_parent;
+	unsigned long rate, parent_rate;
+	int ret;
+
+	clk_spi = devm_clk_get(&pdev->dev, "spi");
+	if (IS_ERR(clk_spi))
+		return dev_err_probe(&pdev->dev, PTR_ERR(clk_spi),
+				     "failed to get SPI clock\n");
+	clk_parent = devm_clk_get(&pdev->dev, "source");
+	if (IS_ERR(clk_parent))
+		return dev_err_probe(&pdev->dev, PTR_ERR(clk_parent),
+				     "failed to get source clock\n");
+	ss->clk = devm_clk_get(&pdev->dev, "enable");
+	if (IS_ERR(ss->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(ss->clk),
+				     "failed to get enable clock\n");
+
+	ret = clk_prepare_enable(ss->clk);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to enable SPI clock\n");
+	/* Do not change the source clock while an inherited transfer is busy. */
+	ret = sprd_spi_r4p0_wait(
+		ss, ktime_add_us(ktime_get(), SPRD_SPI_R4P0_MIN_TIMEOUT_US),
+		SPRD_SPI_TX_BUSY, 0);
+	if (ret) {
+		dev_err(&pdev->dev, "SPI controller remains busy\n");
+		goto disable_clk;
+	}
+
+	ret = clk_set_parent(clk_spi, clk_parent);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret,
+			      "failed to select SPI source clock\n");
+		goto disable_clk;
+	}
+	parent_rate = clk_get_rate(clk_parent);
+	if (parent_rate < 2 || parent_rate > U32_MAX) {
+		ret = -ERANGE;
+		dev_err(&pdev->dev, "invalid SPI parent rate %lu\n",
+			parent_rate);
+		goto disable_clk;
+	}
+	ret = clk_set_rate(clk_spi, parent_rate);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret,
+			      "failed to set SPI source rate\n");
+		goto disable_clk;
+	}
+	rate = clk_get_rate(clk_spi);
+	if (rate != parent_rate) {
+		ret = -ERANGE;
+		dev_err(&pdev->dev,
+			"SPI source rate %lu differs from parent %lu\n", rate,
+			parent_rate);
+		goto disable_clk;
+	}
+	ss->src_clk = rate;
+
+	return 0;
+
+disable_clk:
+	clk_disable_unprepare(ss->clk);
+	return ret;
+}
