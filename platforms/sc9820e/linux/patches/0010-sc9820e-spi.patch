+static bool sprd_spi_r4p0_use_dma(struct sprd_spi *ss, struct spi_transfer *t)
+{
+	return ss->r4p0_dma &&
+	       t->len > SPRD_SPI_FIFO_SIZE * (t->bits_per_word / 8) &&
+	       !(t->len % SPRD_SPI_R4P0_DMA_FRAGMENT_BYTES);
+}
+
+static int sprd_spi_r4p0_transfer_params(struct sprd_spi *ss,
+					 struct spi_transfer *t, u32 *divider,
+					 u32 *effective_speed_hz,
+					 u64 *chunk_timeout_us,
+					 u64 *transfer_timeout_us)
+{
+	u64 wire_time_us, interval_time_us, chunks;
+	u32 words, chunk_words;
+	int ret;
+
+	if (t->word_delay.value)
+		return -EOPNOTSUPP;
+	if (t->bits_per_word != 8 && t->bits_per_word != 16)
+		return -EINVAL;
+	if (t->rx_buf || (t->len && !t->tx_buf))
+		return -EINVAL;
+	if (t->tx_nbits && t->tx_nbits != SPI_NBITS_SINGLE)
+		return -EOPNOTSUPP;
+	if (t->len % (t->bits_per_word / 8))
+		return -EINVAL;
+	ret = sprd_spi_r4p0_clock_params(ss->src_clk, t->speed_hz, divider,
+					 effective_speed_hz);
+	if (ret)
+		return ret;
+
+	words = t->len / (t->bits_per_word / 8);
+	chunk_words = sprd_spi_r4p0_use_dma(ss, t) ?
+			      SPRD_SPI_R4P0_DMA_BUFFER_BYTES /
+				      (t->bits_per_word / 8) :
+			      SPRD_SPI_FIFO_SIZE;
+	chunks = max_t(u64, 1, DIV_ROUND_UP_ULL(words, chunk_words));
+	words = min_t(u32, words, chunk_words);
+	wire_time_us =
+		DIV_ROUND_UP_ULL((u64)words * t->bits_per_word * USEC_PER_SEC,
+				 *effective_speed_hz);
+	interval_time_us = DIV_ROUND_UP_ULL(
+		(u64)words * SPRD_SPI_MIN_DELAY_CYCLE * USEC_PER_SEC,
+		ss->src_clk);
+	*chunk_timeout_us = max_t(u64, SPRD_SPI_R4P0_MIN_TIMEOUT_US,
+				  2 * (wire_time_us + interval_time_us));
+	if (*chunk_timeout_us > div64_u64(KTIME_MAX / NSEC_PER_USEC, chunks))
+		return -EINVAL;
+	*transfer_timeout_us = *chunk_timeout_us * chunks;
+
+	return 0;
+}
+
+static int sprd_spi_r4p0_wait(struct sprd_spi *ss, ktime_t deadline, u32 mask,
+			      u32 expected)
+{
+	s64 remaining_us = ktime_us_delta(deadline, ktime_get());
+	u32 val;
+	int ret;
+
+	if (remaining_us <= 0)
+		return -ETIMEDOUT;
+
+	ret = readl_poll_timeout(ss->base + SPRD_SPI_STS2, val,
+				 (val & mask) == expected, 10, remaining_us);
+	if (ret || !ktime_before(ktime_get(), deadline))
+		return -ETIMEDOUT;
+
+	return 0;
+}
+
+static void
+sprd_spi_r4p0_report_failure(struct sprd_spi *ss, struct spi_transfer *t,
+			     u32 effective_speed_hz, ktime_t start,
+			     ktime_t last_progress, u64 chunk_budget_us,
+			     u64 overall_budget_us, u32 remaining_words,
+			     const char *stage, int error)
+{
+	ktime_t now = ktime_get();
+	s64 elapsed_us = ktime_us_delta(now, start);
+	s64 last_progress_age_us = ktime_us_delta(now, last_progress);
+	u32 status = readl(ss->base + SPRD_SPI_STS2);
+
+	dev_err(ss->dev,
+		"r4p0 transfer failed: %d len=%u bpw=%u requested_hz=%u effective_hz=%u elapsed_us=%lld last_progress_age_us=%lld chunk_budget_us=%llu overall_budget_us=%llu remaining_words=%u stage=%s STS2=%#x\n",
+		error, t->len, t->bits_per_word, t->speed_hz,
+		effective_speed_hz, elapsed_us, last_progress_age_us,
+		chunk_budget_us, overall_budget_us, remaining_words, stage,
+		status);
+}
+
+static int sprd_spi_r4p0_prepare_message(struct spi_controller *sctlr,
+					 struct spi_message *msg)
+{
+	struct sprd_spi *ss = spi_controller_get_devdata(sctlr);
+	struct spi_transfer *t;
+	u64 chunk_timeout_us, transfer_timeout_us;
+	ktime_t now, deadline;
+	u32 divider, effective_speed_hz, val;
+	int ret;
+
+	if (sprd_spi_r4p0_dma_quarantined(ss->r4p0_dma))
+		return -EIO;
+	if (msg->spi->mode & ~(SPI_CPOL | SPI_CPHA))
+		return -EOPNOTSUPP;
+	if (spi_get_chipselect(msg->spi, 0) != 0)
+		return -EINVAL;
+	if (list_empty(&msg->transfers))
+		return -EINVAL;
+
+	list_for_each_entry(t, &msg->transfers, transfer_list) {
+		ret = sprd_spi_r4p0_transfer_params(ss, t, &divider,
+						    &effective_speed_hz,
+						    &chunk_timeout_us,
+						    &transfer_timeout_us);
+		if (ret)
+			return ret;
+		/* A new baseline cannot preserve CS across messages. */
+		if (t->cs_change &&
+		    list_is_last(&t->transfer_list, &msg->transfers))
+			return -EOPNOTSUPP;
+	}
+
+	t = list_first_entry(&msg->transfers, struct spi_transfer,
+			     transfer_list);
+	ret = sprd_spi_r4p0_transfer_params(ss, t, &divider,
+					    &effective_speed_hz,
+					    &chunk_timeout_us,
+					    &transfer_timeout_us);
+	if (ret)
+		return ret;
+	now = ktime_get();
+	deadline = ktime_add_us(now, SPRD_SPI_R4P0_MIN_TIMEOUT_US);
+	ret = sprd_spi_r4p0_wait(ss, deadline, SPRD_SPI_TX_BUSY, 0);
+	if (ret) {
+		sprd_spi_r4p0_report_failure(ss, t, effective_speed_hz, now,
+					     now, SPRD_SPI_R4P0_MIN_TIMEOUT_US,
+					     SPRD_SPI_R4P0_MIN_TIMEOUT_US,
+					     t->len / (t->bits_per_word / 8),
+					     "prepare-busy", ret);
+		return ret;
+	}
+
+	/* The core asserts CS only after prepare_message returns. */
+	val = SPRD_SPI_CSN_MASK | (t->bits_per_word << SPRD_SPI_CHNL_LEN);
+	val |= msg->spi->mode & SPI_CPHA ? SPRD_SPI_NG_RX : SPRD_SPI_NG_TX;
+	val |= msg->spi->mode & SPI_CPOL ? SPRD_SPI_SCK_REV : 0;
+	writel(val, ss->base + SPRD_SPI_CTL0);
+	writel(0, ss->base + SPRD_SPI_CTL1);
+	writel(0, ss->base + SPRD_SPI_CTL2);
+	writel(SPRD_SPI_R4P0_FIFO_THRESHOLDS, ss->base + SPRD_SPI_CTL3);
+	writel(0, ss->base + SPRD_SPI_CTL4);
+	writel(SPRD_SPI_R4P0_INTERVAL, ss->base + SPRD_SPI_CTL5);
+	writel(0, ss->base + SPRD_SPI_INT_EN);
+
+	val = readl(ss->base + SPRD_SPI_CTL7);
+	val &= ~SPRD_SPI_MODE_MASK;
+	val |= SPRD_SPI_R4P0_MODE << SPRD_SPI_MODE_OFFSET;
+	writel(val, ss->base + SPRD_SPI_CTL7);
+	writel(1, ss->base + SPRD_SPI_FIFO_RST);
+	writel(0, ss->base + SPRD_SPI_FIFO_RST);
+	writel(divider, ss->base + SPRD_SPI_CLKD);
+
+	return 0;
+}
+
+static int sprd_spi_r4p0_dma_chunk(struct sprd_spi *ss, struct spi_transfer *t,
+				   u32 words, ktime_t deadline,
+				   const char **stage)
+{
+	u32 length = words * (t->bits_per_word / 8);
+	int ret, stop_ret;
+
+	*stage = "dma-prepare";
+	ret = sprd_spi_r4p0_dma_start(ss->r4p0_dma, ss->tx_buf, length,
+				      t->bits_per_word);
+	if (ret)
+		goto stop;
+
+	sprd_spi_set_rx_length(ss, 0);
+	sprd_spi_set_tx_length(ss, words);
+	writel(SPRD_SPI_SW_TX_REQ, ss->base + SPRD_SPI_CTL12);
+	sprd_spi_dma_enable(ss, true);
+	*stage = "dma-completion";
+	ret = sprd_spi_r4p0_dma_wait(ss->r4p0_dma, deadline);
+
+stop:
+	sprd_spi_dma_enable(ss, false);
+	stop_ret = sprd_spi_r4p0_dma_stop(ss->r4p0_dma);
+	if (stop_ret) {
+		dev_err(ss->dev,
+			"DMA stop failed: %d; buffer, channel and clock retained until reboot\n",
+			stop_ret);
+		if (!ret)
+			ret = stop_ret;
+	}
+	if (ret)
+		return ret;
+
+	*stage = "fifo-empty";
+	ret = sprd_spi_r4p0_wait(ss, deadline, SPRD_SPI_TX_FIFO_EMPTY,
+				 SPRD_SPI_TX_FIFO_EMPTY);
+	if (ret)
+		return ret;
+	*stage = "tx-busy";
+	ret = sprd_spi_r4p0_wait(ss, deadline, SPRD_SPI_TX_BUSY, 0);
+	if (!ret)
+		ss->tx_buf += length;
+	return ret;
+}
+
+static int sprd_spi_r4p0_transfer_one(struct spi_controller *sctlr,
+				      struct spi_device *sdev,
+				      struct spi_transfer *t)
+{
+	struct sprd_spi *ss = spi_controller_get_devdata(sctlr);
+	const char *stage = "deadline";
+	u32 divider, effective_speed_hz, words, chunk, val;
+	u64 chunk_timeout_us, transfer_timeout_us;
+	ktime_t start, now, deadline, chunk_deadline, last_progress;
+	bool use_dma;
+	int ret;
+
+	if (sprd_spi_r4p0_dma_quarantined(ss->r4p0_dma))
+		return -EIO;
+	ret = sprd_spi_r4p0_transfer_params(ss, t, &divider,
+					    &effective_speed_hz,
+					    &chunk_timeout_us,
+					    &transfer_timeout_us);
+	if (ret)
+		return ret;
+
+	start = ktime_get();
+	last_progress = start;
+	if (transfer_timeout_us >
+	    div_s64(KTIME_MAX - ktime_to_ns(start), NSEC_PER_USEC))
+		return -EINVAL;
+	deadline = ktime_add_us(start, transfer_timeout_us);
+	t->effective_speed_hz = effective_speed_hz;
+	use_dma = sprd_spi_r4p0_use_dma(ss, t);
+
+	ss->tx_buf = t->tx_buf;
+	ss->write_bufs = t->bits_per_word == 8 ? sprd_spi_write_bufs_u8 :
+						 sprd_spi_write_bufs_u16;
+	words = t->len / (t->bits_per_word / 8);
+	writel(divider, ss->base + SPRD_SPI_CLKD);
+	sprd_spi_set_transfer_bits(ss, t->bits_per_word);
+
+	val = readl(ss->base + SPRD_SPI_CTL1);
+	val &= ~SPRD_SPI_RTX_MD_MASK;
+	writel(val | SPRD_SPI_TX_MODE, ss->base + SPRD_SPI_CTL1);
+	writel(1, ss->base + SPRD_SPI_FIFO_RST);
+	writel(0, ss->base + SPRD_SPI_FIFO_RST);
+
+	while (words) {
+		stage = "deadline";
+		now = ktime_get();
+		if (!ktime_before(now, deadline)) {
+			ret = -ETIMEDOUT;
+			break;
+		}
+		/* A new watchdog starts only after the previous chunk completes. */
+		chunk_deadline =
+			ktime_add_us(now, min_t(u64, chunk_timeout_us,
+						ktime_us_delta(deadline, now)));
+		chunk = min_t(u32, words,
+			      use_dma ? SPRD_SPI_R4P0_DMA_BUFFER_BYTES /
+						(t->bits_per_word / 8) :
+					SPRD_SPI_FIFO_SIZE);
+		if (use_dma) {
+			ret = sprd_spi_r4p0_dma_chunk(ss, t, chunk,
+						      chunk_deadline, &stage);
+			if (ret)
+				break;
+			last_progress = ktime_get();
+			words -= chunk;
+			continue;
+		}
+		sprd_spi_set_rx_length(ss, 0);
+		sprd_spi_set_tx_length(ss, chunk);
+		/* Mode 3 starts each chunk before the FIFO is filled. */
+		writel(SPRD_SPI_SW_TX_REQ, ss->base + SPRD_SPI_CTL12);
+		ss->write_bufs(ss, chunk);
+
+		stage = "fifo-empty";
+		ret = sprd_spi_r4p0_wait(ss, chunk_deadline,
+					 SPRD_SPI_TX_FIFO_EMPTY,
+					 SPRD_SPI_TX_FIFO_EMPTY);
+		if (ret)
+			break;
+		stage = "tx-busy";
+		ret = sprd_spi_r4p0_wait(ss, chunk_deadline, SPRD_SPI_TX_BUSY,
+					 0);
+		if (ret)
+			break;
+		last_progress = ktime_get();
+		words -= chunk;
+	}
+
+	if (ret)
+		sprd_spi_r4p0_report_failure(ss, t, effective_speed_hz, start,
+					     last_progress, chunk_timeout_us,
+					     transfer_timeout_us, words, stage,
+					     ret);
+
+	sprd_spi_enter_idle(ss);
+	return ret;
+}
