diff --git a/drivers/gpu/drm/drm_mipi_dbi.c b/drivers/gpu/drm/drm_mipi_dbi.c
index ae55e0e..90428ea 100644
--- a/drivers/gpu/drm/drm_mipi_dbi.c
+++ b/drivers/gpu/drm/drm_mipi_dbi.c
@@ -703,6 +703,8 @@ EXPORT_SYMBOL(mipi_dbi_poweron_conditional_reset);

 #if IS_ENABLED(CONFIG_SPI)

+#include "drm_mipi_dbi-spi.h"
+
 /**
  * mipi_dbi_spi_cmd_max_speed - get the maximum SPI bus speed
  * @spi: SPI device
@@ -1095,7 +1097,10 @@ out_command_unlock:
 	if (ret)
 		goto out_data_unlock;
 	speed_hz = mipi_dbi_spi_cmd_max_speed(spi, num);
-	ret = mipi_dbi_spi_transfer(spi, speed_hz, bpw, par, num);
+	if (*cmd == MIPI_DCS_WRITE_MEMORY_START)
+		ret = mipi_dbi_spi_write_memory(spi, speed_hz, bpw, par, num);
+	else
+		ret = mipi_dbi_spi_transfer(spi, speed_hz, bpw, par, num);
 out_data_unlock:
 	spi_bus_unlock(spi->controller);

@@ -1125,8 +1130,10 @@ out_data_unlock:
  *                          byteswapped before transfer.
  *
  * Option 3 (D/C as a gpio): If the SPI controller supports 16 bits per word the buffer can be
- *                           sent as-is. If not the caller is responsible for swapping the bytes
- *                           before calling mipi_dbi_command_buf() and the buffer is sent 8 bpw.
+ *                           sent as-is. Even pixel counts can use 32 bits per word through a
+ *                           temporary copy with each pair packed in wire order. If 16 bits per
+ *                           word is unavailable the caller swaps bytes before calling
+ *                           mipi_dbi_command_buf() and the buffer is sent 8 bpw.
  *
  * This handling is optimised for %DRM_FORMAT_RGB565 framebuffers.
  *
@@ -1214,12 +1221,8 @@ int mipi_dbi_spi_transfer(struct spi_device *spi, u32 speed_hz,
 	size_t chunk;
 	int ret;

-	/* In __spi_validate, there's a validation that no partial transfers
-	 * are accepted (xfer->len % w_size must be zero).
-	 * Here we align max_chunk to multiple of 2 (16bits),
-	 * to prevent transfers from being rejected.
-	 */
-	max_chunk = ALIGN_DOWN(max_chunk, 2);
+	/* Keep every chunk aligned to a complete SPI word. */
+	max_chunk = ALIGN_DOWN(max_chunk, bpw == 32 ? 4 : 2);

 	spi_message_init_with_transfers(&m, &tr, 1);

