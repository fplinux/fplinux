+static int sdhci_sprd_r10_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sdhci_sprd_host *sprd_host;
+	struct sdhci_host *host;
+	unsigned long source_rate;
+	u32 raw_caps, raw_caps1;
+	u16 raw_version;
+	int ret;
+
+	host = sdhci_pltfm_init(pdev, &sdhci_sprd_r10_pdata,
+				sizeof(*sprd_host));
+	if (IS_ERR(host))
+		return PTR_ERR(host);
+
+	sprd_host = TO_SPRD_HOST(host);
+	sprd_host->is_r10 = true;
+	host->dma_mask = DMA_BIT_MASK(32);
+	dev->dma_mask = &host->dma_mask;
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "r10 needs 32-bit DMA\n");
+
+	ret = mmc_of_parse(host->mmc);
+	if (ret)
+		return ret;
+	if (!mmc_card_is_removable(host->mmc) ||
+	    !(host->mmc->caps2 & MMC_CAP2_NO_MMC) ||
+	    !(host->mmc->caps2 & MMC_CAP2_NO_SDIO))
+		return dev_err_probe(dev, -EINVAL,
+				     "r10 supports removable SD only\n");
+
