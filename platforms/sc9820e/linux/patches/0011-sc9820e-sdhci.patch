+static u32 sdhci_sprd_r10_readl(struct sdhci_host *host, int reg)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	u32 val;
+
+	/* The generic SDMA address and the r10 block count share offset 0. */
+	if (reg == SDHCI_DMA_ADDRESS)
+		reg = SDHCI_ADMA_ADDRESS;
+	else if (reg == SDHCI_MAX_CURRENT)
+		return 0;
+
+	val = readl(host->ioaddr + reg);
+	if (reg == SDHCI_INT_STATUS && val != U32_MAX &&
+	    sprd_host->dma_active && !sprd_host->dma_failed) {
+		sprd_host->dma_status |= val;
+		/* A clean transfer completion releases the data engine. */
+		if ((sprd_host->dma_status & SDHCI_INT_DATA_END) &&
+		    !(sprd_host->dma_status & GENMASK(22, 16)))
+			sprd_host->dma_active = false;
+	}
+	return val;
+}
+
+static void sdhci_sprd_r10_writel(struct sdhci_host *host, u32 val, int reg)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+
+	if (sprd_host->dma_failed) {
+		if (reg == SDHCI_INT_ENABLE || reg == SDHCI_SIGNAL_ENABLE)
+			val = 0;
+		else if (reg != SDHCI_INT_STATUS)
+			return;
+	}
+
+	if (reg == SDHCI_DMA_ADDRESS) {
+		reg = SDHCI_ADMA_ADDRESS;
+	} else if (reg == SDHCI_MAX_CURRENT) {
+		return;
+	} else if (reg == SDHCI_INT_ENABLE || reg == SDHCI_SIGNAL_ENABLE) {
+		val &= SDHCI_SPRD_R10_INT_MASK;
+		/* Enable the error summary with the individual error sources. */
+		if (val & GENMASK(22, 16))
+			val |= SDHCI_INT_ERROR;
+	}
+
+	writel(val, host->ioaddr + reg);
+}
+
+static void sdhci_sprd_r10_writew(struct sdhci_host *host, u16 val, int reg)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+
+	if (sprd_host->dma_failed)
+		return;
+
+	if (reg == SDHCI_BLOCK_COUNT && host->version >= SDHCI_SPEC_400) {
+		/* Bypass the SDMA-address translation for the real count. */
+		writel(val, host->ioaddr + SDHCI_32BIT_BLK_CNT);
+		return;
+	}
+
+	if (reg == SDHCI_HOST_CONTROL2)
+		val &= ~(SDHCI_SPRD_R10_64BIT_EN |
+			 SDHCI_SPRD_R10_AUTO_CMD23_EN);
+	if (reg == SDHCI_COMMAND && (val & SDHCI_CMD_DATA) && host->data) {
+		sprd_host->dma_data = host->data;
+		sprd_host->dma_status = 0;
+		sprd_host->dma_active = true;
+	}
+
+	writew(val, host->ioaddr + reg);
+}
+
+static void sdhci_sprd_r10_writeb(struct sdhci_host *host, u8 val, int reg)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+
+	if (sprd_host->dma_failed)
+		return;
+
+	if (reg == SDHCI_SOFTWARE_RESET)
+		val |= readb(host->ioaddr + reg);
+
+	writeb(val, host->ioaddr + reg);
+}
+
+static void sdhci_sprd_r10_fail_dma(struct sdhci_host *host, u32 status)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	struct mmc_data *data = sprd_host->dma_data;
+	int ret = data->error;
+
+	if (!ret)
+		ret = data->mrq->cmd->error;
+	if (!ret)
+		ret = -ETIMEDOUT;
+	sprd_host->reset_error = ret;
+	sprd_host->dma_active = true;
+	sprd_host->dma_failed = true;
+	host->flags |= SDHCI_DEVICE_DEAD;
+	/* Keep the mapped buffer owned by DMA, including after request done. */
+	host->flags &= ~SDHCI_REQ_USE_DMA;
+	if (data->stop) {
+		if (!data->stop->error)
+			data->stop->error = ret;
+		/* Do not send recovery commands to an engine still using DMA. */
+		data->stop = NULL;
+	}
+	writel(0, host->ioaddr + SDHCI_SIGNAL_ENABLE);
+	dev_err(mmc_dev(host->mmc),
+		"r10 DMA stop unconfirmed, status=%08x; requests blocked, buffer retained\n",
+		status);
+}
+
+static void sdhci_sprd_r10_reset(struct sdhci_host *host, u8 mask)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	u32 backup, status;
+	u16 ctrl;
+	int ret;
+
+	if (sprd_host->dma_failed)
+		return;
+	if (sprd_host->dma_active) {
+		/* Error status is latched before the generic IRQ acknowledgment. */
+		ret = read_poll_timeout_atomic(
+			sdhci_sprd_r10_readl, status,
+			sprd_host->dma_status & SDHCI_SPRD_R10_DMA_TERMINAL, 10,
+			SDHCI_SPRD_R10_DMA_WAIT_US, false, host,
+			SDHCI_INT_STATUS);
+		if (ret) {
+			sdhci_sprd_r10_fail_dma(host, status);
+			return;
+		}
+		if (status != U32_MAX)
+			writel(status & SDHCI_SPRD_R10_INT_MASK,
+			       host->ioaddr + SDHCI_INT_STATUS);
+
+		/* The terminal condition precedes the combined command/data reset. */
+		sdhci_reset(host, SDHCI_RESET_CMD | SDHCI_RESET_DATA);
+		if (readb(host->ioaddr + SDHCI_SOFTWARE_RESET) &
+		    (SDHCI_RESET_CMD | SDHCI_RESET_DATA)) {
+			sdhci_sprd_r10_fail_dma(host, status);
+			return;
+		}
+		sprd_host->dma_active = false;
+		if (!(mask & SDHCI_RESET_ALL)) {
+			sprd_host->reset_error = 0;
+			return;
+		}
+	}
+
+	sdhci_reset(host, mask);
+	sprd_host->reset_error =
+		readb(host->ioaddr + SDHCI_SOFTWARE_RESET) & mask ? -ETIMEDOUT :
+								    0;
+	if (sprd_host->reset_error || !(mask & SDHCI_RESET_ALL))
+		return;
+
+	ctrl = sdhci_readw(host, SDHCI_HOST_CONTROL2);
+	sdhci_writew(host, ctrl, SDHCI_HOST_CONTROL2);
+
+	backup = sdhci_readl(host, SDHCI_SPRD_REG_DEBOUNCE);
+	backup |= SDHCI_SPRD_BIT_DLL_BAK | SDHCI_SPRD_BIT_DLL_VAL;
+	sdhci_writel(host, backup, SDHCI_SPRD_REG_DEBOUNCE);
+}
+
+static void sdhci_sprd_r10_set_clock(struct sdhci_host *host,
+				     unsigned int clock)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	u32 div;
+	u16 ctrl;
+	int ret;
+
+	if (sprd_host->dma_failed)
+		return;
+
+	sdhci_writew(host, 0, SDHCI_CLOCK_CONTROL);
+	host->mmc->actual_clock = 0;
+	if (!clock) {
+		sprd_host->clock_error = 0;
+		return;
+	}
+
+	div = sdhci_sprd_calc_div(sprd_host->base_rate, clock);
+	ctrl = ((div & 0x300) >> 2) | ((div & 0xff) << 8);
+	ctrl |= SDHCI_CLOCK_INT_EN;
+	sdhci_writew(host, ctrl, SDHCI_CLOCK_CONTROL);
+
+	ret = readw_poll_timeout_atomic(host->ioaddr + SDHCI_CLOCK_CONTROL,
+					ctrl, ctrl & SDHCI_CLOCK_INT_STABLE, 10,
+					100000);
+	sprd_host->clock_error = ret;
+	if (ret) {
+		dev_err(mmc_dev(host->mmc), "r10 internal clock timed out\n");
+		sdhci_writew(host, 0, SDHCI_CLOCK_CONTROL);
+		return;
+	}
+
+	sdhci_sprd_set_dll_invert(
+		host, SDHCI_SPRD_BIT_CMD_DLY_INV | SDHCI_SPRD_BIT_POSRD_DLY_INV,
+		clock <= 400000);
+	if (clock <= 400000)
+		sdhci_writel(host, 0, SDHCI_SPRD_REG_32_DLL_DLY);
+
+	/* Software rate derived from the selected parent and encoded divider. */
+	host->mmc->actual_clock = sprd_host->base_rate / (div ? 4 * div : 2);
+	sdhci_sprd_sd_clk_on(host);
+}
+
+static unsigned int sdhci_sprd_r10_get_max_clock(struct sdhci_host *host)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+
+	return sprd_host->base_rate / 2;
+}
+
+static unsigned int sdhci_sprd_r10_get_min_clock(struct sdhci_host *host)
+{
+	return 400000;
+}
+
+static void sdhci_sprd_r10_set_uhs_signaling(struct sdhci_host *host,
+					     unsigned int timing)
+{
+	u16 ctrl = sdhci_readw(host, SDHCI_HOST_CONTROL2);
+
+	ctrl &= ~SDHCI_CTRL_UHS_MASK;
+	if (timing == MMC_TIMING_SD_HS)
+		ctrl |= SDHCI_CTRL_UHS_SDR25;
+	sdhci_writew(host, ctrl, SDHCI_HOST_CONTROL2);
+}
+
+static void sdhci_sprd_r10_set_power(struct sdhci_host *host,
+				     unsigned char mode, unsigned short vdd)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	struct mmc_host *mmc = host->mmc;
+	int ret = 0, core_ret;
+
+	if (sprd_host->dma_failed)
+		return;
+
+	if (mode == MMC_POWER_OFF) {
+		if (mmc->vqmmc_enabled) {
+			ret = regulator_disable(mmc->supply.vqmmc);
+			if (!ret)
+				mmc->vqmmc_enabled = false;
+		}
+		core_ret = mmc_regulator_set_ocr(mmc, mmc->supply.vmmc, 0);
+		if (!ret)
+			ret = core_ret;
+	} else {
+		if (vdd >= 32 || !(BIT(vdd) & SDHCI_SPRD_R10_OCR)) {
+			ret = -EINVAL;
+			goto out;
+		}
+		ret = mmc_regulator_set_ocr(mmc, mmc->supply.vmmc, vdd);
+		if (ret)
+			goto out;
+		ret = regulator_set_voltage(mmc->supply.vqmmc,
+					    SDHCI_SPRD_R10_VOLTAGE_UV,
+					    SDHCI_SPRD_R10_VOLTAGE_UV);
+		if (!ret)
+			ret = mmc_regulator_enable_vqmmc(mmc);
+	}
+out:
+	sprd_host->power_error = ret;
+	if (ret)
+		dev_err(mmc_dev(mmc), "r10 power transition failed: %d\n", ret);
+}
+
+static int sdhci_sprd_r10_voltage_switch(struct mmc_host *mmc,
+					 struct mmc_ios *ios)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(mmc_priv(mmc));
+
+	if (sprd_host->dma_failed)
+		return sprd_host->reset_error;
+	if (ios->signal_voltage != MMC_SIGNAL_VOLTAGE_330)
+		return -EINVAL;
+
+	return regulator_set_voltage(mmc->supply.vqmmc,
+				     SDHCI_SPRD_R10_VOLTAGE_UV,
+				     SDHCI_SPRD_R10_VOLTAGE_UV);
+}
+
+static void sdhci_sprd_r10_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(mmc_priv(mmc));
+
+	/* Neither power-off nor a clock change proves that DMA has stopped. */
+	if (sprd_host->dma_failed)
+		return;
+
+	sdhci_set_ios(mmc, ios);
+}
+
+static void sdhci_sprd_r10_request_done(struct sdhci_host *host,
+					struct mmc_request *mrq)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+
+	if (sprd_host->dma_failed && mrq->data)
+		/* No SG mapping was made; keep post_req away from the bounce map. */
+		mrq->data->host_cookie = COOKIE_UNMAPPED;
+	if (sprd_host->dma_data == mrq->data)
+		sprd_host->dma_data = NULL;
+
+	mmc_request_done(host->mmc, mrq);
+}
+
+static int sdhci_sprd_r10_alloc_bounce(struct sdhci_host *host)
+{
+	struct device *dev = mmc_dev(host->mmc);
+	void *buffer;
+	dma_addr_t addr;
+
+	buffer = kmalloc(SZ_64K, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+	addr = dma_map_single(dev, buffer, SZ_64K, DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dev, addr)) {
+		kfree(buffer);
+		return -EIO;
+	}
+	dma_sync_single_for_cpu(dev, addr, SZ_64K, DMA_BIDIRECTIONAL);
+	host->bounce_buffer = buffer;
+	host->bounce_addr = addr;
+	host->bounce_buffer_size = SZ_64K;
+	return 0;
+}
+
+static void sdhci_sprd_r10_free_bounce(struct sdhci_host *host)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	struct device *dev = mmc_dev(host->mmc);
+
+	if (!host->bounce_buffer)
+		return;
+	if (sprd_host->dma_active) {
+		/* The retained mapping and allocation are never reused or freed. */
+		dev_err(dev,
+			"r10 DMA state unknown; retaining the mapped buffer\n");
+		return;
+	}
+	dma_unmap_single(dev, host->bounce_addr, host->bounce_buffer_size,
+			 DMA_BIDIRECTIONAL);
+	kfree(host->bounce_buffer);
+	host->bounce_buffer = NULL;
+	host->bounce_buffer_size = 0;
+}
+
+static void sdhci_sprd_r10_put_resources(struct sdhci_host *host)
+{
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	struct mmc_host *mmc = host->mmc;
+
+	if (sprd_host->dma_active) {
+		/* Keep the enabled providers and their consumer device alive. */
+		get_device(mmc_dev(mmc));
+		return;
+	}
+	if (!IS_ERR_OR_NULL(sprd_host->clk_enable))
+		clk_put(sprd_host->clk_enable);
+	if (!IS_ERR_OR_NULL(sprd_host->clk_sdio))
+		clk_put(sprd_host->clk_sdio);
+	if (!IS_ERR_OR_NULL(sprd_host->clk_source))
+		clk_put(sprd_host->clk_source);
+
+	/* A failed rail disable must not put an enabled regulator handle. */
+	if (mmc->regulator_enabled || mmc->vqmmc_enabled) {
+		get_device(mmc_dev(mmc));
+		return;
+	}
+	if (!IS_ERR_OR_NULL(mmc->supply.vqmmc))
+		regulator_put(mmc->supply.vqmmc);
+	if (!IS_ERR_OR_NULL(mmc->supply.vmmc))
+		regulator_put(mmc->supply.vmmc);
+}
+
+static void sdhci_sprd_r10_request(struct mmc_host *mmc,
+				   struct mmc_request *mrq)
+{
+	struct sdhci_host *host = mmc_priv(mmc);
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	int ret = sprd_host->reset_error;
+
+	if (!ret)
+		ret = sprd_host->clock_error;
+	if (!ret)
+		ret = sprd_host->power_error;
+	if (!ret && mrq->data &&
+	    (!mrq->data->blksz || mrq->data->blksz > host->bounce_buffer_size ||
+	     mrq->data->blocks > host->bounce_buffer_size / mrq->data->blksz))
+		ret = -EINVAL;
+	if (ret) {
+		mrq->cmd->error = ret;
+		if (mrq->data)
+			mrq->data->error = ret;
+		mmc_request_done(mmc, mrq);
+		return;
+	}
+
+	sdhci_request(mmc, mrq);
+}
+
+static const struct sdhci_ops sdhci_sprd_r10_ops = {
+	.read_l = sdhci_sprd_r10_readl,
+	.write_l = sdhci_sprd_r10_writel,
+	.write_w = sdhci_sprd_r10_writew,
+	.write_b = sdhci_sprd_r10_writeb,
+	.set_clock = sdhci_sprd_r10_set_clock,
+	.set_power = sdhci_sprd_r10_set_power,
+	.get_max_clock = sdhci_sprd_r10_get_max_clock,
+	.get_min_clock = sdhci_sprd_r10_get_min_clock,
+	.set_bus_width = sdhci_set_bus_width,
+	.reset = sdhci_sprd_r10_reset,
+	.set_uhs_signaling = sdhci_sprd_r10_set_uhs_signaling,
+	.get_max_timeout_count = sdhci_sprd_get_max_timeout_count,
+	.get_ro = sdhci_sprd_get_ro,
+	.request_done = sdhci_sprd_r10_request_done,
+};
