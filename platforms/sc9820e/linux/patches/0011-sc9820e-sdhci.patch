+static const struct sdhci_pltfm_data sdhci_sprd_r10_pdata = {
+	.quirks = SDHCI_QUIRK_BROKEN_CARD_DETECTION |
+		  SDHCI_QUIRK_DATA_TIMEOUT_USES_SDCLK |
+		  SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN | SDHCI_QUIRK_FORCE_DMA |
+		  SDHCI_QUIRK_BROKEN_ADMA,
+	.quirks2 = SDHCI_QUIRK2_BROKEN_HS200 | SDHCI_QUIRK2_BROKEN_64_BIT_DMA |
+		   SDHCI_QUIRK2_NO_1_8_V | SDHCI_QUIRK2_ACMD23_BROKEN |
+		   SDHCI_QUIRK2_ISSUE_CMD_DAT_RESET_TOGETHER |
+		   SDHCI_QUIRK2_PRESET_VALUE_BROKEN,
+	.ops = &sdhci_sprd_r10_ops,
