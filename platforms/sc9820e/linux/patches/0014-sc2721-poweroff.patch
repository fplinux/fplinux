+int sprd_adi_sc2721_power_off(struct spi_device *spi)
+{
+	struct sprd_adi *sadi;
+	u32 value;
+	int read_ret;
+	int ret;
+
+	if (spi->controller->transfer_one != sprd_adi_transfer_one ||
+	    !irqs_disabled())
+		return -EOPNOTSUPP;
+	if (!of_device_is_compatible(spi->dev.of_node, "sprd,sc2721"))
+		return -ENODEV;
+	sadi = spi_controller_get_devdata(spi->controller);
+	if (!sadi->data->r3p0 || !sadi->hwlock)
+		return -EOPNOTSUPP;
+
+	/* Timer IRQs have stopped; this lock timeout must not use jiffies. */
+	ret = hwspin_lock_timeout_in_atomic(sadi->hwlock,
+					    SC2721_POWER_HWLOCK_TIMEOUT_MS);
+	if (ret)
+		return ret;
+
+	ret = sprd_adi_read_locked(sadi, SC2721_CHIP_ID_HIGH, &value);
+	if (ret)
+		goto unlock;
+	if (value != SC2721_CHIP_ID) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	ret = sprd_adi_write_locked(sadi, SC2721_PWR_WR_PROT_VALUE,
+				    SC2721_PWR_WR_PROT_KEY);
+	if (ret)
+		goto unlock;
+
+	ret = read_poll_timeout_atomic(sprd_adi_read_locked, read_ret,
+				       read_ret || (value & SC2721_PWR_WR_PROT),
+				       1, SC2721_POWER_UNLOCK_TIMEOUT_US, false,
+				       sadi, SC2721_PWR_WR_PROT_VALUE, &value);
+	if (!ret)
+		ret = read_ret;
+	if (ret)
+		goto unlock;
+
+	ret = sprd_adi_write_locked(sadi, SC2721_POWER_PD_HW,
+				    SC2721_PWR_OFF_SEQ_EN);
+	if (!ret)
+		ret = sprd_adi_drain_fifo(sadi);
+
+unlock:
+	hwspin_unlock_in_atomic(sadi->hwlock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_adi_sc2721_power_off);
