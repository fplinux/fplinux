	@ SPDX-License-Identifier: GPL-2.0-only
	.syntax unified
	.arch armv8-a
	.arm
	.section .text.entry, "ax", %progbits
	.global _start
	.type _start, %function
_start:
	ldr	r0, =@STACK@
	bl	qin_prepare_kernel
	ldr	sp, =@STACK@
	ldr	r0, =@KERNEL_LOAD@
	ldr	r1, =@KERNEL_STAGE@
	ldr	r2, =@KERNEL_BYTES@
	bl	sc9820e_copy_kernel
	ldr	r0, =@KERNEL_LOAD@
	ldr	r1, =@FDT_LOAD@
	ldr	r2, =@STACK@
	b	sc9820e_enter_linux
	.size _start, . - _start
	.ltorg
	.section .note.GNU-stack, "", %progbits
