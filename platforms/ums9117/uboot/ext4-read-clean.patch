+int ext4fs_open_nofollow(const char *filename, loff_t *len)
+{
+	struct ext2fs_node *node = NULL;
+	int type = FILETYPE_DIRECTORY;
+
+	if (!ext4fs_root)
+		return -EINVAL;
+
+	ext4fs_free_node(ext4fs_file, &ext4fs_root->diropen);
+	ext4fs_file = NULL;
