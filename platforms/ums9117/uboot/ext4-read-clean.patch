+	    type != FILETYPE_REG) {
+		ext4fs_free_node(node, &ext4fs_root->diropen);
+		return -ENOENT;
+	}
+	if (node->inode.size_high) {
+		ext4fs_free_node(node, &ext4fs_root->diropen);
+		return -EFBIG;
+	}
+	*len = le32_to_cpu(node->inode.size);
+	ext4fs_file = node;
+	return 0;
