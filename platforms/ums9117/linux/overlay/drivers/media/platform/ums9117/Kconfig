config VIDEO_UMS9117_ROTA
	tristate "Unisoc UMS9117 image rotation engine"
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	depends on ARCH_UMS9117 || COMPILE_TEST
	depends on OF
	depends on SPRD_DMA
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_DMA_CONTIG
	help
	  V4L2 memory-to-memory support for the UMS9117 ROTA image rotation
	  engine. The engine uses a dedicated request route on the UMS9117 AP
	  DMA controller and has no separate completion interrupt. It supports
	  the hardware's packed RGB, grayscale, and semiplanar YUV formats.

config VIDEO_UMS9117_JPEG
	bool "Unisoc UMS9117 JPEG, scaling and camera engine"
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	depends on ARCH_UMS9117 || COMPILE_TEST
	depends on OF
	select V4L2_MEM2MEM_DEV
	select V4L2_JPEG_HELPER
	select MEDIA_CONTROLLER
	select V4L2_ASYNC
	select VIDEOBUF2_DMA_CONTIG
	select VIDEOBUF2_VMALLOC
	help
	  JPEG decode, encode and scaling through the UMS9117 VSP, and
	  camera capture through the shared DCAM when a camera input route
	  is enabled and a sensor is connected.
	  Select the input route matching the board's DCAM endpoint.

config VIDEO_UMS9117_DCAM_PARALLEL
	bool "UMS9117 parallel camera input"
	depends on VIDEO_UMS9117_JPEG
	select V4L2_FWNODE
	help
	  Capture NV16 frames through an 8-bit parallel camera input.
	  The DCAM endpoint describes the bus width and signal polarities.
	  Enable this in the board fragment when that route is connected.
	  The input route is checked before the capture device is registered.

config VIDEO_UMS9117_DCAM_SERIAL_G0
	bool "UMS9117 serial-G0 camera input"
	depends on VIDEO_UMS9117_JPEG
	help
	  Capture NV16 frames through a one-bit or two-bit serial-G0 camera input.
	  The DCAM endpoint declares sprd,serial-g0-data-width for this route.
	  Enable this in the board fragment when that route is connected.
	  The input route is checked before the capture device is registered.

config VIDEO_UMS9117_DCAM_SERIAL_G0_ONE_BIT
	bool "UMS9117 one-bit serial-G0 camera input"
	depends on VIDEO_UMS9117_DCAM_SERIAL_G0
	help
	  Capture 240x320 NV16 frames from a one-bit serial-G0 camera input.
	  The sensor must supply 240x320 YUYV pixels on this route.
	  The DCAM endpoint must declare a serial data width of one bit.
	  Enable this in the board fragment only when that input is connected.

config VIDEO_UMS9117_DCAM_SERIAL_G0_TWO_BIT
	bool "UMS9117 two-bit serial-G0 camera input"
	depends on VIDEO_UMS9117_DCAM_SERIAL_G0
	help
	  Capture 640x476 NV16 frames from a two-bit serial-G0 camera input.
	  The sensor must supply 640x476 YUYV pixels on this route.
	  The DCAM endpoint must declare a serial data width of two bits.
	  Enable this in the board fragment only when that input is connected.
