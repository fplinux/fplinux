+/* The final sys-off notifier cannot sleep in the SPI message queue. */
+int sprd_adi_sc2720_power_off(struct spi_device *spi)
+{
+	struct sprd_adi *sadi = spi_controller_get_devdata(spi->controller);
+	unsigned long flags;
+	u32 value;
+	int ret;
+	int end_ret;
+
+	if (!sadi->data->user_lock)
+		return -EOPNOTSUPP;
+	ret = sprd_adi_user_lock(sadi, &flags);
+	if (ret)
+		return ret;
+	ret = sprd_adi_read(sadi, 0xc00, &value);
+	if (!ret && value != 0xa003)
+		ret = -ENODEV;
+	if (!ret)
+		ret = sprd_adi_read(sadi, 0xc04, &value);
+	if (!ret && value != 0x2720)
+		ret = -ENODEV;
+	if (!ret)
+		ret = sprd_adi_read(sadi, 0xe14, &value);
+	if (!ret && (value & BIT(3)))
+		ret = -EBUSY;
+	if (!ret)
+		ret = sprd_adi_read(sadi, 0xc20, &value);
+	if (!ret)
+		ret = sprd_adi_write(sadi, 0xc20, value | BIT(0));
+	end_ret = sprd_adi_user_unlock(sadi, flags);
+	return ret ? ret : end_ret;
+}
+EXPORT_SYMBOL_GPL(sprd_adi_sc2720_power_off);
