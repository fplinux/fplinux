+static void sc27xx_adc_set_cleanup_error(int *ret, int cleanup_ret)
+{
+	if (!*ret && cleanup_ret)
+		*ret = cleanup_ret;
+}
+
+static int sc2720_adc_read_status(struct sc27xx_adc_data *data,
+				  struct sc2720_adc_status *status)
+{
+	int ret;
+
+	ret = regmap_read(data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_CTL),
+			  &status->control);
+	if (ret)
+		return ret;
+	ret = regmap_read(data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_DEBUG),
+			  &status->debug);
+	if (ret)
+		return ret;
+	ret = regmap_read(data->regmap,
+			  sc27xx_adc_reg(data, SC27XX_ADC_INT_STS),
+			  &status->interrupt_status);
+	if (ret)
+		return ret;
+
+	return regmap_read(data->regmap,
+			   sc27xx_adc_reg(data, SC27XX_ADC_INT_RAW),
+			   &status->interrupt_raw);
+}
+
+static bool
+sc2720_adc_conversion_complete(const struct sc2720_adc_status *status)
+{
+	return !(status->control & SC27XX_ADC_CHN_RUN) &&
+	       !(status->debug & (SC2720_ADC_DEBUG_STATE_MASK |
+				  SC2720_ADC_DEBUG_COUNTER_MASK)) &&
+	       (status->interrupt_raw & SC27XX_ADC_IRQ_RAW);
+}
+
+static int sc2720_adc_read_conversion(struct sc27xx_adc_data *data, u32 *value)
+{
+	struct sc2720_adc_status status;
+	ktime_t deadline = ktime_add_us(ktime_get(), SC2720_ADC_RDY_TIMEOUT);
+	int ret;
+
+	for (;;) {
+		ret = sc2720_adc_read_status(data, &status);
+		if (ret)
+			return ret;
+		if (sc2720_adc_conversion_complete(&status))
+			break;
+		if (ktime_compare(ktime_get(), deadline) >= 0)
+			return -ETIMEDOUT;
+		usleep_range(SC2720_ADC_POLL_MIN_US, SC2720_ADC_POLL_MAX_US);
+	}
+
+	usleep_range(SC2720_ADC_DATA_SETTLE_MIN_US,
+		     SC2720_ADC_DATA_SETTLE_MAX_US);
+	ret = sc2720_adc_read_status(data, &status);
+	if (ret)
+		return ret;
+	if (!sc2720_adc_conversion_complete(&status))
+		return -EIO;
+
+	return regmap_read(data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_DATA),
+			   value);
+}
+
+static int sc2720_adc_end(struct sc27xx_adc_data *data,
+			  struct sc2720_adc_session *session)
+{
+	struct sc2720_adc_status status;
+	u32 control_mask = SC27XX_ADC_EN | SC27XX_ADC_CHN_RUN |
+			   data->var_data->control_mask;
+	u32 channel_mask = SC27XX_ADC_CHN_ID_MASK | SC2720_ADC_SLOW_MODE |
+			   data->var_data->scale_mask;
+	u32 channel_config, clock_enable, interrupt_enable, module_enable;
+	int cleanup_ret;
+	int ret = 0;
+
+	if (session->registers_valid) {
+		ret = regmap_clear_bits(data->regmap,
+					sc27xx_adc_reg(data, SC27XX_ADC_CTL),
+					SC27XX_ADC_EN | SC27XX_ADC_CHN_RUN);
+		cleanup_ret = regmap_set_bits(
+			data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_INT_CLR),
+			SC27XX_ADC_IRQ_CLR);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		cleanup_ret = regmap_update_bits(
+			data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_CH_CFG),
+			channel_mask, session->channel_config);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		cleanup_ret = regmap_update_bits(
+			data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_CTL),
+			control_mask, session->control);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+
+		cleanup_ret = sc2720_adc_read_status(data, &status);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		if (!cleanup_ret &&
+		    (((status.control ^ session->control) & control_mask) ||
+		     (status.interrupt_status & SC27XX_ADC_IRQ_RAW) ||
+		     (status.interrupt_raw & SC27XX_ADC_IRQ_RAW) ||
+		     (status.debug & (SC2720_ADC_DEBUG_STATE_MASK |
+				      SC2720_ADC_DEBUG_COUNTER_MASK))))
+			sc27xx_adc_set_cleanup_error(&ret, -EIO);
+
+		cleanup_ret = regmap_read(
+			data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_CH_CFG),
+			&channel_config);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		if (!cleanup_ret &&
+		    ((channel_config ^ session->channel_config) & channel_mask))
+			sc27xx_adc_set_cleanup_error(&ret, -EIO);
+
+		cleanup_ret = regmap_read(
+			data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_INT_EN),
+			&interrupt_enable);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		if (!cleanup_ret &&
+		    ((interrupt_enable ^ session->interrupt_enable) &
+		     SC27XX_ADC_IRQ_EN))
+			sc27xx_adc_set_cleanup_error(&ret, -EIO);
+	}
+
+	if (session->power_valid) {
+		cleanup_ret = regmap_update_bits(data->regmap,
+						 data->var_data->clk_en,
+						 SC27XX_CLK_ADC_MASK,
+						 session->clock_enable);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		cleanup_ret = regmap_update_bits(data->regmap,
+						 data->var_data->module_en,
+						 SC27XX_MODULE_ADC_EN,
+						 session->module_enable);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+
+		cleanup_ret = regmap_read(data->regmap, data->var_data->clk_en,
+					  &clock_enable);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		if (!cleanup_ret && ((clock_enable ^ session->clock_enable) &
+				     SC27XX_CLK_ADC_MASK))
+			sc27xx_adc_set_cleanup_error(&ret, -EIO);
+
+		cleanup_ret = regmap_read(data->regmap,
+					  data->var_data->module_en,
+					  &module_enable);
+		sc27xx_adc_set_cleanup_error(&ret, cleanup_ret);
+		if (!cleanup_ret && ((module_enable ^ session->module_enable) &
+				     SC27XX_MODULE_ADC_EN))
+			sc27xx_adc_set_cleanup_error(&ret, -EIO);
+	}
+
+	return ret;
+}
+
+static int sc2720_adc_begin(struct sc27xx_adc_data *data,
+			    struct sc2720_adc_session *session)
+{
+	struct sc2720_adc_status status;
+	int cleanup_ret;
+	int ret;
+
+	ret = regmap_read(data->regmap, data->var_data->module_en,
+			  &session->module_enable);
+	if (ret)
+		return ret;
+	ret = regmap_read(data->regmap, data->var_data->clk_en,
+			  &session->clock_enable);
+	if (ret)
+		return ret;
+	session->power_valid = true;
+
+	ret = regmap_set_bits(data->regmap, data->var_data->module_en,
+			      SC27XX_MODULE_ADC_EN);
+	if (ret)
+		goto restore_state;
+	ret = regmap_set_bits(data->regmap, data->var_data->clk_en,
+			      SC27XX_CLK_ADC_MASK);
+	if (ret)
+		goto restore_state;
+
+	usleep_range(SC2720_ADC_SETTLE_MIN_US, SC2720_ADC_SETTLE_MAX_US);
+
+	ret = sc2720_adc_read_status(data, &status);
+	if (ret)
+		goto restore_state;
+	session->control = status.control;
+	ret = regmap_read(data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_CH_CFG),
+			  &session->channel_config);
+	if (ret)
+		goto restore_state;
+	ret = regmap_read(data->regmap, sc27xx_adc_reg(data, SC27XX_ADC_INT_EN),
+			  &session->interrupt_enable);
+	if (ret)
+		goto restore_state;
+
+	if ((session->control & SC27XX_ADC_CHN_RUN) ||
+	    (session->interrupt_enable & SC27XX_ADC_IRQ_EN) ||
+	    (status.interrupt_status & SC27XX_ADC_IRQ_RAW) ||
+	    (status.interrupt_raw & SC27XX_ADC_IRQ_RAW) ||
+	    (status.debug &
+	     (SC2720_ADC_DEBUG_STATE_MASK | SC2720_ADC_DEBUG_COUNTER_MASK))) {
+		ret = -EBUSY;
+		goto restore_state;
+	}
+
+	session->registers_valid = true;
+	return 0;
+
+restore_state:
+	cleanup_ret = sc2720_adc_end(data, session);
+	if (cleanup_ret) {
+		data->faulted = true;
+		dev_err(data->dev,
+			"SC2720 ADC cleanup failed; reads disabled: %d\n",
+			cleanup_ret);
+		ret = cleanup_ret;
+	}
+	return ret;
+}
