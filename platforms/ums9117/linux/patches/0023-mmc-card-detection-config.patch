 # MMC core configuration
 #
+config MMC_REMOVABLE
+	bool "MMC/SD card insertion and removal"
+	default y
+	help
+	  Enable card-detect interrupts, polling and card-removal handling.
+	  Say N only if all cards remain installed while the host is powered.
+	  Initial card discovery, request error recovery and suspend/resume
+	  remain available.
+
+config MMC_GPIO
+	bool "MMC/SD GPIO card detection and write protection"
+	depends on GPIOLIB
+	default y
+	help
+	  Enable GPIO helpers for card detection and write protection.
+	  GPIO write protection is available without removable-card support.
+	  Say N if no MMC/SD host uses these GPIO resources.
+	  GPIO support for other devices is independent.
+
 config PWRSEQ_EMMC
 	tristate "HW reset support for eMMC"
 	default y
