 };

-
 static int squashfs_parse_param_threads_str(const char *str, struct squashfs_mount_opts *opts)
 {
 #ifdef CONFIG_SQUASHFS_CHOICE_DECOMP_BY_MOUNT
@@ -142,6 +145,15 @@ static int squashfs_parse_param(struct fs_context *fc, struct fs_parameter *para
 		if (squashfs_parse_param_threads(param->string, opts) != 0)
 			return -EINVAL;
 		break;
+	case Opt_fplinux_uuid:
+		if (fc->purpose != FS_CONTEXT_FOR_MOUNT)
+			return invalf(fc,
+				      "fplinux_uuid requires an initial mount");
+		if (strlen(param->string) != UUID_STRING_LEN ||
+		    uuid_parse(param->string, &opts->uuid) ||
+		    uuid_is_null(&opts->uuid))
+			return invalf(fc, "invalid fplinux_uuid");
+		break;
 	default:
 		return -EINVAL;
 	}
@@ -204,6 +216,10 @@ static int squashfs_fill_super(struct super_block *sb, struct fs_context *fc)
 	msblk = sb->s_fs_info;
 	msblk->thread_ops = opts->thread_ops;

+	/* Distinguish the RAM board layer from the shared OverlayFS lower. */
+	if (!uuid_is_null(&opts->uuid))
+		super_set_uuid(sb, opts->uuid.b, sizeof(opts->uuid.b));
+
 	msblk->panic_on_errors = (opts->errors == Opt_errors_panic);

 	msblk->devblksize = devblksize;
