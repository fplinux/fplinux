+title: Spreadtrum SC27xx Power Management IC regulators

 maintainers:
   - Orson Zhai <orsonzhai@gmail.com>
@@ -12,35 +12,50 @@ maintainers:
   - Chunyan Zhang <zhang.lyra@gmail.com>

 description: |
-  The SC2731 integrates low-voltage and low quiescent current DCDC/LDO.
-  14 LDO and 3 DCDCs are designed for external use. All DCDCs/LDOs have
-  their own bypass (power-down) control signals. It is recommended to use
-  external tantalum or MLCC ceramic capacitors with these LDOs.
-  Valid names for the regulators are:
+  The SC27xx PMICs integrate low-voltage and low quiescent current DCDC/LDO
+  supplies with individual power-down controls. The SC2731 exposes the
+  following regulators:
     BUCK:
       BUCK_CPU0, BUCK_CPU1, BUCK_RF
     LDO:
       LDO_CAMA0, LDO_CAMA1, LDO_CAMD0, LDO_CAMD1, LDO_CAMIO, LDO_CAMMOT,
       LDO_CON, LDO_EMMCCORE, LDO_SDCORE, LDO_SDIO, LDO_SRAM, LDO_USB33,
       LDO_VLDO, LDO_WIFIPA
+  The SC2720 binding exposes LDO_CAMA, LDO_CAMIO and LDO_CAMD for camera
+  supplies, LDO_SDCORE, LDO_SDIO and LDO_USB33 for storage and USB, and
+  LDO_WCN and LDO_WIFIPA for the external radio.

 properties:
   compatible:
-    const: sprd,sc2731-regulator
-
-patternProperties:
-  "^BUCK_(CPU[0-1]|RF)$":
-    type: object
-    $ref: regulator.yaml#
-    unevaluatedProperties: false
-
-  "^LDO_(CAM(A0|A1|D0|D1|IO|MOT)|CON|EMMCCORE|SD(CORE|IO)|SRAM|USB33|VLDO|WIFIPA)$":
-    type: object
-    $ref: regulator.yaml#
-    unevaluatedProperties: false
+    enum:
+      - sprd,sc2720-regulator
+      - sprd,sc2731-regulator
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: sprd,sc2720-regulator
+    then:
+      patternProperties:
+        "^LDO_(CAMA|CAMIO|CAMD|SDCORE|SDIO|USB33|WCN|WIFIPA)$":
+          type: object
+          $ref: regulator.yaml#
+          unevaluatedProperties: false
+    else:
+      patternProperties:
+        "^BUCK_(CPU[0-1]|RF)$":
+          type: object
+          $ref: regulator.yaml#
+          unevaluatedProperties: false
+
+        "^LDO_(CAM(A0|A1|D0|D1|IO|MOT)|CON|EMMCCORE|SD(CORE|IO)|SRAM|USB33|VLDO|WIFIPA)$":
+          type: object
+          $ref: regulator.yaml#
+          unevaluatedProperties: false

 required:
   - compatible

-additionalProperties: false
