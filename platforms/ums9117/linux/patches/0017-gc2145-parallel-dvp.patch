 /* Power/clock management functions */
+static int gc2145_dvp_power_off(struct gc2145 *gc2145)
+{
+	int ret = 0;
+	int step_ret;
+
+	gpiod_set_value_cansleep(gc2145->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(gc2145->reset_gpio, 1);
+	step_ret = regulator_disable(gc2145->dvp_iovdd);
+	if (!ret)
+		ret = step_ret;
+	step_ret = regulator_disable(gc2145->dvp_avdd);
+	if (!ret)
+		ret = step_ret;
+	step_ret = regulator_disable(gc2145->camera_core);
+	if (!ret)
+		ret = step_ret;
+	clk_disable_unprepare(gc2145->xclk);
+
+	return ret;
+}
+
+static int gc2145_dvp_power_on(struct gc2145 *gc2145)
+{
+	int ret;
+
+	ret = regulator_set_voltage(gc2145->camera_core, 1250000, 1250000);
+	if (ret)
+		return ret;
+	ret = regulator_enable(gc2145->camera_core);
+	if (ret)
+		return ret;
+
+	ret = regulator_set_voltage(gc2145->dvp_avdd, 2800000, 2800000);
+	if (ret)
+		goto core_off;
+	ret = regulator_enable(gc2145->dvp_avdd);
+	if (ret)
+		goto core_off;
+
+	ret = regulator_set_voltage(gc2145->dvp_iovdd, 1800000, 1800000);
+	if (ret)
+		goto analog_off;
+	ret = regulator_enable(gc2145->dvp_iovdd);
+	if (ret)
+		goto analog_off;
+
+	gpiod_set_value_cansleep(gc2145->powerdown_gpio, 0);
+	usleep_range(10000, 11000);
+	ret = clk_prepare_enable(gc2145->xclk);
+	if (ret)
+		goto io_off;
+
+	gpiod_set_value_cansleep(gc2145->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(gc2145->reset_gpio, 1);
+	msleep(100);
+	gpiod_set_value_cansleep(gc2145->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+io_off:
+	gpiod_set_value_cansleep(gc2145->powerdown_gpio, 1);
+	regulator_disable(gc2145->dvp_iovdd);
+analog_off:
+	regulator_disable(gc2145->dvp_avdd);
+core_off:
+	regulator_disable(gc2145->camera_core);
+	return ret;
+}
