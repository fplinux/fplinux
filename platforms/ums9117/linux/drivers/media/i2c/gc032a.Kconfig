# SPDX-License-Identifier: GPL-2.0-only
config VIDEO_GC032A
	tristate "GC032A two-bit serial camera sensor"
	depends on I2C && VIDEO_DEV && PM
	select V4L2_FWNODE
	help
	  Enable support for the GC032A 640x476 YUV422 sensor with two
	  serial data lines. The device is controlled over I2C and exposes
	  a V4L2 subdevice for capture controllers. The board describes the
	  sensor clock, analog and IO supplies, and powerdown GPIOs.
