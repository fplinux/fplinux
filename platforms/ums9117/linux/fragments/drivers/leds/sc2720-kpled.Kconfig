config LEDS_SC2720_KPLED_UMS9117
	bool "SC2720 keypad backlight on UMS9117"
	depends on ARCH_UMS9117
	depends on LEDS_CLASS && MFD_SC27XX_PMIC && OF
	help
	  Control the SC2720 keypad current-sink output through the PMIC regmap.
	  The board selects the current code and default LED trigger.
	  Expose binary brightness through the standard LED class interface.
	  LED triggers handle input activity and the automatic idle timeout.
