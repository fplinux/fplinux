# SPDX-License-Identifier: GPL-2.0-only
config MMC_SDHCI_UMS9117
	tristate "UMS9117 SDHCI hosts"
	depends on MMC_SDHCI_PLTFM && ARCH_UMS9117
	select MMC_SDHCI_IO_ACCESSORS
	help
	  Use the SDHCI core with UMS9117 word-wide register access and
	  separate SDIO0 microSD and SDIO1 fixed-device roles. Removable cards
	  require GPIO card detection; fixed-session cards are probed at
	  startup. The microSD role supports SD memory cards with ADMA.
	  Unmount the card before removing it. Internal NAND is separate.

source "drivers/mmc/host/marlin2/Kconfig"
