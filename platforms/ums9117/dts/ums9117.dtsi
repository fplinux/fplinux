// SPDX-License-Identifier: GPL-2.0-only
#include <dt-bindings/clock/fplinux,ums9117-inherited-clk.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
			clock-frequency = <1000000000>;
			clocks = <&ums9117_inherited_clocks
				  FPLINUX_UMS9117_CLK_CA7_CORE>;
		};
	};

	gic: interrupt-controller@12001000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x12001000 0x1000>,
		      <0x12002000 0x1000>;
	};

	ext_32k: clock-32768 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		syscounter@40230000 {
			compatible = "fplinux,ums9117-syscounter";
			reg = <0x40230000 0x10>;
		};

		timer@40050000 {
			compatible = "sprd,pike2-timer";
			reg = <0x40050000 0x20>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ext_32k>;
		};

		aon_apb: syscon@402e0000 {
			compatible = "fplinux,ums9117-aon-apb", "syscon";
			reg = <0x402e0000 0x00003000>;
		};

		ums9117_inherited_clocks: clock-controller@20e00038 {
			compatible = "fplinux,ums9117-inherited-clocks";
			reg = <0x20e00038 0x4>,
			      <0x20e00054 0x4>,
			      <0x403f0000 0xc>;
			reg-names = "ca7-divider", "ca7-source", "mpll";
			#clock-cells = <1>;
		};

		keypad: keypad@40250000 {
			reg = <0x40250000 0x00000100>;
			sprd,aon-apb = <&aon_apb>;
			sprd,eic-data-address = <0x40608280>;
			status = "disabled";
		};

		usb: usb@20200000 {
			compatible = "fplinux,ums9117-musb-inherited";
			reg = <0x20200000 0x2000>;
			interrupts = <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};
	};
};
