#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	compatible = "sprd,ums9117";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
			clock-frequency = <768000000>;
		};
	};

	gic: interrupt-controller@12001000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x12001000 0x1000>,
		      <0x12002000 0x1000>;
	};

	ext_32k: clock-32768 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		syscounter@40230000 {
			compatible = "fplinux,ums9117-syscounter";
			reg = <0x40230000 0x10>;
		};

		timer@40050000 {
			compatible = "sprd,pike2-timer";
			reg = <0x40050000 0x20>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ext_32k>;
		};

		usb: usb@20200000 {
			compatible = "fplinux,ums9117-musb-inherited";
			reg = <0x20200000 0x2000>;
			interrupts = <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};
	};
};
