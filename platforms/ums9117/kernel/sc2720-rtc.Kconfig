# SPDX-License-Identifier: GPL-2.0-only
config RTC_DRV_SC2720_UMS9117
	bool "SC2720 RTC on UMS9117"
	depends on ARCH_UMS9117
	depends on RTC_CLASS
	select IRQCHIP_SC2720_INTA_UMS9117
	help
	  Read and set the SC2720 clock and use normal one-shot alarms through
	  the shared UMS9117 analog-die interface. Normal alarms can wake Linux
	  s2idle; deep suspend and off-state power-on are not enabled.
