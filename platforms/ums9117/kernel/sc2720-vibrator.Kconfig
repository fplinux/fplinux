# SPDX-License-Identifier: GPL-2.0-only
config INPUT_SC2720_VIBRATOR_UMS9117
	bool "SC2720 vibrator on UMS9117"
	depends on ARCH_UMS9117
	depends on INPUT_MISC && OF
	select INPUT_FF_MEMLESS
	help
	  Force-feedback control for the SC2720 vibrator output through the
	  shared UMS9117 analog-die interface. The driver exposes binary
	  FF_RUMBLE effects at the voltage code selected by the board.
	  Effects are stopped by a driver-owned bounded cutoff.
