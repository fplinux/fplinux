# SPDX-License-Identifier: GPL-2.0-only
config UMS9117_DMA
	tristate "Unisoc UMS9117 AP DMA controller"
	depends on DMADEVICES
	depends on ARCH_UMS9117 || COMPILE_TEST
	depends on OF
	select DMA_ENGINE
	select DMA_VIRTUAL_CHANNELS
	help
	  DMAengine memory-to-memory transfers on the UMS9117 AP DMA controller.
	  Support memory copies and rotation-engine linked-list requests.
	  Report transfer failures through DMAengine completion status.
	  Use 32-bit DMA addresses for descriptors and buffers.

config UMS9117_DMA_TEST
	bool "UMS9117 AP DMA alignment fault injection"
	depends on UMS9117_DMA=y
	help
	  Enable a controlled alignment-error descriptor for phone testing.
	  Leave disabled in normal images.
	  Kernel test clients can exercise the DMA error completion path.
	  Enabling this option does not alter normal memcpy submission.
