diff --git a/drivers/usb/musb/Kconfig b/drivers/usb/musb/Kconfig
--- a/drivers/usb/musb/Kconfig
+++ b/drivers/usb/musb/Kconfig
@@ -86,6 +86,17 @@ config USB_MUSB_UX500
 	tristate "Ux500 platforms"
 	depends on ARCH_U8500 || COMPILE_TEST

+config USB_MUSB_UMS9117
+	bool "Unisoc UMS9117 inherited-state RAM handoff"
+	depends on ARCH_UMS9117
+	depends on USB_MUSB_GADGET
+	help
+	  PIO-only gadget glue for the MUSB controller left powered by the
+	  UMS9117 BootROM/FDL RAM-loading path. The glue performs no
+	  cold-start clock, reset or PHY programming, quiesces the two
+	  linked-list DMA channels the loader leaves armed, and works
+	  around a FIFO that returns reliable data only for 32-bit reads.
+
 config USB_MUSB_JZ4740
 	tristate "JZ4740"
 	depends on OF
diff --git a/drivers/usb/musb/Makefile b/drivers/usb/musb/Makefile
--- a/drivers/usb/musb/Makefile
+++ b/drivers/usb/musb/Makefile
@@ -22,5 +22,6 @@ obj-$(CONFIG_USB_MUSB_TUSB6010)			+= tusb6010.o
 obj-$(CONFIG_USB_MUSB_DA8XX)			+= da8xx.o
 obj-$(CONFIG_USB_MUSB_UX500)			+= ux500.o
+obj-$(CONFIG_USB_MUSB_UMS9117)			+= ums9117.o
 obj-$(CONFIG_USB_MUSB_JZ4740)			+= jz4740.o
 obj-$(CONFIG_USB_MUSB_SUNXI)			+= sunxi.o
 obj-$(CONFIG_USB_MUSB_MEDIATEK)      		+= mediatek.o
