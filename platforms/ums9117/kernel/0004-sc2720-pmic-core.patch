@@ -214,9 +275,35 @@ static int sprd_pmic_probe(struct spi_device *spi)
 	if (ret)
 		return dev_err_probe(&spi->dev, ret, "Failed to init wakeup\n");

+	if (pdata->register_syscon) {
+		ret = of_syscon_register_regmap(spi->dev.of_node,
+						ddata->regmap);
+		if (ret)
+			return dev_err_probe(
+				&spi->dev, ret,
+				"Failed to register PMIC syscon\n");
+
+		/* Keep the SPI regmap bus callbacks resident with the syscon. */
+		__module_get(THIS_MODULE);
+	}
+
 	return 0;
 }

+static void sprd_pmic_shutdown(struct spi_device *spi)
+{
+	struct sprd_pmic *ddata = spi_get_drvdata(spi);
+	int ret;
+
+	if (!ddata->pdata->mask_irqs_on_shutdown)
+		return;
+
+	ret = regmap_write(ddata->regmap,
+			   ddata->pdata->irq_base + SPRD_PMIC_INT_EN, 0);
+	if (ret)
+		dev_err(&spi->dev, "Failed to mask PMIC interrupts: %d\n", ret);
+}
