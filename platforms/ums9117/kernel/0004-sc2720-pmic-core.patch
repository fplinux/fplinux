+static int sprd_pmic_check_chip_id(struct sprd_pmic *ddata)
+{
+	const struct sprd_pmic_data *pdata = ddata->pdata;
+	u32 chip_id_low, chip_id_high;
+	int ret;
+
+	if (!pdata->chip_id_high_reg)
+		return 0;
+
+	ret = regmap_read(ddata->regmap, pdata->chip_id_low_reg, &chip_id_low);
+	if (ret)
+		return dev_err_probe(ddata->dev, ret,
+				     "failed to read PMIC low ID\n");
+
+	ret = regmap_read(ddata->regmap, pdata->chip_id_high_reg,
+			  &chip_id_high);
+	if (ret)
+		return dev_err_probe(ddata->dev, ret,
+				     "failed to read PMIC high ID\n");
+
+	if (chip_id_low != pdata->chip_id_low ||
+	    chip_id_high != pdata->chip_id_high)
+		return dev_err_probe(
+			ddata->dev, -ENODEV,
+			"unexpected PMIC ID %04x/%04x, expected %04x/%04x\n",
+			chip_id_low, chip_id_high, pdata->chip_id_low,
+			pdata->chip_id_high);
+
+	return 0;
+}
