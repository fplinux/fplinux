# SPDX-License-Identifier: GPL-2.0-only
config MMC_UMS9117
	tristate "UMS9117 SDIO0 removable microSD host"
	depends on MMC && ARCH_UMS9117 && HAS_DMA
	help
	  Drive the removable microSD slot through UMS9117 SDIO0 with the
	  shared gate, clock, pin, analog rail and active-low EIC policy.
	  This is not an SDHCI driver. Unmount the card before removing it;
	  the internal NAND is on a different controller.
