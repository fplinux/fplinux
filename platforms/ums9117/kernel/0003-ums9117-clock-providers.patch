diff --git a/drivers/clk/sprd/Kconfig b/drivers/clk/sprd/Kconfig
index 2f19c8d..49f484b 100644
--- a/drivers/clk/sprd/Kconfig
+++ b/drivers/clk/sprd/Kconfig
@@ -1,8 +1,8 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config SPRD_COMMON_CLK
 	tristate "Clock support for Spreadtrum SoCs"
-	depends on ARCH_SPRD || COMPILE_TEST
-	default ARCH_SPRD
+	depends on ARCH_SPRD || ARCH_UMS9117 || COMPILE_TEST
+	default ARCH_SPRD || ARCH_UMS9117
 	select REGMAP_MMIO

 if SPRD_COMMON_CLK
@@ -29,4 +29,15 @@ config SPRD_UMS512_CLK
 	help
 	  Support for the global clock controller on ums512 devices.
 	  Say Y if you want to use peripheral devices on ums512 SoC.
+
+config SPRD_UMS9117_CLK
+	tristate "Support for the Unisoc UMS9117 clocks"
+	depends on ARCH_UMS9117 || COMPILE_TEST
+	default ARCH_UMS9117
+	select MFD_SYSCON
+	help
+	  Support for the AP functional clock and the AP AHB and always-on
+	  APB peripheral gate clocks on UMS9117 devices.
+	  The SDIO functional source is prepared without changing its PLL.
+	  Inherited enabled gates remain held for firmware consumers.
 endif
