diff --git a/drivers/reset/Kconfig b/drivers/reset/Kconfig
index b3b9e0f..5e60570 100644
--- a/drivers/reset/Kconfig
+++ b/drivers/reset/Kconfig
@@ -380,6 +380,17 @@ config RESET_UNIPHIER_GLUE
 	  on UniPhier SoCs. Say Y if you want to control reset signals
 	  provided by the glue layer.

+config RESET_UMS9117
+	tristate "Unisoc UMS9117 reset controller"
+	depends on ARCH_UMS9117 || COMPILE_TEST
+	default ARCH_UMS9117
+	select MFD_SYSCON
+	help
+	  Support for peripheral resets in the UMS9117 application AHB
+	  system controller. The controller uses separate SET and CLEAR
+	  aliases and shares its syscon register map with clock consumers.
+	  The SDIO host uses this provider during slot activation and release.
+
 config RESET_ZYNQ
 	bool "ZYNQ Reset Driver" if COMPILE_TEST
 	default ARCH_ZYNQ
