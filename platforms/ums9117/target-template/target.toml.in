# SPDX-License-Identifier: GPL-2.0-only
platform = "ums9117"

[identity]
brand = "@BRAND@"
product = "@PRODUCT@"
hardware_codes = []
compatible = "@COMPATIBLE@"

[nand]
raw_device = "/dev/ums9117-nand-raw"

[display]
boot_font = "6x8"

[rootfs]
packages = ["fplinux-font-terminus-6x12"]

[bundle]
packages = []

[linux]
config_fragment = "linux/config/config.fragment"
memory = { base = 0x80200000, size = 0x03c00000 }
dtb = "unisoc/ums9117-@TARGET@.dtb"
debug_dtb = "ums9117-@TARGET@.dtb"
patches = []
additional_forbidden_dtb_markers = []
additional_forbidden_config = []
overlay = "linux/overlay"
copies = []

[[linux.appends]]
source = "linux/fragments/arch/arm/mach-ums9117/Kconfig"
destination = "arch/arm/mach-ums9117/Kconfig"

[[linux.appends]]
source = "linux/fragments/dts/unisoc.Makefile"
destination = "arch/arm/boot/dts/unisoc/Makefile"

[bootstrap]
image = "@FILE_STEM@_linux_bootstrap.bin"
map = "obj/@FILE_STEM@_linux_bootstrap_map.txt"
dtb_destination = "@FILE_STEM@.dtb"
record_prefix = "@SYMBOL@"

[adapter]
exec_distance = 0
session_name = "@TARGET@-linux"
# Replace * if this phone uses another BootROM key.
boot_instructions = "Power the phone off, hold *, then connect USB while keeping * pressed."
