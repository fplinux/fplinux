/dts-v1/;

/ {
	description = "FPLinux @DISPLAY_NAME@";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux zImage";
			data = /incbin/("zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x@KERNEL_LOAD@>;
			entry = <0x@KERNEL_ENTRY@>;

			hash {
				algo = "sha256";
			};
		};

		fdt {
			description = "Linux device tree";
			data = /incbin/("linux.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x@FDT_LOAD@>;

			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "@TARGET@";

		@TARGET@ {
			description = "@DISPLAY_NAME@";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
