--- a/examples/wdi-simple.c
+++ b/examples/wdi-simple.c
@@ -26,6 +26,7 @@
 #include <getopt.h>
 #endif
 #include "libwdi.h"
+#include "msapi_utf8.h"
 
 #if defined(_PREFAST_)
 /* Disable "Banned API Usage:" errors when using WDK's OACR/Prefast */
@@ -93,7 +94,7 @@
 	return hwndFound;
 }
 
-int __cdecl main(int argc, char** argv)
+static int run_driver(int argc, char** argv)
 {
 	static struct wdi_device_info *ldev, dev = {NULL, VID, PID, FALSE, 0, DESC, NULL, NULL, NULL};
 	static struct wdi_options_create_list ocl = { 0 };
@@ -251,3 +252,24 @@
 
 	return r;
 }
+
+int __cdecl wmain(int argc, wchar_t** wide_argv)
+{
+	char** argv;
+	int i, r = WDI_ERROR_RESOURCE;
+
+	argv = (char**)calloc((size_t)argc + 1, sizeof(*argv));
+	if (argv == NULL)
+		return r;
+	for (i = 0; i < argc; i++) {
+		argv[i] = wchar_to_utf8(wide_argv[i]);
+		if (argv[i] == NULL)
+			goto out;
+	}
+	r = run_driver(argc, argv);
+out:
+	for (i = 0; i < argc; i++)
+		free(argv[i]);
+	free(argv);
+	return r;
+}
