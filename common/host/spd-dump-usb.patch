+static int usb_selector_number(const char *value, unsigned limit) {
+	char *end;
+	unsigned long number;
+	if (!*value || strspn(value, "0123456789") != strlen(value))
+		ERR_EXIT("invalid USB selector\n");
+	errno = 0;
+	number = strtoul(value, &end, 10);
+	if (errno || *end || !number || number > limit)
+		ERR_EXIT("invalid USB selector\n");
+	return number;
+}
+
+static libusb_device_handle *open_bootrom_usb(int bus, int address) {
+	libusb_device **devices, *selected = NULL;
+	libusb_device_handle *handle = NULL;
+	struct libusb_device_descriptor desc;
+	ssize_t count, i;
+	int err;
+
+	count = libusb_get_device_list(NULL, &devices);
+	if (count < 0)
+		ERR_EXIT("libusb_get_device_list failed: %s\n", libusb_error_name(count));
+	for (i = 0; i < count; i++) {
+		if (bus) {
+			if (libusb_get_bus_number(devices[i]) != bus ||
+					libusb_get_device_address(devices[i]) != address) continue;
+		} else {
+			err = libusb_get_device_descriptor(devices[i], &desc);
+			if (err < 0) {
+				libusb_free_device_list(devices, 1);
+				ERR_EXIT("libusb_get_device_descriptor failed: %s\n", libusb_error_name(err));
+			}
+			if (desc.idVendor != 0x1782 || desc.idProduct != 0x4d00) continue;
+		}
+		if (selected) {
+			libusb_free_device_list(devices, 1);
+			if (bus) ERR_EXIT("ambiguous USB selector\n");
+			ERR_EXIT("multiple BootROM USB devices are connected\n");
+		}
+		selected = devices[i];
+	}
+	if (!selected) {
+		libusb_free_device_list(devices, 1);
+		return NULL;
+	}
+	if (bus) {
+		err = libusb_get_device_descriptor(selected, &desc);
+		if (err < 0 || desc.idVendor != 0x1782 || desc.idProduct != 0x4d00) {
+			libusb_free_device_list(devices, 1);
+			ERR_EXIT("selected USB device is not 1782:4d00\n");
+		}
+	}
+	err = libusb_open(selected, &handle);
+	libusb_free_device_list(devices, 1);
+	if (err < 0) {
+		fprintf(stderr, "libusb_open BootROM device failed: %s\n", libusb_error_name(err));
+		exit(err == LIBUSB_ERROR_NOT_SUPPORTED ? 2 : 1);
+	}
+	return handle;
+}
