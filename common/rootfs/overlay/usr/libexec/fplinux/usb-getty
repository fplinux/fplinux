#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux

pidfile=/tmp/fplinux-usb-getty.pid
tty_name=ttyGS0
tty_path=/dev/$tty_name
getty_pid=

log_kmsg() {
	printf '<6>fplinux-usb-getty: %s\n' "$1" 2>/dev/null >/dev/kmsg || true
}

cleanup() {
	rm -f -- "$pidfile"
}

stop_worker() {
	trap '' HUP INT QUIT TERM
	if [ -n "$getty_pid" ]; then
		if ! kill -HUP -- "-$getty_pid" 2>/dev/null; then
			kill -HUP "$getty_pid" 2>/dev/null || true
		fi
		sleep 1
		if ! kill -KILL -- "-$getty_pid" 2>/dev/null; then
			kill -KILL "$getty_pid" 2>/dev/null || true
		fi
		wait "$getty_pid" 2>/dev/null || true
		getty_pid=
	fi
	exit 0
}

trap cleanup 0
trap stop_worker HUP INT QUIT TERM

log_kmsg "worker started"
while true; do
	if [ ! -c "$tty_path" ]; then
		sleep 1
		continue
	fi

	log_kmsg "starting getty on $tty_path"
	/sbin/getty -L -n -l /bin/sh 0 "$tty_name" linux &
	getty_pid=$!
	wait "$getty_pid"
	status=$?
	getty_pid=
	log_kmsg "getty exited with status $status; retrying"
	sleep 1
done
