# SPDX-License-Identifier: GPL-2.0-only
config DRM_NOKIA110
	bool "Nokia 110 4G LCDC display"
	depends on DRM && MACH_NOKIA_110_4G
	select DRM_UMS9117
	select DRM_UMS9117_SPI
	select DRM_UMS9117_WAKE_SLEEP_OUT
	help
	  Drive the Nokia 110 4G 128x160 panel through SPI1 and the LCDC
	  with atomic RGB565 and NV16 modesetting and 16-bit pixel transfers.
	  LCDC_DONE completes each transfer before its buffers are released.
	  Backlight levels are exposed through the backlight interface.
