# SPDX-License-Identifier: GPL-2.0-only
config DRM_INOI240
	bool "INOI 240 Modern 4G LCDC display"
	depends on DRM && MACH_INOI_240_MODERN_4G
	select DRM_UMS9117
	select DRM_UMS9117_LCM
	select DRM_UMS9117_WAKE_SLEEP_OUT
	help
	  Drive the INOI 240 Modern 4G NV3023 panel through the UMS9117
	  parallel LCM/DBI interface with atomic RGB565 and NV16 modesetting,
	  bounded transfer completion and LCD backlight control.
	  The in-kernel console uses DRM fbdev emulation.
