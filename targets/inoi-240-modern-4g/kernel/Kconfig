if ARCH_UMS9117

config MACH_INOI_240_MODERN_4G
	bool "INOI 240 Modern 4G"
	select GPIOLIB
	select GPIO_SC2720_EIC_UMS9117
	select MFD_SYSCON
	help
	  Board support for the INOI 240 Modern 4G, a UMS9117 feature
	  phone with a 128x160 NV3023 panel and matrix keypad. The target
	  supports RAM and removable microSD roots and relies on the fpdoom
	  bootstrap for the initial board pin state. Internal NAND is read-only.

endif
