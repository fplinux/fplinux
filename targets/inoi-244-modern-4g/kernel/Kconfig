if ARCH_UMS9117

config MACH_INOI_244_MODERN_4G
	bool "INOI 244 Modern 4G"
	select GPIOLIB
	select GPIO_SC2720_EIC_UMS9117
	select MFD_SYSCON
	help
	  Board support for the INOI 244 Modern 4G, a UMS9117 feature
	  phone with a 240x320 NV3030 panel and matrix keypad. Both RAM-root
	  and microSD-root boots rely on the fpdoom bootstrap for the board
	  pin state; Linux does not write the phone's flash storage.

endif
