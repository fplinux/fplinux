# SPDX-License-Identifier: GPL-2.0-only
config FB_INOI244
	bool "INOI 244 Modern 4G LCDC framebuffer"
	depends on FB && MACH_INOI_244_MODERN_4G
	select FB_UMS9117
	select BACKLIGHT_CLASS_DEVICE
	help
	  Drive the INOI 244 Modern 4G NV3030 panel through the UMS9117
	  parallel LCM/DBI interface and common LCDC framebuffer lifecycle.
	  Use the fixed board panel timings and expose RGB565 framebuffer
	  memory with LCD backlight control through the backlight class.
