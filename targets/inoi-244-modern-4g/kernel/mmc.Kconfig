# SPDX-License-Identifier: GPL-2.0-only
config MMC_INOI244
	tristate "INOI 244 Modern 4G removable microSD host"
	depends on MMC && MACH_INOI_244_MODERN_4G && HAS_DMA
	select MMC_UMS9117
	help
	  Drive the removable microSD slot through UMS9117 SDIO0 with the
	  INOI 244 pin and rail configuration. Card presence is polled from
	  the active-low EIC input. Unmount the card before removing it.
	  The internal NAND is on a different controller.
