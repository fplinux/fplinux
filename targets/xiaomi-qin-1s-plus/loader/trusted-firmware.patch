diff --git a/include/lib/cpus/aarch64/cpu_macros.S b/include/lib/cpus/aarch64/cpu_macros.S
index f34f078..fbc5b5f 100644
--- a/include/lib/cpus/aarch64/cpu_macros.S
+++ b/include/lib/cpus/aarch64/cpu_macros.S
@@ -38,25 +38,27 @@
 	/*
 	 * Define the offsets to the fields in cpu_ops structure.
 	 */
-	.struct 0
-CPU_MIDR: /* cpu_ops midr */
-	.space  8
+	.equ CPU_MIDR, 0
 /* Reset fn is needed in BL at reset vector */
 #if IMAGE_BL1 || IMAGE_BL31
-CPU_RESET_FUNC: /* cpu_ops reset_func */
-	.space  8
+	.equ CPU_RESET_FUNC, CPU_MIDR + 8
 #endif
 #if IMAGE_BL31 /* The power down core and cluster is needed only in BL31 */
-CPU_PWR_DWN_CORE: /* cpu_ops core_pwr_dwn */
-	.space  8
-CPU_PWR_DWN_CLUSTER: /* cpu_ops cluster_pwr_dwn */
-	.space  8
+	.equ CPU_PWR_DWN_CORE, CPU_RESET_FUNC + 8
+	.equ CPU_PWR_DWN_CLUSTER, CPU_PWR_DWN_CORE + 8
 #endif
 #if (IMAGE_BL31 && CRASH_REPORTING)
-CPU_REG_DUMP: /* cpu specific register dump for crash reporting */
-	.space  8
+	.equ CPU_REG_DUMP, CPU_PWR_DWN_CLUSTER + 8
+#endif
+#if (IMAGE_BL31 && CRASH_REPORTING)
+	.equ CPU_OPS_SIZE, CPU_REG_DUMP + 8
+#elif IMAGE_BL31
+	.equ CPU_OPS_SIZE, CPU_PWR_DWN_CLUSTER + 8
+#elif IMAGE_BL1
+	.equ CPU_OPS_SIZE, CPU_RESET_FUNC + 8
+#else
+	.equ CPU_OPS_SIZE, CPU_MIDR + 8
 #endif
-CPU_OPS_SIZE = .
 
