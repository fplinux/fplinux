+static int qin_panel_flush(struct panel_mipi_dbi_device *panel,
+			   struct drm_shadow_plane_state *shadow,
+			   struct drm_rect *rect)
+{
+	struct mipi_dbi_dev *dbidev = &panel->dbidev;
+	struct mipi_dbi *dbi = &dbidev->dbi;
+	struct drm_framebuffer *fb = shadow->base.fb;
+	unsigned int xs = rect->x1, xe = rect->x2 - 1;
+	unsigned int ys = rect->y1, ye = rect->y2 - 1;
+	size_t len = drm_rect_width(rect) * drm_rect_height(rect) * 2;
+	size_t row_bytes = drm_rect_width(rect) * fb->format->cpp[0];
+	int ret;
+
+	/* The format helpers cannot return a failed scratch allocation. */
+	if (!drm_format_conv_state_reserve(&shadow->fmtcnv_state, row_bytes,
+					   GFP_KERNEL))
+		return -ENOMEM;
+	ret = mipi_dbi_buf_copy(dbidev->tx_buf, &shadow->data[0], fb, rect,
+				dbi->swap_bytes, &shadow->fmtcnv_state);
+	if (ret)
+		return ret;
+
+	ret = mipi_dbi_command(dbi, MIPI_DCS_SET_COLUMN_ADDRESS, xs >> 8,
+			       xs & 0xff, xe >> 8, xe & 0xff);
+	if (ret)
+		return ret;
+	ret = mipi_dbi_command(dbi, MIPI_DCS_SET_PAGE_ADDRESS, ys >> 8,
+			       ys & 0xff, ye >> 8, ye & 0xff);
+	if (ret)
+		return ret;
+
+	return mipi_dbi_command_buf(dbi, MIPI_DCS_WRITE_MEMORY_START,
+				    (u8 *)dbidev->tx_buf, len);
+}
+
+static void qin_panel_atomic_update(struct drm_plane *plane,
+				    struct drm_atomic_commit *state)
+{
+	struct drm_device *drm = plane->dev;
+	struct panel_mipi_dbi_device *panel = to_panel_mipi_dbi_device(drm);
+	struct drm_plane_state *new_state = plane->state;
+	struct drm_plane_state *old_state =
+		drm_atomic_get_old_plane_state(state, plane);
+	struct drm_shadow_plane_state *shadow =
+		to_drm_shadow_plane_state(new_state);
+	struct drm_rect rect;
+	int ret, idx;
+
+	if (!new_state->fb || !new_state->visible || !panel->initialized)
+		return;
+	if (!drm_dev_enter(drm, &idx))
+		return;
+
+	/* A reset invalidates all display memory, regardless of damage clips. */
+	if (!panel->backlight_enabled)
+		drm_rect_init(&rect, 0, 0, new_state->fb->width,
+			      new_state->fb->height);
+	else if (!drm_atomic_helper_damage_merged(old_state, new_state, &rect))
+		goto out_exit;
+
+	ret = qin_panel_flush(panel, shadow, &rect);
+	if (ret)
+		goto out_error;
+
+	if (!panel->backlight_enabled) {
+		ret = backlight_enable(panel->dbidev.backlight);
+		if (ret)
+			goto out_error;
+		panel->backlight_enabled = true;
+	}
+	goto out_exit;
+
+out_error:
+	/* Hardware callbacks cannot fail an already accepted atomic commit. */
+	panel->initialized = false;
+	panel->backlight_enabled = false;
+	drm_err(drm, "Display update failed (%d); modeset required\n", ret);
+	ret = backlight_disable(panel->dbidev.backlight);
+	if (ret)
+		drm_err(drm, "Failed to disable backlight (%d)\n", ret);
+out_exit:
+	drm_dev_exit(idx);
+}
