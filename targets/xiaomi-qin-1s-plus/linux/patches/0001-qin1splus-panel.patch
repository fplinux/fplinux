+static void qin_panel_atomic_enable(struct drm_crtc *crtc,
+				    struct drm_atomic_commit *state)
+{
+	struct drm_device *drm = crtc->dev;
+	struct panel_mipi_dbi_device *panel = to_panel_mipi_dbi_device(drm);
+	struct mipi_dbi_dev *dbidev = &panel->dbidev;
+	struct mipi_dbi *dbi = &dbidev->dbi;
+	int ret, idx;
+
+	if (!drm_dev_enter(drm, &idx))
+		return;
+
+	panel->initialized = false;
+	panel->backlight_enabled = false;
+	ret = backlight_disable(dbidev->backlight);
+	if (ret)
+		goto out_error;
+
+	/* Reset is active low: logical 0/1/0 means physical 1/0/1. */
+	ret = gpiod_set_value_cansleep(dbi->reset, 0);
+	if (ret)
+		goto out_error;
+	usleep_range(10000, 11000);
+	ret = gpiod_set_value_cansleep(dbi->reset, 1);
+	if (ret)
+		goto out_error;
+	usleep_range(10000, 11000);
+	ret = gpiod_set_value_cansleep(dbi->reset, 0);
+	if (ret)
+		goto out_error;
+	msleep(20);
+
+	ret = panel_mipi_dbi_commands_execute(dbi, dbidev->driver_private);
+	if (ret)
+		goto out_error;
+	panel->initialized = true;
+	goto out_exit;
+
+out_error:
+	drm_err(drm, "Display initialization failed (%d)\n", ret);
+out_exit:
+	drm_dev_exit(idx);
+}
+
+static void qin_panel_atomic_disable(struct drm_crtc *crtc,
+				     struct drm_atomic_commit *state)
+{
+	struct drm_device *drm = crtc->dev;
+	struct panel_mipi_dbi_device *panel = to_panel_mipi_dbi_device(drm);
+	struct mipi_dbi *dbi = &panel->dbidev.dbi;
+	bool initialized = panel->initialized;
+	int ret;
+
+	panel->initialized = false;
+	panel->backlight_enabled = false;
+	ret = backlight_disable(panel->dbidev.backlight);
+	if (ret) {
+		drm_err(drm,
+			"Failed to disable backlight (%d); panel kept on\n",
+			ret);
+		return;
+	}
+
+	if (initialized) {
+		ret = mipi_dbi_command(dbi, MIPI_DCS_SET_DISPLAY_OFF);
+		if (ret)
+			goto out_reset;
+		msleep(120);
+		ret = mipi_dbi_command(dbi, MIPI_DCS_ENTER_SLEEP_MODE);
+		if (ret)
+			goto out_reset;
+		msleep(120);
+	}
+
+out_reset:
+	if (ret)
+		drm_err(drm, "Display sleep command failed (%d)\n", ret);
+	ret = gpiod_set_value_cansleep(dbi->reset, 1);
+	if (ret)
+		drm_err(drm, "Failed to assert display reset (%d)\n", ret);
+	else
+		msleep(20);
+}
