# Keep a kernel panic in the RAM session instead of restarting the boot chain.
CONFIG_CMDLINE="panic=0 mem_sleep_default=s2idle"
CONFIG_CMDLINE_EXTEND=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_SUSPEND_FREEZER=y
# CONFIG_CPU_IDLE is not set
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM_TEST_SUSPEND is not set
# CONFIG_DPM_WATCHDOG is not set
# CONFIG_WATCHDOG is not set
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_QIN1SPLUS_CAPTURE=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_I2C=y
CONFIG_I2C_SPRD=y
CONFIG_SC9820E_I2C2_CLOCK=y
CONFIG_AW87339=y
CONFIG_DRM=y
CONFIG_DRM_PANEL_MIPI_DBI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FB_DEVICE=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
# CONFIG_FB is not set
CONFIG_USB_MUSB_QIN1SPLUS_INHERITED=y
CONFIG_SC9820E_GPU_CLOCK=y
CONFIG_DRM_PANFROST=y
CONFIG_NVMEM_SPRD_EFUSE=y
CONFIG_MAILBOX=y
CONFIG_SPRD_MBOX=y
CONFIG_REMOTEPROC=y
CONFIG_QIN1SPLUS_SIPC=y
CONFIG_QIN1SPLUS_BTWF=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_RFKILL=y
# CONFIG_BT_QIN1SPLUS is not set
