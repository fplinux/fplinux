# SPDX-License-Identifier: GPL-2.0-only
config DRM_UNIWA_V1000
	bool "UNIWA V1000 4G LCDC display"
	depends on DRM && MACH_UNIWA_V1000_4G
	select DRM_UMS9117
	select DRM_UMS9117_SPI
	select DRM_UMS9117_WAKE_SLEEP_OUT
	help
	  Drive the UNIWA V1000 4G 320x240 panel through SPI1 and the LCDC
	  with atomic RGB565 and NV16 modesetting and 16-bit pixel transfers.
	  LCDC_DONE completes each transfer before its buffers are released.
	  Blanking enters panel sleep; waking sends the sleep-out command.
