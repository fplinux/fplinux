# SPDX-License-Identifier: GPL-2.0-only
config DRM_ITEL_NEO_R60_PLUS
	bool "itel Neo R60+ LCDC display"
	depends on DRM && MACH_ITEL_NEO_R60_PLUS
	select DRM_UMS9117
	select DRM_UMS9117_SPI
	select DRM_UMS9117_WAKE_REINIT
	help
	  Drive the ST7789H2 panel through SPI1 and the LCDC.
	  Support atomic RGB565 and NV16 modesetting.
	  Blanking turns off the display light.
	  Waking resets the panel and replays its initialization commands.
