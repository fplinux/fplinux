diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -1141,3 +1141,20 @@
 	  module will be called litex_mmc.

 	  If unsure, say N.
+
+config MMC_TA1618
+	tristate "Nokia TA-1618 removable microSD host"
+	depends on MACH_NOKIA_TA1618
+	depends on HAS_DMA
+	help
+	  Host for the removable microSD slot of the Nokia 3210 4G, driving
+	  the UMS9117 SDIO0 instance with the board's proven gate, clock,
+	  pin and analog rail recipe. This is not an SDHCI driver.
+
+	  Cards are read and written over a 4-bit bus in transfers of up to
+	  256 blocks, at 26 MHz once the card has agreed to high speed and
+	  at 13 MHz otherwise. Erase, lock and write-protect commands are
+	  refused before they can reach the controller. Card presence is not
+	  detected: the card must already be inserted when Linux starts, and
+	  removing it while mounted is not supported.
+	  The phone's internal storage is raw NAND on a different controller
+	  that this driver cannot reach.
diff --git a/drivers/mmc/host/Makefile b/drivers/mmc/host/Makefile
--- a/drivers/mmc/host/Makefile
+++ b/drivers/mmc/host/Makefile
@@ -114,3 +114,4 @@

 obj-$(CONFIG_MMC_SDHCI_XENON)	+= sdhci-xenon-driver.o
 sdhci-xenon-driver-y		+= sdhci-xenon.o sdhci-xenon-phy.o
+obj-$(CONFIG_MMC_TA1618)		+= ta1618-mmc.o
diff --git a/drivers/input/keyboard/Kconfig b/drivers/input/keyboard/Kconfig
--- a/drivers/input/keyboard/Kconfig
+++ b/drivers/input/keyboard/Kconfig
@@ -715,6 +715,17 @@ config KEYBOARD_TWL4030
 	  To compile this driver as a module, choose M here: the
 	  module will be called twl4030_keypad.

+config KEYBOARD_TA1618
+	bool "Nokia TA-1618 polled keypad"
+	depends on MACH_NOKIA_TA1618
+	help
+	  Poll the matrix keypad inherited from the TA-1618 bootstrap and
+	  the separate physical 8 key through inherited analog EIC9 state
+	  over ADI. The controller interrupt is not hardware-qualified on
+	  this board, so the proven configuration polls the packed
+	  key-status register. The EIC path is read-only, and the driver
+	  keeps working as a matrix-only keypad if the ADI read fails.
+
 config KEYBOARD_XTKBD
 	tristate "XT keyboard"
 	select SERIO
diff --git a/drivers/input/keyboard/Makefile b/drivers/input/keyboard/Makefile
--- a/drivers/input/keyboard/Makefile
+++ b/drivers/input/keyboard/Makefile
@@ -74,2 +74,3 @@ obj-$(CONFIG_KEYBOARD_TM2_TOUCHKEY)	+= tm2-touchkey.o
 obj-$(CONFIG_KEYBOARD_TWL4030)		+= twl4030_keypad.o
 obj-$(CONFIG_KEYBOARD_XTKBD)		+= xtkbd.o
+obj-$(CONFIG_KEYBOARD_TA1618)		+= ta1618-keypad.o
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
--- a/drivers/video/fbdev/Kconfig
+++ b/drivers/video/fbdev/Kconfig
@@ -1781,6 +1781,18 @@ config FB_HYPERV
 	  This driver is deprecated, please use the Hyper-V DRM driver at
 	  drivers/gpu/drm/hyperv (CONFIG_DRM_HYPERV) instead.

+config FB_TA1618
+	bool "Nokia TA-1618 bootstrap framebuffer"
+	depends on FB && MACH_NOKIA_TA1618
+	select FB_IOMEM_HELPERS
+	help
+	  Reuse the LCDC/SPI display state initialized by the TA-1618 RAM
+	  bootstrap. This is a board-specific handoff framebuffer, not a
+	  generic UMS9117 panel driver: it performs no cold panel, clock,
+	  pin or reset initialization. Refresh is a periodic polled
+	  full-frame copy through a private staging buffer that the LCDC
+	  streams into the SPI panel, so no display interrupt is required.
+
 config FB_SIMPLE
 	tristate "Simple framebuffer support"
 	depends on FB
