BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_VFPV4=y
BR2_ARM_EABIHF=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="6.18.40"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_FPLINUX_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="ta1618"
BR2_TARGET_GENERIC_ISSUE="FPLinux TA-1618 RAM system"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="/workspace/common/rootfs/overlay /workspace/targets/nokia-ta1618/rootfs/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="/workspace/buildroot-external/post-build.sh"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_FPLINUX_CONSOLE=y
BR2_PACKAGE_FPLINUX_INPUT=y
BR2_PACKAGE_FPLINUX_CPUCLOCK=y
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set
