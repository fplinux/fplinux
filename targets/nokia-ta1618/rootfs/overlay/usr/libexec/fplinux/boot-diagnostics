#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

if [ ! -r /proc/ta1618-hwdiag ]; then
	exit 0
fi

printf '%s\n' "USB handoff diagnostics:"
sed -n \
	-e '/^usb\.spi=/p' \
	-e '/^usb\.intid=/p' \
	-e '/^usb\.pending\./p' \
	-e '/^usb\.dma.*quiesce=/p' \
	/proc/ta1618-hwdiag
printf '%s\n\n' "Full record: cat /proc/ta1618-hwdiag"
