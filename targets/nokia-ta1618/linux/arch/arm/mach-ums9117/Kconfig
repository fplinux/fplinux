if ARCH_UMS9117

config MACH_NOKIA_TA1618
	bool "Nokia 3210 4G (TA-1618)"
	select GPIOLIB
	select GPIO_PMIC_EIC_SPRD
	select MFD_SYSCON
	help
	  Board support for the Nokia 3210 4G (TA-1618), a UMS9117
	  feature phone with 64 MiB of DRAM, a 240x320 panel and a matrix
	  keypad. BootROM/FDL USB loading supports a RAM system or U-Boot
	  with a microSD system root. Internal NAND remains read-only. The
	  low 2 MiB of DRAM belong to CM4; the top 2 MiB stay reserved for
	  DTB staging and the display buffer.

endif
