#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

description="FPLinux USB shell"
supervisor=supervise-daemon
command=/sbin/getty
command_args="-L -n -l /bin/sh 0 ttyGS0 linux"
respawn_delay=1
respawn_max=0
retry="TERM/2/KILL/2"

depend() {
	need devfs
	after fplinux-input
}
