# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-console
pkgver=1
pkgrel=0
pkgdesc="Physical keypad and framebuffer console for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev linux-headers gcc"
subpackages="$pkgname-openrc"
options="!check"
source="fplinux-console.c fplinux-multitap.c fplinux-multitap.h fplinux-console.initd"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-console.c" \
		"$srcdir/fplinux-multitap.c" $LDFLAGS -o fplinux-console
}

package() {
	install -Dm755 "$builddir/fplinux-console" "$pkgdir/usr/bin/fplinux-console"
	install -Dm755 "$srcdir/fplinux-console.initd" \
		"$pkgdir/etc/init.d/fplinux-console"
}

openrc() {
	default_openrc
}

