# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-base
pkgver=1.0.0
pkgrel=0
pkgdesc="Base userspace policy for FPLinux phones"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="openrc busybox-ifupdown"
makedepends_build="clang23 lld23"
makedepends_host="musl-dev"
replaces="alpine-baselayout-data alpine-release"
replaces_priority=100
options="!check"
source="fstab inittab interfaces hostname issue os-release fplinux-zram.initd
	fplinux-devices.initd
	fplinux-accounts
	fplinux-brightness.initd
	fplinux-kmsg.c fplinux-cli.c fplinux-cli.h
	fplinux-brightness.c fplinux-brightnessd.c
	fplinux-brightness-client.c fplinux-brightness-client.h
	fplinux-brightness-wire.c fplinux-brightness-wire.h
	fplinux-vt-guardian.c"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-kmsg.c" "$srcdir/fplinux-cli.c" \
		$LDFLAGS -Wl,--gc-sections -o fplinux-kmsg
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-brightness.c" \
		"$srcdir/fplinux-brightness-client.c" "$srcdir/fplinux-cli.c" \
		"$srcdir/fplinux-brightness-wire.c" \
		$LDFLAGS -o fplinux-brightness
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-brightnessd.c" \
		"$srcdir/fplinux-brightness-wire.c" \
		"$srcdir/fplinux-cli.c" $LDFLAGS -o fplinux-brightnessd
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		"$srcdir/fplinux-vt-guardian.c" $LDFLAGS \
		-o fplinux-vt-guardian
}

package() {
	install -Dm755 "$builddir/fplinux-kmsg" "$pkgdir/usr/libexec/fplinux/kmsg"
	install -Dm755 "$builddir/fplinux-brightness" "$pkgdir/usr/bin/fplinux-brightness"
	install -Dm755 "$builddir/fplinux-brightnessd" \
		"$pkgdir/usr/libexec/fplinux/brightnessd"
	install -Dm755 "$builddir/fplinux-vt-guardian" \
		"$pkgdir/usr/libexec/fplinux/vt-guardian"
	install -Dm644 "$srcdir/fstab" "$pkgdir/etc/fstab"
	install -Dm644 "$srcdir/inittab" "$pkgdir/etc/inittab"
	install -Dm644 "$srcdir/interfaces" "$pkgdir/etc/network/interfaces"
	install -Dm644 "$srcdir/hostname" "$pkgdir/etc/hostname"
	install -Dm644 "$srcdir/issue" "$pkgdir/etc/issue"
	install -Dm644 "$srcdir/os-release" "$pkgdir/etc/os-release"
	install -Dm755 "$srcdir/fplinux-zram.initd" \
		"$pkgdir/etc/init.d/fplinux-zram"
	install -Dm755 "$srcdir/fplinux-brightness.initd" \
		"$pkgdir/etc/init.d/fplinux-brightness"
	install -Dm755 "$srcdir/fplinux-devices.initd" \
		"$pkgdir/etc/init.d/fplinux-devices"
	install -Dm755 "$srcdir/fplinux-accounts" \
		"$pkgdir/usr/libexec/fplinux/accounts"

	mkdir -p "$pkgdir/sbin"
	ln -s /bin/busybox "$pkgdir/sbin/ifup"
	ln -s /bin/busybox "$pkgdir/sbin/ifdown"

	mkdir -p "$pkgdir/etc/runlevels/sysinit" "$pkgdir/etc/runlevels/boot" \
		"$pkgdir/etc/runlevels/default"
	for service in devfs dmesg procfs sysfs; do
		ln -s "/etc/init.d/$service" "$pkgdir/etc/runlevels/sysinit/$service"
	done
	ln -s /etc/init.d/fplinux-zram \
		"$pkgdir/etc/runlevels/sysinit/fplinux-zram"
	ln -s /etc/init.d/fplinux-devices \
		"$pkgdir/etc/runlevels/boot/fplinux-devices"
	ln -s /etc/init.d/fplinux-brightness \
		"$pkgdir/etc/runlevels/default/fplinux-brightness"
	for service in bootmisc hostname networking; do
		ln -s "/etc/init.d/$service" "$pkgdir/etc/runlevels/boot/$service"
	done

	ln -s /sbin/init "$pkgdir/init"
}

