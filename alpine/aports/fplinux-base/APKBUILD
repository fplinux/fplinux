# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-base
pkgver=1
pkgrel=0
pkgdesc="Base userspace policy for FPLinux phones"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
depends="openrc fplinux-console"
replaces="alpine-baselayout-data alpine-release"
replaces_priority=100
options="!check"
source="fstab inittab hostname issue os-release"

package() {
	install -Dm644 "$srcdir/fstab" "$pkgdir/etc/fstab"
	install -Dm644 "$srcdir/inittab" "$pkgdir/etc/inittab"
	install -Dm644 "$srcdir/hostname" "$pkgdir/etc/hostname"
	install -Dm644 "$srcdir/issue" "$pkgdir/etc/issue"
	install -Dm644 "$srcdir/os-release" "$pkgdir/etc/os-release"

	mkdir -p "$pkgdir/etc/runlevels/sysinit" "$pkgdir/etc/runlevels/boot" \
		"$pkgdir/etc/runlevels/default"
	for service in devfs dmesg procfs sysfs; do
		ln -s "/etc/init.d/$service" "$pkgdir/etc/runlevels/sysinit/$service"
	done
	for service in bootmisc hostname; do
		ln -s "/etc/init.d/$service" "$pkgdir/etc/runlevels/boot/$service"
	done
	ln -s /etc/init.d/fplinux-console \
		"$pkgdir/etc/runlevels/default/fplinux-console"

	ln -s /sbin/init "$pkgdir/init"
}

