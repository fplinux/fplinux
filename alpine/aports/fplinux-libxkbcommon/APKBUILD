# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-libxkbcommon
pkgver=1.13.2
pkgrel=0
pkgdesc="Keyboard layout library for FPLinux applications"
url="https://xkbcommon.org"
arch="armv7"
license="MIT AND MIT-open-group AND HPND AND HPND-sell-variant"
makedepends_build="bison clang22 lld22 llvm22 meson samurai"
makedepends_host="musl-dev"
subpackages="$pkgname-dev $pkgname-static"
options="!check"
source="libxkbcommon-$pkgver.tar.gz::https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$pkgver.tar.gz"
builddir="$srcdir/libxkbcommon-xkbcommon-$pkgver"

build() {
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '/usr/lib/llvm22/bin/llvm-ar'
		[properties]
		pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
	EOF
	abuild-meson \
		--cross-file fplinux-cross.meson \
		-Ddefault_library=both \
		-Denable-bash-completion=false \
		-Denable-docs=false \
		-Denable-tools=false \
		-Denable-wayland=false \
		-Denable-x11=false \
		-Denable-xkbregistry=false \
		-Dxkb-config-root=/usr/share/fplinux/xkb \
		output
	meson compile -j "${JOBS:-1}" -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
static() {
	pkgdesc="Static keyboard layout library for FPLinux applications"
	amove usr/lib/libxkbcommon.a
}

sha512sums="
261af9e02ad533bb6560e2711171812c7d92094db8b54eaa19b477ab68270e6d62b315e18d42527ca9c944e87f36f063d003d74aeb4829b21ecb96ab1b0c1ce7  libxkbcommon-1.13.2.tar.gz
"
