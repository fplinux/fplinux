# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-uclient
pkgver=@version:aport_uclient_daad21fa2c17cae54d37149bf27bb3dd78e50a3f_tar_gz@
pkgrel=0
pkgdesc="Small HTTP and HTTPS downloader using Mbed TLS"
url="https://git.openwrt.org/project/uclient.git"
arch="armv7"
license="ISC"
depends="ca-certificates-bundle"
makedepends_build="clang22 lld22 llvm22 cmake pkgconf samurai"
makedepends_host="json-c-dev fplinux-mbedtls-static-dev musl-dev"
options="!check"
_uclient_directory=@archive_prefix:aport_uclient_daad21fa2c17cae54d37149bf27bb3dd78e50a3f_tar_gz@
_libubox_directory=@archive_prefix:libubox@
_ustream_directory=@archive_prefix:aport_ustream_ssl_99f1c0db5a729f615bc5114b3b52fd8ac8083f34_tar_gz@
source="
	@source:aport_uclient_daad21fa2c17cae54d37149bf27bb3dd78e50a3f_tar_gz@
	@source:libubox@
	@source:aport_ustream_ssl_99f1c0db5a729f615bc5114b3b52fd8ac8083f34_tar_gz@
	0001-ustream-static-mbedtls.diff
"
builddir="$srcdir"

prepare() {
	default_prepare
	patch -d "$srcdir/$_ustream_directory" -p1 \
		<"$srcdir/0001-ustream-static-mbedtls.diff"
}

_build_component() {
	local component="$1"
	shift
	PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig" \
	cmake -S "$srcdir/$component" -B "$builddir/$component-build" -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=armv7 \
		-DCMAKE_C_COMPILER="$CC" -DCMAKE_C_COMPILER_TARGET="$CHOST" \
		-DCMAKE_SYSROOT="$CBUILDROOT" \
		-DCMAKE_C_FLAGS="$CFLAGS -ffile-prefix-map=$srcdir=." \
		-DCMAKE_FIND_ROOT_PATH="$builddir/stage;$CBUILDROOT" \
		-DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
		-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY \
		-DCMAKE_SKIP_RPATH=TRUE \
		-DCMAKE_AR=/usr/lib/llvm22/bin/llvm-ar \
		-DCMAKE_RANLIB=/usr/lib/llvm22/bin/llvm-ranlib \
		"$@"
	cmake --build "$builddir/$component-build" --parallel "${JOBS:-1}"
	DESTDIR="$builddir/stage" cmake --install "$builddir/$component-build"
}

build() {
	: "${CC:?missing target CC}" \
		"${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	_build_component "$_libubox_directory" \
		-DBUILD_LUA=OFF -DBUILD_EXAMPLES=OFF
	_build_component "$_ustream_directory" -DMBEDTLS=ON \
		-DCMAKE_C_FLAGS="$CPPFLAGS $CFLAGS -ffile-prefix-map=$srcdir=. -I$CBUILDROOT/usr/include/fplinux-mbedtls-static" \
		-Dmbedtls_library="$CBUILDROOT/usr/lib/fplinux-mbedtls-static/libmbedtls.a" \
		-Dmbedx509_library="$CBUILDROOT/usr/lib/fplinux-mbedtls-static/libmbedx509.a" \
		-Dmbedcrypto_library:STRING="$CBUILDROOT/usr/lib/fplinux-mbedtls-static/libmbedcrypto.a;$CBUILDROOT/usr/lib/fplinux-mbedtls-static/libeverest.a;$CBUILDROOT/usr/lib/fplinux-mbedtls-static/libp256m.a;pthread"
	_build_component "$_uclient_directory" -DBUILD_UCODE=OFF
}

package() {
	# The downloader loads the TLS backend by soname. Keep the three shared
	# libraries, but leave build helpers, headers and JSON tools out of the root.
	local library
	for library in libubox.so libustream-ssl.so libuclient.so; do
		install -Dm755 "$builddir/stage/usr/lib/$library" "$pkgdir/usr/lib/$library"
	done
	install -Dm755 "$builddir/stage/usr/bin/uclient-fetch" "$pkgdir/usr/bin/uclient-fetch"
	ln -s uclient-fetch "$pkgdir/usr/bin/wget"

	install -Dm644 "$CBUILDROOT/usr/share/licenses/fplinux-mbedtls-static-dev/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/MbedTLS-LICENSE"

	# The upstream projects keep ISC notices in their source headers.
	local component
	mkdir -p "$pkgdir/usr/share/licenses/$pkgname"
	for component in "$_uclient_directory" "$_libubox_directory" \
		"$_ustream_directory"; do
		sed -n '/Copyright/,/\*\//p' "$srcdir/$component/"*.c "$srcdir/$component/"*.h \
			>"$pkgdir/usr/share/licenses/$pkgname/$component.txt"
	done
}
sha512sums="
fb24955c80f395e29bd96b46e85c63ff86a0e35a515b622d07596209eafa50a40bd6dc10376e77e0613e00ab9a9ff9b6387e9e1050bdf6266013aa954a2f853b  0001-ustream-static-mbedtls.diff
"
