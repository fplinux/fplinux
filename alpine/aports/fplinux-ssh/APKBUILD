# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-ssh
pkgver=1
pkgrel=0
pkgdesc="Session-bound SSH and SFTP service for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
depends="dropbear fplinux-base fplinux-usb-gadget openssh-sftp-server openrc"
subpackages="$pkgname-openrc"
options="!check"
source="fplinux-ssh fplinux-session-id fplinux-ssh.initd"

package() {
	install -Dm755 "$srcdir/fplinux-ssh" \
		"$pkgdir/usr/libexec/fplinux/ssh-server"
	install -Dm755 "$srcdir/fplinux-session-id" \
		"$pkgdir/usr/bin/fplinux-session-id"
	install -Dm755 "$srcdir/fplinux-ssh.initd" \
		"$pkgdir/etc/init.d/fplinux-ssh"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-ssh \
		"$pkgdir/etc/runlevels/default/fplinux-ssh"
}

openrc() {
	default_openrc
}

