#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

description="FPLinux session-bound SSH and SFTP server"
supervisor=supervise-daemon
command=/usr/libexec/fplinux/ssh-server
input_file=/dev/null
output_log=/dev/kmsg
error_log=/dev/kmsg
respawn_delay=1
respawn_max=3
retry="TERM/2/KILL/2"

depend() {
	need fplinux-usb-gadget
}

stop_post() {
	rm -f -- /root/.ssh/authorized_keys
}
