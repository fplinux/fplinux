#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

name="FPLinux SSH and SFTP server"
description="Provide session-bound SSH and SFTP access"
supervisor=supervise-daemon
command=/usr/libexec/fplinux/ssh-server
input_file=/dev/null
output_logger="/usr/libexec/fplinux/kmsg --level 6 --tag fplinux-ssh"
error_logger="/usr/libexec/fplinux/kmsg --level 4 --tag fplinux-ssh"
respawn_delay=1
respawn_max=3
retry="TERM/2/KILL/2"

depend() {
	need fplinux-usb-gadget
}

stop_post() {
	rm -f -- /root/.ssh/authorized_keys
}
