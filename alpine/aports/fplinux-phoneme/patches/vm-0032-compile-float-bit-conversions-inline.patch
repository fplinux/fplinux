+// Float.floatToIntBits(), Float.intBitsToFloat(), Double.doubleToLongBits()
+// and Double.longBitsToDouble() as inline code.  The conversions to bits
+// replace every NaN with the canonical one, as the natives do.
+
+void CodeGenerator::float_to_int_bits(Value& result, Value& value JVM_TRAPS) {
+  JVM_IGNORE_TRAPS;
+  write_literals_if_desperate();
+  if (value.is_immediate()) {
+    jint bits = value.as_raw_int();
+    if ((bits & 0x7fffffff) > 0x7f800000) {
+      bits = 0x7fc00000;
+    }
+    result.set_int(bits);
+    return;
+  }
+
+  ensure_not_in_float_register(value);
+  RegisterAllocator::reference(value.lo_register());
+  result.assign_register();
+  RegisterAllocator::dereference(value.lo_register());
+
+  const Register bits = value.lo_register();
+  const Register res  = result.lo_register();
+
+  // A NaN has the exponent bits set and a non-zero fraction, that is,
+  // bits << 1 is above the one of an infinity.
+  mov(res, imm_shift(bits, lsl, 1));
+  cmp(res, imm(0xff000000));
+  mov(res, reg(bits), ls);
+  mov(res, imm(0x7f000000), hi);
+  orr(res, res, imm(0x00c00000), hi);
+}
+
+void CodeGenerator::int_bits_to_float(Value& result, Value& value JVM_TRAPS) {
+  JVM_IGNORE_TRAPS;
+  write_literals_if_desperate();
+  if (value.is_immediate()) {
+    result.set_raw_int(value.as_int());
+    return;
+  }
+
+  RegisterAllocator::reference(value.lo_register());
+  result.assign_register();
+  RegisterAllocator::dereference(value.lo_register());
+  fmsr(result.lo_register(), value.lo_register());
+}
+
+void CodeGenerator::double_to_long_bits(Value& result, Value& value JVM_TRAPS) {
+  JVM_IGNORE_TRAPS;
+  write_literals_if_desperate();
+  if (value.is_immediate()) {
+    jlong bits = value.as_raw_long();
+    if ((bits & JVM_LL(0x7fffffffffffffff)) > JVM_LL(0x7ff0000000000000)) {
+      bits = JVM_LL(0x7ff8000000000000);
+    }
+    result.set_long(bits);
+    return;
+  }
+
+  ensure_not_in_float_register(value);
+  RegisterAllocator::reference(value.lo_register());
+  RegisterAllocator::reference(value.hi_register());
+  result.assign_register();
+  RegisterAllocator::dereference(value.lo_register());
+  RegisterAllocator::dereference(value.hi_register());
+
+  const Register vmsw = TARGET_MSW_FIRST_FOR_DOUBLE ? value.lo_register()
+                                                    : value.hi_register();
+  const Register vlsw = TARGET_MSW_FIRST_FOR_DOUBLE ? value.hi_register()
+                                                    : value.lo_register();
+  const Register rmsw = result.msw_register();
+  const Register rlsw = result.lsw_register();
+
+  // A NaN has the exponent bits set and a non-zero fraction: the high word
+  // shifted left by one is above 0xffe00000, or equal to it with a non-zero
+  // low word.  cmn sets the carry for 0xffe00000 and above and the zero flag
+  // for 0xffe00000 only.
+  mov(rmsw, imm_shift(vmsw, lsl, 1));
+  cmn(rmsw, imm(0x00200000));
+  cmp(vlsw, zero, eq);
+  mov(rmsw, reg(vmsw), ls);
+  mov(rlsw, reg(vlsw), ls);
+  mov(rmsw, imm(0x7f000000), hi);
+  orr(rmsw, rmsw, imm(0x00f80000), hi);
+  mov(rlsw, zero, hi);
+}
+
+void CodeGenerator::long_bits_to_double(Value& result, Value& value JVM_TRAPS) {
+  JVM_IGNORE_TRAPS;
+  write_literals_if_desperate();
+  if (value.is_immediate()) {
+    result.set_raw_long(value.as_long());
+    return;
+  }
+
+  RegisterAllocator::reference(value.lo_register());
+  RegisterAllocator::reference(value.hi_register());
+  result.assign_register();
+  RegisterAllocator::dereference(value.lo_register());
+  RegisterAllocator::dereference(value.hi_register());
+  fmsrr(result.lo_register(), value.lsw_register(), value.msw_register());
+}
