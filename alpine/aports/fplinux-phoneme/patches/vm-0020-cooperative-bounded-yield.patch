Let the host wait briefly when a rapid Thread.yield loop has no runnable peer.

Keep normal dispatch when a Java timer is due during the wait. Returning a
timeout through the existing scheduler keeps the host event loop responsive.

--- a/cldc/src/vm/share/natives/Natives.cpp
+++ b/cldc/src/vm/share/natives/Natives.cpp
@@ -1094,7 +1094,19 @@
 }
 
 void Java_java_lang_Thread_yield() {
-  Scheduler::yield();
+  enum { spin_yields = 200 };
+  static jlong last_millis;
+  static int repeated_yields;
+  const jlong now = Os::monotonic_time_millis();
+  jlong idle_delay = 0;
+  if (now != last_millis) {
+    last_millis = now;
+    repeated_yields = 0;
+  } else if (++repeated_yields >= spin_yields) {
+    repeated_yields = 0;
+    idle_delay = 1;
+  }
+  Scheduler::yield(idle_delay);
 }
 
