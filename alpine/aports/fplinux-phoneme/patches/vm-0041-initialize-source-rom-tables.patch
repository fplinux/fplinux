Initialize symbol and string tables for source ROM images when constant-pool
rewriting is disabled. The source writer emits standalone hash tables in
this mode.

--- a/cldc/src/vm/share/ROM/ROMOptimizer.cpp
+++ b/cldc/src/vm/share/ROM/ROMOptimizer.cpp
@@ -251,6 +251,10 @@
         *embedded_table_holder() = hashtab_mgr.embedded_table_holder();
         _embedded_symbols_offset = hashtab_mgr.embedded_symbols_offset();
         _embedded_strings_offset = hashtab_mgr.embedded_strings_offset();
+      } else if (USE_SOURCE_IMAGE_GENERATOR) {
+        // The source image still needs standalone symbol and string tables.
+        initialize_hashtables(SymbolTable::current(), StringTable::current()
+                              JVM_CHECK);
       }
       set_next_state();
       break;
