+    private static int serialIntervalMillis() {
+        String limit = System.getProperty("fplinux.fps.limit");
+        if (limit == null) {
+            return 0;
+        }
+        try {
+            int fps = Integer.parseInt(limit);
+            return fps > 0 ? 1 + 999 / fps : 0;
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /** With LCDUILock held, delays only an isolated self-rescheduling callback. */
+    private boolean delaySerialContinuation(Runnable callback) {
+        if (SERIAL_INTERVAL_MS == 0 || !EventQueue.isDispatchThread()
+                || callback != activeSerialCallback || current != activeSerialCanvas
+                || current != pendingCurrent || wantsForeground != WANTS_FOREGROUND
+                || currentQueue.size() != 1) {
+            return false;
+        }
+        long remaining = SERIAL_INTERVAL_MS
+                - (JVM.monotonicTimeMillis() - activeSerialStart);
+        if (remaining <= 0) {
+            return false;
+        }
+        if (serialTimer == null) {
+            serialTimer = new Timer();
+        }
+        SerialWakeup wakeup = new SerialWakeup(this);
+        serialTimer.schedule(wakeup, remaining);
+        serialWakeup = wakeup;
+        return true;
+    }
+
+    /** Cancels the timer, leaving the callback in currentQueue. */
+    private static void cancelSerialWakeup() {
+        if (serialWakeup != null) {
+            serialWakeup.cancel();
+            serialWakeup = null;
+        }
+    }
+
+    /** Restores normal dispatch on a display transition, with LCDUILock held. */
+    private void releaseSerialWakeup() {
+        if (serialWakeup != null && serialWakeup.display == this) {
+            cancelSerialWakeup();
+            displayEventProducer.sendCallSeriallyEvent(consumer);
+        }
+    }
+
+    private static final class SerialWakeup extends TimerTask {
+        private final Display display;
+
+        SerialWakeup(Display display) {
+            this.display = display;
+        }
+
+        public void run() {
+            synchronized (LCDUILock) {
+                if (serialWakeup == this) {
+                    serialWakeup = null;
+                    displayEventProducer.sendCallSeriallyEvent(display.consumer);
+                }
+            }
+        }
+    }
