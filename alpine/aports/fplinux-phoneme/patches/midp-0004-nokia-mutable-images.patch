+                     ((argb >>> 5) & 0x07e0) |
+                     ((argb >>> 3) & 0x001f);
+        byte low = (byte) rgb565;
+        byte high = (byte) (rgb565 >>> 8);
+        for (int offset = 0; offset < pixelData.length; offset += 2) {
+            pixelData[offset] = low;
+            pixelData[offset + 1] = high;
+        }
+        if (alphaData != null) {
+            byte alpha = (byte) (argb >>> 24);
+            for (int i = 0; i < alphaData.length; i++) {
+                alphaData[i] = alpha;
+            }
+        }
+    }
