+        long y1 = Math.max(top, getClipY());
+        long x2 = Math.min(right, (long) getClipX() + getClipWidth());
+        long y2 = Math.min(bottom, (long) getClipY() + getClipHeight());
+        if (x2 <= x1 || y2 <= y1) {
