     const CompilerLiteralAccessor cla;
-    arith_imm(opcode1, R1, A1, op2.lsw_bits(), &cla, mode);
-    arith_imm(opcode2, R2, A2, op2.msw_bits(), &cla);
+    // A logical operation that leaves a word unchanged needs no instruction
+    // when the result shares the register of the operand.
+    if (!(R1 == A1 && is_logical_identity(opcode1, op2.lsw_bits()))) {
+      arith_imm(opcode1, R1, A1, op2.lsw_bits(), &cla, mode);
+    }
+    if (!(R2 == A2 && is_logical_identity(opcode2, op2.msw_bits()))) {
+      arith_imm(opcode2, R2, A2, op2.msw_bits(), &cla);
+    }
   } else {
     arith(opcode1, R1, A1, reg(op2.lsw_register()), mode);
