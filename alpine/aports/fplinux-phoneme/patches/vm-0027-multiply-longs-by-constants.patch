   JVM_IGNORE_TRAPS;
-  // Should eventually detect multiplication by small (0..10) and
-  // by 32bit constants and generate better code for those cases.
   write_literals_if_desperate();
 
   op1.materialize();
+
+  if (op2.is_immediate()) {
+    // long_binary swaps an immediate first operand, so only op2 can be one.
+    const jlong c = op2.as_long();
+    if (c == min_jlong || (c > 0 && (c & (c - 1)) == 0)) {
+      // multiplication by a power of two is a shift
+      int shift = 0;
+      while (((julong)c >> shift) != 1) {
+        shift++;
