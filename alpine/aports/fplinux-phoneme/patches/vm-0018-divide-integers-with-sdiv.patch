+
+// Whether this processor has SDIV (the Linux HWCAP_IDIVA bit).
+static bool has_hardware_divide() {
+#if defined(__arm__) && defined(__linux__) && !CROSS_GENERATOR
+  static int known = -1;
+  if (known < 0) {
+    enum { AT_HWCAP_TYPE = 16, HWCAP_IDIVA_BIT = 1 << 17 };
+    known = (getauxval(AT_HWCAP_TYPE) & HWCAP_IDIVA_BIT) != 0;
+  }
+  return known != 0 && !GenerateROMImage;
+#else
+  return false;
+#endif
+}
