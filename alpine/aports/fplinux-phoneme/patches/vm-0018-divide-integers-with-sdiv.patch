Divide integers with SDIV when the processor has it.

Compiled code divided by a register value through a shared stub: the frame
was flushed to memory, and the stub found each quotient bit with a compare
and a subtraction. Cortex-A7 has SDIV, which rounds toward zero and gives
MIN_VALUE for MIN_VALUE / -1 as Java requires, so idiv and irem become a
zero check and one or two instructions when Linux reports HWCAP_IDIVA.

--- a/cldc/src/vm/cpu/arm/Assembler_arm.hpp
+++ b/cldc/src/vm/cpu/arm/Assembler_arm.hpp
@@ -493,6 +493,17 @@
     emit(cond << 28 | 0x016f0f10 | rd << 12 | rm);
   }

+  // Integer divide extension (Cortex-A7 and later): rd = rn / rm.
+  void sdiv(Register rd, Register rn, Register rm, Condition cond = al) {
+    emit(cond << 28 | 0x0710f010 | rd << 16 | rm << 8 | rn);
+  }
+
+  // rd = ra - rn * rm
+  void mls(Register rd, Register rn, Register rm, Register ra,
+           Condition cond = al) {
+    emit(cond << 28 | 0x00600090 | rd << 16 | ra << 12 | rm << 8 | rn);
+  }
+
   void bx(Register rm, Condition cond = al) {
     emit(cond << 28 | 0x012fff10 | rm);
   }
