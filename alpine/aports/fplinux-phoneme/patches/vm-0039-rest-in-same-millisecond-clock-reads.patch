+jlong Os::java_time_millis_and_phase(jint* phase_us) {
+    struct timeval tv;
+    ::jvm_gettimeofday(&tv, NULL);
+    const jint usec = (jint)tv.tv_usec;
+    const jint millis = usec / 1000;
+    *phase_us = usec - millis * 1000;
+    return (jlong)tv.tv_sec * 1000 + millis;
+}
