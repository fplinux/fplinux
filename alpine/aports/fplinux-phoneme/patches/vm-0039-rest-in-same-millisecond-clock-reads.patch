+bool Scheduler::has_runnable_peer() {
+#if ENABLE_ISOLATES
+  return true;
+#else
+  // Every ready thread, the current one included, is in the circular queue
+  // of its priority.
+  ObjArray::Raw queues = Universe::scheduler_priority_queues();
+  int queues_in_use = 0;
+  for (int priority = ThreadObj::NUM_PRIORITY_SLOTS; priority > 0; priority--) {
+    Thread::Raw first = queues().obj_at(priority);
+    if (first.not_null()) {
+      Thread::Raw next = first().next();
+      if (!next.equals(&first) || ++queues_in_use > 1) {
+        return true;
+      }
+    }
+  }
+  return false;
+#endif
+}
