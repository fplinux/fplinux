 jlong Java_java_lang_System_currentTimeMillis() {
-  return Os::java_time_millis();
+  // Games wait for their next frame in loops that only read the clock,
+  // keeping the processor busy at full speed. A thread that reads the same
+  // millisecond many times in a row is such a loop, and nothing it waits
+  // for can happen before the next millisecond. So rest, unless another
+  // Java thread can run, for less than the rest of the millisecond. A clock
+  // that does not advance within a millisecond gets a short fixed rest.
+  enum { spin_reads = 32, margin_us = 200, min_rest_us = 100,
+         coarse_rest_us = 500 };
+  static jlong last_millis;
+  static jint last_thread = -1;
+  static int reads;
+  static jint first_phase;
+  jint phase;
+  jlong now = Os::java_time_millis_and_phase(&phase);
+  const jint thread = Thread::current()->id();
+  if (now != last_millis || thread != last_thread) {
+    last_millis = now;
+    last_thread = thread;
+    reads = 1;
+    first_phase = phase;
+  } else if (++reads >= spin_reads) {
+    reads = 0;
+    if (!Scheduler::has_runnable_peer()) {
+      const jint rest = phase != first_phase ?
+                        1000 - phase - margin_us : coarse_rest_us;
+      if (rest >= min_rest_us) {
+        Os::sleep_micros(rest);
+        now = Os::java_time_millis_and_phase(&phase);
+        if (now != last_millis) {
+          last_millis = now;
+          first_phase = phase;
+        }
+      }
+    }
+  }
+  return now;
 }
 
