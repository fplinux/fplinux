+static jlong earliest_waiting_deadline() {
+  Thread::Raw queue;
+  Thread::Raw thread;
+  jlong deadline = 0;
+
+  for (queue = Universe::scheduler_waiting(); !queue.is_null();
+       queue = queue().next_waiting()) {
+    for (thread = queue.obj(); !thread.is_null(); thread = thread().next()) {
+      jlong wakeup = thread().wakeup_time();
+      if (wakeup != 0 && (deadline == 0 || wakeup < deadline)) {
+        deadline = wakeup;
+      }
+    }
+  }
+  return deadline;
+}
