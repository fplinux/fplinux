@@ -36,7 +36,8 @@
   template( int,                      bci                            )\
   template( int,                      saved_num_stack_lock_words     )\
   template( bool,                     in_loop                        )\
-  template( bool,                     has_loops                      )
+  template( bool,                     has_loops                      )\
+  template( bool,                     keeps_receiver                 )
 
 #if ENABLE_INLINE
 #define INLINER_COMPILER_CONTEXT_FIELDS_DO(template)  \
--- a/cldc/src/vm/share/compiler/Compiler.cpp
+++ b/cldc/src/vm/share/compiler/Compiler.cpp
@@ -493,6 +493,9 @@
 #endif
 
   Compiler::set_has_loops( attributes.has_loops );
+  // Local 0 then holds the receiver on every path through the method.
+  Compiler::set_keeps_receiver( !method()->is_static() &&
+                                !attributes.writes_local_0 );
 
   { // Allocate object array for the entry table
     EntryTableType* p =
--- a/cldc/src/vm/share/compiler/VirtualStackFrame.cpp
+++ b/cldc/src/vm/share/compiler/VirtualStackFrame.cpp
@@ -527,6 +527,22 @@
     }
   }
 
+  if (merging && Compiler::root()->keeps_receiver()) {
+    // No bytecode stores into local 0, so every path into this entry still
+    // has the receiver there, as VirtualStackFrame::create() described it.
+    RawLocation* receiver = raw_location_at(0);
+    if (receiver->type() == T_OBJECT) {
+      receiver->set_flags(Value::F_MUST_BE_NONNULL);
+#if ENABLE_COMPILER_TYPE_INFO
+      JavaClass::Raw holder = Compiler::root()->method()->holder();
+      receiver->set_class_id(holder().class_id());
+      if (holder().is_final_type()) {
+        receiver->set_is_exact_type();
+      }
+#endif
+    }
+  }
+
   // Mark all the literals as being junk
   clear_literals();
 
