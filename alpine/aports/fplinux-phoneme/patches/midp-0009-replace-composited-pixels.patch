+    void replaceARGB(int[] values, int start, int stride, int x, int y,
+                     int w, int h) {
+        if (w < 0 || h < 0 || x < 0 || y < 0 ||
+                w > width - x || h > height - y) {
+            throw new IllegalArgumentException("pixel region");
+        }
+        if (w == 0 || h == 0) {
+            return;
+        }
+        long last = start + (long) (h - 1) * stride;
+        if (Math.min(last, (long) start) < 0 ||
+                Math.max(last, (long) start) + w > values.length) {
+            throw new ArrayIndexOutOfBoundsException();
+        }
+        for (int row = 0; row < h; row++) {
+            int source = start + row * stride;
+            int target = (y + row) * width + x;
+            for (int col = 0; col < w; col++, target++) {
