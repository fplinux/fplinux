+/*
+ * End of the run of alpha values from column on whose bits under mask all
+ * equal value. Sprites consist mostly of opaque and transparent runs, so the
+ * values are tested four at a time.
+ */
+static int
+alpha_run_end(const unsigned char *alpha, int column, int width,
+              unsigned int mask, unsigned int value) {
+    const uint32_t mask4 = mask * 0x01010101u, value4 = value * 0x01010101u;
+    uint32_t four;
+
+    while (column + 4 <= width) {
+        memcpy(&four, alpha + column, sizeof(four));
+        if ((four & mask4) != value4)
+            break;
+        column += 4;
+    }
+    while (column < width && (alpha[column] & mask) == value)
+        column++;
+    return column;
+}
+
+/*
+ * Draws source over old with an alpha above 3 and below 255: each channel
+ * becomes (s * a + o * (max - a)) >> bits with the channel's alpha a. Red and
+ * blue are weighed together in place, since each weighted sum stays below
+ * 1024 and the red one starts at bit 11; green, below 4096, separately.
+ */
+static gxj_pixel_type
+blend_pixel(gxj_pixel_type source, gxj_pixel_type old, unsigned int alpha) {
+    unsigned int a2 = alpha >> 2;
+    unsigned int a3 = alpha >> 3;
+    uint32_t red_blue = ((source & 0xF81Fu) * a3 + (old & 0xF81Fu) * (31 - a3)) >> 5;
+    uint32_t green = ((source & 0x07E0u) * a2 + (old & 0x07E0u) * (63 - a2)) >> 6;
+
+    return (gxj_pixel_type)((red_blue & 0xF81Fu) | (green & 0x07E0u));
+}
