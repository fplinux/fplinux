# Russian translation of fplinux-phoneme (org.fplinux.phoneme). MIDlets
# bring their own text.
# SPDX-License-Identifier: GPL-2.0-only
msgid ""
msgstr ""
"Project-Id-Version: org.fplinux.phoneme\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Close phoneME and open it again."
msgstr "Закройте phoneME и откройте его снова."

msgid "Close"
msgstr "Закрыть"

msgid "File damaged"
msgstr "Файл повреждён"

msgid "File unreadable"
msgstr "Файл не читается"

msgid "MIDlet stopped"
msgstr "Мидлет прерван"

msgid "No MIDlets"
msgstr "Нет мидлетов"

msgid "Not started"
msgstr "Не запущено"

msgid "Out of memory"
msgstr "Мало памяти"

msgid "Start"
msgstr "Старт"

msgid "Starting"
msgstr "Запуск"

msgid "The JAR file has no MIDlets. It may be a program for a computer."
msgstr "В JAR-файле нет мидлетов. Возможно, это программа для компьютера."

msgid "The JAR file is damaged."
msgstr "JAR-файл повреждён."

msgid "The MIDlet “%s” ended with an error. Open phoneME again."
msgstr "Мидлет «%s» завершился с ошибкой. Откройте phoneME снова."

msgid "Vendor"
msgstr "Разработчик"

msgid "Version"
msgstr "Версия"

msgid "phoneME cannot read this file."
msgstr "phoneME не может прочитать этот файл."

msgid "“%s” could not start. Open phoneME again."
msgstr "Не удалось запустить «%s». Откройте phoneME ещё раз."

msgid "Close MIDlet?"
msgstr "Закрыть мидлет?"

msgid "Record stores are temporary and will be removed when phoneME closes."
msgstr "Сохранения временные: они будут удалены при закрытии phoneME."

msgid "Open a JAR file from Files."
msgstr "Откройте JAR-файл через «Файлы»."
