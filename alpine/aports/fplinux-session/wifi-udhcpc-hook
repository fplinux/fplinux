#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# DHCP supplies whitespace-separated lists, never pathname patterns.
set -f

state_dir=${FPLINUX_WIFI_DHCP_STATE:-}
[ -d "$state_dir" ] && [ -n "${interface:-}" ] || exit 1
resolver_key="fplinux-wifi.$interface"
# BusyBox ip depends on a system file for the symbolic name of RTPROT_DHCP.
route_protocol=16

publish_status() {
	printf '%s\n' "$1" >"$state_dir/status.new" &&
		mv "$state_dir/status.new" "$state_dir/status"
}

delete_routes() {
	if [ -f "$state_dir/routes" ]; then
		while read -r destination gateway metric; do
			route_change del "$destination" "$gateway" "$metric" 2>/dev/null || :
		done <"$state_dir/routes"
		rm -f "$state_dir/routes"
	fi
}

delete_address() {
	if [ -f "$state_dir/address" ]; then
		read -r old_address <"$state_dir/address"
		ip -4 addr del "$old_address" dev "$interface" 2>/dev/null || :
		rm -f "$state_dir/address"
	fi
}

delete_dns() {
	if [ -f "$state_dir/dns" ]; then
		resolvconf -f -d "$resolver_key" || :
		rm -f "$state_dir/dns"
	fi
}

deconfigure() {
	rm -f "$state_dir/status" "$state_dir/status.new" "$state_dir/offered-routes"
	delete_routes
	delete_address
	delete_dns
}

is_ip_word() {
	case "$1" in
	'' | *[!0-9.]*) return 1 ;;
	*.*.*.*) return 0 ;;
	*) return 1 ;;
	esac
}

is_prefix_length() {
	case "$1" in
	[0-9] | [12][0-9] | 3[0-2]) return 0 ;;
	*) return 1 ;;
	esac
}

route_change() {
	if [ "$3" = 0.0.0.0 ]; then
		ip -4 route "$1" "$2" dev "$interface" scope link metric "$4" protocol "$route_protocol"
	elif [ "$1" = add ]; then
		ip -4 route add "$2" via "$3" dev "$interface" metric "$4" protocol "$route_protocol" onlink
	else
		ip -4 route del "$2" via "$3" dev "$interface" metric "$4" protocol "$route_protocol"
	fi
}

offer_routes() {
	# Keep the Wi-Fi default behind other configured transports.
	route_metric=600
	if [ -n "${staticroutes:-}" ]; then
		# Option 121 takes precedence over the Router option.
		# shellcheck disable=SC2086
		set -- $staticroutes
		while [ "$#" -ge 2 ]; do
			is_ip_word "${1%/*}" && is_prefix_length "${1#*/}" &&
				is_ip_word "$2" || return 1
			printf '%s %s %s\n' "$1" "$2" "$route_metric" || return 1
			route_metric=$((route_metric + 1))
			shift 2
		done
		[ "$#" -eq 0 ]
	else
		# shellcheck disable=SC2086
		for gateway in ${router:-}; do
			is_ip_word "$gateway" && [ "$gateway" != 0.0.0.0 ] || return 1
			printf 'default %s %s\n' "$gateway" "$route_metric" || return 1
			route_metric=$((route_metric + 1))
		done
	fi
}

apply_routes() {
	offer_routes >"$state_dir/offered-routes" || return 1
	if cmp -s "$state_dir/offered-routes" "$state_dir/routes"; then
		return 0
	fi
	delete_routes
	while read -r destination gateway metric; do
		route_change add "$destination" "$gateway" "$metric" || return 1
		if ! printf '%s %s %s\n' "$destination" "$gateway" "$metric" >>"$state_dir/routes"; then
			route_change del "$destination" "$gateway" "$metric"
			return 1
		fi
	done <"$state_dir/offered-routes"
}

apply_address() {
	is_ip_word "${ip:-}" && [ "$ip" != 0.0.0.0 ] &&
		is_prefix_length "${mask:-}" || return 1
	new_address="$ip/$mask"
	if [ -f "$state_dir/address" ] &&
		read -r old_address <"$state_dir/address" &&
		[ "$old_address" = "$new_address" ]; then
		return 0
	fi
	rm -f "$state_dir/status"
	delete_routes
	delete_address
	ip -4 addr add "$new_address" broadcast + dev "$interface" || return 1
	if ! printf '%s\n' "$new_address" >"$state_dir/address"; then
		ip -4 addr del "$new_address" dev "$interface"
		return 1
	fi
}

apply_dns() {
	if [ -z "${dns:-}" ]; then
		delete_dns
		return
	fi
	command -v resolvconf >/dev/null || return 0
	if [ -e /etc/resolv.conf ] || [ -L /etc/resolv.conf ]; then
		[ -r /etc/resolv.conf ] && IFS= read -r signature </etc/resolv.conf &&
			[ "$signature" = '# Generated by resolvconf' ] || return 0
	fi
	: >"$state_dir/dns" || return 1
	{
		dns_search=${search:-${domain:-}}
		case "$dns_search" in
		'' | *[!a-zA-Z0-9._\ -]*) ;;
		*) printf 'search %s\n' "$dns_search" ;;
		esac
		# shellcheck disable=SC2086
		for nameserver in $dns; do
			if is_ip_word "$nameserver" && [ "$nameserver" != 0.0.0.0 ]; then
				printf 'nameserver %s\n' "$nameserver"
			fi
		done
	} | resolvconf -a "$resolver_key"
}

case "$1" in
bound | renew)
	if apply_address && apply_routes; then
		apply_dns || :
		publish_status "$ip"
	else
		deconfigure
		publish_status failed
	fi
	;;
deconfig | stop)
	deconfigure
	;;
leasefail)
	deconfigure
	publish_status failed
	;;
nak) ;;
*) exit 1 ;;
esac
