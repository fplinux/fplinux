builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-fPIC -shared -I"$srcdir" \
		$(pkg-config --cflags libweston-16 weston json-c pixman-1) \
		fplinux-shell.c session-core.c session-power.c session-settings.c \
		session-audio.c session-vibration.c session-vibrator.c \
		fplinux-settings-values.c \
		session-battery.c session-clock.c clock-model.c clock-wire.c \
		session-launch-surface.c fplinux-ui-session.c fplinux-ui-prefs.c \
		fplinux-ui-profile.c fplinux-keypad-light.c \
		fplinux-brightness-client.c fplinux-language.c fplinux-desktop-entry.c \
		fplinux-utf8.c \
		$(pkg-config --libs libweston-16 json-c pixman-1) \
		$LDFLAGS -o fplinux-shell.so
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm json-c) \
		preparation.c preparation-status.c preparation-render.c \
		fplinux-ui-profile.c \
		fplinux-drm-session.c fplinux-font.c fplinux-cli.c fplinux-utf8.c \
		$(pkg-config --libs libdrm json-c) $LDFLAGS -o preparation
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" clock-signal.c session-vibrator.c \
		fplinux-audio-client.c fplinux-cli.c \
		-lm $LDFLAGS -o clock-signal
}

package() {
	install -d -m755 "$pkgdir/var/lib/fplinux"
	install -Dm755 "$builddir/fplinux-shell.so" "$pkgdir/usr/lib/weston/fplinux-shell.so"
	install -Dm755 "$srcdir/fplinux-session" "$pkgdir/usr/bin/fplinux-session"
	install -Dm755 "$srcdir/fplinux-session.initd" "$pkgdir/etc/init.d/fplinux-session"
	install -Dm755 "$builddir/preparation" "$pkgdir/usr/libexec/fplinux/preparation"
	install -Dm755 "$builddir/clock-signal" "$pkgdir/usr/libexec/fplinux/clock-signal"
	install -Dm644 "$srcdir/weston.ini" "$pkgdir/etc/fplinux/weston.ini"
	install -Dm644 "$srcdir/10-fplinux.quirks" \
		"$pkgdir/usr/share/fplinux/libinput/10-fplinux.quirks"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-session \
		"$pkgdir/etc/runlevels/default/fplinux-session"
}

