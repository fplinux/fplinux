# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-session
pkgver=1
pkgrel=0
pkgdesc="Graphical phone session and application lifecycle"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-libweston fplinux-brand fplinux-font-terminus-data json-c"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev linux-headers fplinux-libweston-dev json-c-dev pixman-dev fplinux-libdrm-dev"
subpackages="$pkgname-openrc"
install="$pkgname.pre-install"
options="!check"
source="
	fplinux-shell.c
	session-core.c
	session-core.h
	session-launch-surface.c
	session-launch-surface.h
	fplinux-pixman-buffer.h
	fplinux-weston-presentation.h
	session-power.c
	session-power.h
	session-settings.c
	session-settings.h
	fplinux-settings-values.c
	fplinux-settings-values.h
	session-battery.c
	session-battery.h
	fplinux-session
	fplinux-session.initd
	weston.ini
	10-fplinux.quirks
	fplinux-ui-session.c
	fplinux-ui-session.h
	fplinux-desktop-entry.c
	fplinux-desktop-entry.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
	fplinux-keypad.h
	fplinux-keypad-light.c
	fplinux-keypad-light.h
	fplinux-brightness-client.c
	fplinux-brightness-client.h
	fplinux-language.c
	fplinux-language.h
	preparation.c
	preparation.h
	preparation-status.c
	preparation-render.c
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-font.c
	fplinux-font.h
	fplinux-cli.c
	fplinux-cli.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-fPIC -shared -I"$srcdir" \
		$(pkg-config --cflags libweston-16 weston json-c pixman-1) \
		fplinux-shell.c session-core.c session-power.c session-settings.c \
		fplinux-settings-values.c \
		session-battery.c session-launch-surface.c fplinux-ui-session.c \
		fplinux-ui-profile.c fplinux-keypad-light.c \
		fplinux-brightness-client.c fplinux-language.c fplinux-desktop-entry.c \
		$(pkg-config --libs libweston-16 json-c pixman-1) \
		$LDFLAGS -o fplinux-shell.so
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm json-c) \
		preparation.c preparation-status.c preparation-render.c \
		fplinux-drm-session.c fplinux-font.c fplinux-cli.c \
		$(pkg-config --libs libdrm json-c) $LDFLAGS -o preparation
}

package() {
	install -Dm755 "$builddir/fplinux-shell.so" "$pkgdir/usr/lib/weston/fplinux-shell.so"
	install -Dm755 "$srcdir/fplinux-session" "$pkgdir/usr/bin/fplinux-session"
	install -Dm755 "$srcdir/fplinux-session.initd" "$pkgdir/etc/init.d/fplinux-session"
	install -Dm755 "$builddir/preparation" "$pkgdir/usr/libexec/fplinux/preparation"
	install -Dm644 "$srcdir/weston.ini" "$pkgdir/etc/fplinux/weston.ini"
	install -Dm644 "$srcdir/10-fplinux.quirks" \
		"$pkgdir/usr/share/fplinux/libinput/10-fplinux.quirks"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-session \
		"$pkgdir/etc/runlevels/default/fplinux-session"
}

