pkgver=1
pkgrel=0
pkgdesc="Graphical phone session and application lifecycle"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-libweston fplinux-brand fplinux-font-terminus-data fplinux-audio fplinux-audiod json-c"
