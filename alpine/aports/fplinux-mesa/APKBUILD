# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-mesa
pkgver=@version:aport_mesa_26_2_5_tar_xz@
pkgrel=0
pkgdesc="Panfrost EGL, OpenGL and OpenGL ES libraries for FPLinux"
url="https://www.mesa3d.org"
arch="armv7"
license="MIT AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND SGI-B-2.0 AND Apache-2.0"
depends="fplinux-libdrm fplinux-mesa-gbm=$pkgver-r$pkgrel libexpat"
depends_dev="fplinux-mesa-headers=$pkgver-r$pkgrel fplinux-mesa-gbm-dev=$pkgver-r$pkgrel"
makedepends_build="bison clang22 clang22-dev flex lld22 llvm22-dev meson pkgconf py3-mako py3-packaging py3-yaml python3 samurai spirv-llvm-translator-dev spirv-tools-dev"
makedepends_host="musl-dev linux-headers libstdc++-dev eudev-dev fplinux-expat-dev fplinux-libdrm-dev fplinux-mesa-gbm-dev"
subpackages="$pkgname-dev"
options="!check"
source="
	@source:aport_mesa_26_2_5_tar_xz@
	neon-clang.patch
	afbc-policy.patch
	NOTICE
"
builddir="$srcdir/mesa-$pkgver"

build() {
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	# Internal shaders are compiled by native tools from this same release.
	CC=clang CXX=clang++ CPPFLAGS="${HOSTCPPFLAGS:-}" CFLAGS=-Os \
		CXXFLAGS=-Os LDFLAGS=-fuse-ld=lld \
		PKG_CONFIG_PATH= \
		PKG_CONFIG_LIBDIR=/usr/lib/pkgconfig:/usr/share/pkgconfig \
		PKG_CONFIG_SYSROOT_DIR=/ \
		PATH="/usr/lib/llvm22/bin:$PATH" \
		meson setup --prefix=/usr --libdir=lib --buildtype=release \
		--auto-features=disabled --wrap-mode=nodownload \
		-Dgallium-drivers= -Dvulkan-drivers= -Dplatforms= \
		-Dopengl=false -Dgles1=disabled -Dgles2=disabled \
		-Degl=disabled -Dglx=disabled -Dgbm=disabled \
		-Dllvm=enabled -Dshared-llvm=enabled -Ddraw-use-llvm=false \
		-Dspirv-tools=enabled \
		-Dmesa-clc=enabled -Dinstall-mesa-clc=true \
		-Dprecomp-compiler=enabled -Dinstall-precomp-compiler=true \
		-Dtools=panfrost -Dpanfrost-rust=false \
		-Dzlib=disabled -Dzstd=disabled -Dshader-cache=disabled \
		-Dxmlconfig=disabled -Dexpat=disabled -Dbuild-tests=false \
		host-output
	PATH="/usr/lib/llvm22/bin:$PATH" meson compile -j "${JOBS:-1}" -C host-output \
		mesa_clc vtn_bindgen2 panfrost_compile
	export PATH="$builddir/host-output/src/compiler/clc:$builddir/host-output/src/compiler/spirv:$builddir/host-output/src/panfrost/clc:$PATH"
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '$CHOST-ar'
		[properties]
		pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
	EOF
	abuild-meson --cross-file fplinux-cross.meson \
		--sysconfdir=/etc \
		--auto-features=disabled \
		-Ddefault_library=shared -Db_ndebug=true \
		-Dgallium-drivers=panfrost -Dvulkan-drivers= -Dplatforms= \
		-Dopengl=true -Dgles1=disabled -Dgles2=enabled \
		-Degl=enabled -Degl-native-platform=surfaceless \
		-Dglx=disabled -Dglvnd=disabled -Dgbm=enabled \
		-Dlibgbm-external=true \
		-Dllvm=disabled -Dmesa-clc=system -Dprecomp-compiler=system \
		-Dpanfrost-rust=false -Dgallium-rusticl=false \
		-Dzlib=disabled -Dzstd=disabled -Dshader-cache=disabled \
		-Dxmlconfig=enabled -Dexpat=enabled -Dbuild-tests=false \
		output
	meson compile -j "${JOBS:-1}" -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	mkdir -p "$pkgdir/usr/share/licenses/$pkgname"
	cp -r licenses/. "$pkgdir/usr/share/licenses/$pkgname/"
	install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
	install -Dm644 "$CBUILDROOT/usr/share/licenses/fplinux-expat-dev/COPYING" \
		"$pkgdir/usr/share/licenses/libexpat/COPYING"
}

dev() {
	# Public API headers have one owner in the independent headers package.
	rm -rf "${pkgdir:?}/usr/include/EGL" "${pkgdir:?}/usr/include/GLES2" \
		"${pkgdir:?}/usr/include/GLES3" "${pkgdir:?}/usr/include/KHR"
	rm -f "${pkgdir:?}/usr/include/GL/gl.h" "${pkgdir:?}/usr/include/GL/glcorearb.h" \
		"${pkgdir:?}/usr/include/GL/glext.h"
	default_dev
}

