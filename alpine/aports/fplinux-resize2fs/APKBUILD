# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-resize2fs
pkgver=@version:aport_e2fsprogs_1_47_4_tar_xz@
pkgrel=0
pkgdesc="Ext2/3/4 filesystem resizer for FPLinux"
url="https://e2fsprogs.sourceforge.net/"
arch="armv7"
license="GPL-2.0-or-later"
depends="e2fsprogs-libs=$pkgver-r0 libcom_err=$pkgver-r0"
makedepends_build="clang22 gawk lld22"
makedepends_host="e2fsprogs-libs libcom_err linux-headers musl-dev"
options="!check"
source="
	@source:aport_e2fsprogs_1_47_4_tar_xz@
"
builddir="$srcdir/e2fsprogs-$pkgver"

build() {
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--with-udev-rules-dir=no \
		--enable-elf-shlibs \
		--enable-libuuid \
		--enable-libblkid \
		--disable-debugfs \
		--disable-imager \
		--disable-defrag \
		--disable-fuse2fs \
		--disable-e2initrd-helper \
		--disable-fsck \
		--disable-uuidd \
		--disable-nls
	# Generate headers and build the resizer's three libraries without the
	# unrelated utilities. The installed resizer uses Alpine's shared libraries.
	make top-deps
	make -C lib/et
	make -C lib/e2p
	make -C lib/ext2fs
	make -C resize resize2fs
}

package() {
	install -Dm755 "$builddir/resize/resize2fs" "$pkgdir/usr/sbin/resize2fs"
}
sha512sums="
"
