# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-audio
pkgver=@version:aport_alsa_utils_1_2_16_tar_bz2@
pkgrel=0
pkgdesc="ALSA playback, capture and mixer tools for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-or-later AND GPL-2.0-only"
depends="fplinux-alsa-lib"
makedepends_build="llvm22"
makedepends_host="fplinux-alsa-lib-dev pkgconf"
options="!check"
source="
	@source:aport_alsa_utils_1_2_16_tar_bz2@
	asound.conf
"
builddir="$srcdir/alsa-utils-$pkgver"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--disable-nls \
		--disable-bat \
		--disable-alsamixer \
		--disable-alsaconf \
		--disable-alsaloop \
		--disable-nhlt \
		--disable-xmlto \
		--disable-rst2man
	make -C aplay
	make -C amixer
}

package() {
	install -Dm755 "$builddir/aplay/aplay" "$pkgdir/usr/bin/aplay"
	ln -s aplay "$pkgdir/usr/bin/arecord"
	install -Dm755 "$builddir/amixer/amixer" "$pkgdir/usr/bin/amixer"
	install -Dm644 "$srcdir/asound.conf" "$pkgdir/etc/asound.conf"
}

sha512sums="
500341406360306b2cdc467982ad3491d981d977013e89987fea22c49eee14a8404a7e27ed7fa5cabaefaefb02facb49bbee372ce0c3e5f0fb06760c1cb716c9  asound.conf
"
