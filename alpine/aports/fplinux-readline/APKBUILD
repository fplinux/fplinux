# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-readline
pkgver=@version:aport_readline_8_3_tar_gz@.3
pkgrel=0
_readlinever=${pkgver%.*}
pkgdesc="GNU Readline library linked with terminfo for FPLinux"
url="https://tiswww.cwru.edu/php/chet/readline/rltop.html"
arch="armv7"
license="GPL-3.0-or-later"
provides="readline=$pkgver-r1"
provider_priority=100
replaces="readline"
makedepends_build="chrpath clang22 lld22 make llvm22"
makedepends_host="musl-dev fplinux-ncurses-dev"
subpackages="$pkgname-dev $pkgname-doc $pkgname-history:history"
options="!check"
source="
	@source:aport_readline_8_3_tar_gz@
	@source:aport_inputrc@
	@source:aport_readline83_001_patch@
	@source:aport_readline83_002_patch@
	@source:aport_readline83_003_patch@
"
patch_args="-p0"
builddir="$srcdir/readline-$_readlinever"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--disable-static \
		--enable-shared \
		--with-shared-termcap-library=-ltinfo
	make
}

package() {
	make DESTDIR="$pkgdir" install
	if ! readelf -d "$pkgdir/usr/lib/libreadline.so" | grep -q 'NEEDED.*libtinfo.so.6'; then
		error "Readline must link against the terminfo library"
		return 1
	fi
	if readelf -d "$pkgdir/usr/lib/libreadline.so" | grep -q 'NEEDED.*ncurses'; then
		error "Readline must not require the full curses library"
		return 1
	fi
	rmdir "$pkgdir/usr/bin"
	install -Dm644 "$srcdir/inputrc" "$pkgdir/etc/inputrc"
	chrpath -d "$pkgdir"/usr/lib/*.so.*
}

dev() {
	default_dev
	depends="$pkgname=$pkgver-r$pkgrel $pkgname-history=$pkgver-r$pkgrel"
	provides="readline-dev=$pkgver-r1"
	replaces="readline-dev"
}

history() {
	pkgdesc="GNU History library"
	depends=""
	provides="libhistory=$pkgver-r1"
	replaces="libhistory"
	amove usr/lib/libhistory.so.*
}
sha512sums="
"
