# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-settings
pkgver=1.0.0
pkgrel=0
pkgdesc="Phone settings and system information for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui fplinux-brand"
makedepends_build="clang23 lld23 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev dbus-dev"
options="!check"
source="
	fplinux-settings.c
	fplinux-cli.c
	fplinux-cli.h
	settings-core.c
	settings-core.h
	settings-bluetooth.c
	settings-bluetooth.h
	settings-wifi.c
	settings-wifi.h
	fplinux-settings-values.c
	fplinux-settings-values.h
	fplinux-system-info.c
	fplinux-system-info.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
	org.fplinux.settings.desktop
	fplinux-language.c
	fplinux-language.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-multitap.c
	fplinux-multitap.h
	fplinux-bluez-adapter.c
	fplinux-bluez-adapter.h
	fplinux-bluetooth-common.c
	fplinux-bluetooth-common.h
	fplinux-bluetooth-opp.c
	fplinux-bluetooth-opp.h
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -pthread \
		$(pkg-config --cflags fplinux-ui dbus-1) \
		fplinux-settings.c settings-core.c settings-bluetooth.c settings-wifi.c \
		fplinux-cli.c fplinux-ui-profile.c \
		fplinux-settings-values.c fplinux-system-info.c \
		fplinux-language.c fplinux-multitap.c fplinux-utf8.c \
		fplinux-bluez-adapter.c fplinux-bluetooth-common.c fplinux-bluetooth-opp.c \
		$(pkg-config --libs fplinux-ui dbus-1) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-settings
	# English is the source text; other languages are catalogues.
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-settings" \
		"$pkgdir/usr/bin/fplinux-settings"
	install -Dm644 "$srcdir/org.fplinux.settings.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.settings.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.settings.mo"
}

