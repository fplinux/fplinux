# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-settings
pkgver=1
pkgrel=0
pkgdesc="Phone settings and system information for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui fplinux-brand"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev"
options="!check"
source="
	fplinux-settings.c
	fplinux-cli.c
	fplinux-cli.h
	settings-core.c
	settings-core.h
	fplinux-settings-values.c
	fplinux-settings-values.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
	org.fplinux.settings.desktop
	fplinux-language.c
	fplinux-language.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-multitap.c
	fplinux-multitap.h
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		$(pkg-config --cflags fplinux-ui) \
		fplinux-settings.c settings-core.c fplinux-cli.c fplinux-ui-profile.c \
		fplinux-settings-values.c \
		fplinux-language.c fplinux-multitap.c fplinux-utf8.c \
		$(pkg-config --libs fplinux-ui) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-settings
	# English is the source text; other languages are catalogues.
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-settings" \
		"$pkgdir/usr/bin/fplinux-settings"
	install -Dm644 "$srcdir/org.fplinux.settings.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.settings.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.settings.mo"
}

