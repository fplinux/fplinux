# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-debug-tools
pkgver=@version:aport_perf_7_1_0_tar_xz@
pkgrel=0
pkgdesc="Performance, tracing and display diagnostic tools for FPLinux debug builds"
url="https://perf.wiki.kernel.org/"
arch="armv7"
license="GPL-2.0-only"
depends="strace"
makedepends_build="bison clang22 flex lld22 llvm22 make pkgconf"
makedepends_host="elfutils-dev fplinux-libdrm-dev fplinux-mesa-headers linux-headers musl-dev zlib-dev zstd-dev"
options="!check"
source="
	@source:aport_perf_7_1_0_tar_xz@
	0001-perf-record-skip-unsupported-bpf-metadata.patch
	fplinux-display-test.c
	display-test-pattern.c
	display-test-pattern.h
	display-test-gpu.c
	display-test-gpu.h
	display-test-gpu.vert
	display-test-gpu.frag
	fplinux-gpu.c
	fplinux-gpu.h
	fplinux-gpu-output.c
	fplinux-gpu-output.h
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-cli.c
	fplinux-cli.h
"
builddir="$srcdir/perf-$pkgver/tools/perf"

build() {
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	# Keep ELF symbols and stdio reports without optional language, UI or tracing libraries.
	make -f Makefile.perf -j"${JOBS:-1}" \
		ARCH=arm \
		CROSS_COMPILE="$CHOST-" \
		CC="$CC --sysroot=$CBUILDROOT" \
		CXX="$CXX --sysroot=$CBUILDROOT" \
		LD="$CHOST-ld -m armelf_linux_eabi" \
		AR=/usr/lib/llvm22/bin/llvm-ar \
		HOSTCC=cc HOSTLD=ld HOSTAR=ar \
		CLANG_CROSS_FLAGS="--target=$CHOST --sysroot=$CBUILDROOT" \
		EXTRA_CFLAGS="$CPPFLAGS $CFLAGS" \
		LDFLAGS="$LDFLAGS" \
		prefix=/usr lib=lib \
		WERROR=0 \
		BUILD_BPF_SKEL=0 \
		NO_AIO=1 \
		NO_BACKTRACE=1 \
		NO_CAPSTONE=1 \
		NO_DEMANGLE=1 \
		NO_JEVENTS=1 \
		NO_JVMTI=1 \
		NO_LIBBABELTRACE=1 \
		NO_LIBBPF=1 \
		NO_LIBDEBUGINFOD=1 \
		NO_LIBDW=1 \
		NO_LIBLLVM=1 \
		NO_LIBNUMA=1 \
		NO_LIBPFM4=1 \
		NO_LIBPYTHON=1 \
		NO_LIBTRACEEVENT=1 \
		NO_LIBUNWIND=1 \
		NO_LZMA=1 \
		NO_RUST=1 \
		NO_SDT=1 \
		NO_SHELLCHECK=1 \
		NO_SLANG=1 \
		perf

	"$CC" $CPPFLAGS $CFLAGS -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm) \
		"$srcdir/fplinux-display-test.c" \
		"$srcdir/display-test-pattern.c" \
		"$srcdir/display-test-gpu.c" \
		"$srcdir/fplinux-gpu.c" \
		"$srcdir/fplinux-gpu-output.c" \
		"$srcdir/fplinux-drm-session.c" \
		"$srcdir/fplinux-cli.c" \
		$(pkg-config --libs libdrm) -ldl $LDFLAGS -o fplinux-display-test
}

package() {
	install -Dm755 perf "$pkgdir/usr/bin/perf"
	install -Dm755 fplinux-display-test "$pkgdir/usr/bin/fplinux-display-test"
	install -Dm644 "$srcdir/display-test-gpu.vert" \
		"$pkgdir/usr/share/fplinux/display-test/display-test-gpu.vert"
	install -Dm644 "$srcdir/display-test-gpu.frag" \
		"$pkgdir/usr/share/fplinux/display-test/display-test-gpu.frag"
	install -Dm644 Documentation/tips.txt \
		"$pkgdir/usr/share/doc/perf-tip/tips.txt"
	install -Dm644 "$builddir/../../LICENSES/preferred/GPL-2.0" \
		"$pkgdir/usr/share/licenses/$pkgname/GPL-2.0"
}
