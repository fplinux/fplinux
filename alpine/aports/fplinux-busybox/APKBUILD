builddir="$srcdir/busybox-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/busyboxconfig" "$builddir/.config"
}

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	local utmps_cflags utmps_libs
	utmps_cflags=$(pkg-config --cflags --static libutmps)
	# BusyBox treats bare linker inputs as library names.
	utmps_libs="-Wl,$CBUILDROOT/usr/lib/libutmps.a -Wl,$CBUILDROOT/usr/lib/libskarnet.a"
	make CC="$CC" LD="$CC -nostdlib -Wl,--thinlto-jobs=2" AR="$AR" RANLIB="$RANLIB" HOSTCC=cc CROSS_COMPILE="$CHOST-" silentoldconfig
	make CC="$CC" LD="$CC -nostdlib -Wl,--thinlto-jobs=2" AR="$AR" RANLIB="$RANLIB" HOSTCC=cc CROSS_COMPILE="$CHOST-" \
		CONFIG_EXTRA_CFLAGS="$CPPFLAGS $CFLAGS $utmps_cflags" \
		CONFIG_EXTRA_LDFLAGS="$LDFLAGS" \
		CONFIG_EXTRA_LDLIBS="$utmps_libs" \
		SKIP_STRIP=y busybox busybox.links
}

package() {
	sh applets/install.sh "$pkgdir" --symlinks
	# These commands are owned by the network policy and transfer packages.
	rm "$pkgdir/sbin/ifup" "$pkgdir/sbin/ifdown" "$pkgdir/usr/bin/wget"
	mkdir -p "$pkgdir/etc/busybox-paths.d"
	sed 's|^/||' busybox.links > "$pkgdir/etc/busybox-paths.d/busybox"
	install -Dm644 "$srcdir/udhcpc.conf" "$pkgdir/etc/udhcpc/udhcpc.conf"
	install -Dm644 "$srcdir/securetty" "$pkgdir/etc/securetty"
	install -Dm755 "$srcdir/default.script" \
		"$pkgdir/usr/share/udhcpc/default.script"
	mkdir -p "$pkgdir/var/lib/udhcpd"
	local hook
	for hook in if-down.d if-post-down.d if-post-up.d if-pre-down.d if-pre-up.d if-up.d; do
		mkdir -p "$pkgdir/etc/network/$hook"
	done
	install -Dm775 "$srcdir/dad.if-up" "$pkgdir/etc/network/if-up.d/dad"
	install -Dm644 "$srcdir/utmps-COPYING" \
		"$pkgdir/usr/share/licenses/$pkgname/utmps-COPYING"
	install -Dm644 "$srcdir/skalibs-COPYING" \
		"$pkgdir/usr/share/licenses/$pkgname/skalibs-COPYING"
}
sha512sums="
