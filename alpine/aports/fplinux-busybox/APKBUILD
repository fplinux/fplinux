pkgname=fplinux-busybox
pkgver=@version:aport_busybox_1_37_0_tar_bz2@
pkgrel=0
pkgdesc="BusyBox toolbox with DHCP server for FPLinux"
url="https://busybox.net/"
arch="armv7"
license="GPL-2.0-only AND ISC"
provides="busybox=$pkgver-r31 busybox-binsh=$pkgver-r31 /bin/sh"
provider_priority=100
replaces="busybox busybox-binsh busybox-initscripts"
makedepends_build="clang22 lld22 make perl llvm22"
makedepends_host="musl-dev linux-headers utmps-dev utmps-static skalibs-static"
options="!check"
source="
	@source:aport_busybox_1_37_0_tar_bz2@
	@source:aport_0001_wget_add_header_accept_patch@
	@source:aport_0002_adduser_default_to_sbin_nologin_as_shell_for_system_patch@
	@source:aport_0003_ash_add_built_in_bb_ash_version_variable_patch@
	@source:busybox_utmps_patch@
	@source:aport_0005_libbb_sockaddr2str_ensure_only_printable_characters_patch@
