# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-bluez
pkgver=5.86
pkgrel=0
pkgdesc="Bluetooth profiles and object-push transfers for FPLinux"
url="https://www.bluez.org/"
arch="armv7"
license="GPL-2.0-or-later AND BSD-2-Clause AND MIT"
depends="dbus fplinux-bluez-glib"
provides="bluez=$pkgver-r$pkgrel bluez-obexd=$pkgver-r$pkgrel bluez-openrc=$pkgver-r$pkgrel obexd"
replaces="bluez bluez-obexd bluez-openrc"
makedepends_build="autoconf automake clang22 libtool lld22 pkgconf llvm22"
makedepends_host="dbus-dev fplinux-bluez-glib-dev linux-headers musl-dev readline-dev"
options="!check"
source="https://www.kernel.org/pub/linux/bluetooth/bluez-$pkgver.tar.xz
	bluetooth.initd
	org.bluez.obex.service
	modules-load.conf
	005-hostname-Use-phone-class-for-handhelds.patch
	006-Revert-shared-shell-Don-t-init-input-for-non-interac.patch
	007-a2dp-connect-source-profile-after-sink.patch
	fix-endianness.patch
	0001-obex-object-push-only.patch
	0002-use-private-glib.patch
	0003-object-push-filesystem.patch
"
builddir="$srcdir/bluez-$pkgver"

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	CFLAGS="$CFLAGS -mthumb -ffunction-sections -fdata-sections" \
	LDFLAGS="$LDFLAGS -Wl,--gc-sections" \
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libexecdir=/usr/lib \
		--with-dbusconfdir=/usr/share \
		--with-zsh-completion-dir=no \
		--enable-client \
		--enable-obex \
		--enable-network \
		--enable-hid \
		--enable-hog \
		--enable-a2dp \
		--enable-avrcp \
		--enable-hfp \
		--enable-datafiles \
		--disable-tools \
		--disable-monitor \
		--disable-mesh \
		--disable-sixaxis \
		--disable-udev \
		--disable-cups \
		--disable-hid2hci \
		--disable-deprecated \
		--disable-library \
		--disable-manpages \
		--disable-systemd \
		--disable-test \
		--disable-testing \
		--disable-experimental \
		--disable-nfc \
		--disable-midi \
		--disable-btpclient \
		--disable-logger \
		--disable-admin \
		--disable-backtrace \
		--disable-external-plugins
	make src/builtin.h obexd/src/builtin.h
	make src/bluetoothd client/bluetoothctl obexd/src/obexd
}

package() {
	install -Dm755 "$builddir/src/bluetoothd" \
		"$pkgdir/usr/lib/bluetooth/bluetoothd"
	install -Dm755 "$builddir/client/bluetoothctl" \
		"$pkgdir/usr/bin/bluetoothctl"
	install -Dm755 "$builddir/obexd/src/obexd" \
		"$pkgdir/usr/lib/bluetooth/obexd"
	install -Dm644 "$builddir/src/main.conf" \
		"$pkgdir/etc/bluetooth/main.conf"
	install -Dm644 "$builddir/profiles/input/input.conf" \
		"$pkgdir/etc/bluetooth/input.conf"
	install -Dm644 "$builddir/profiles/network/network.conf" \
		"$pkgdir/etc/bluetooth/network.conf"
	install -Dm644 "$builddir/src/bluetooth.conf" \
		"$pkgdir/usr/share/dbus-1/system.d/bluetooth.conf"
	install -Dm644 "$builddir/obexd/src/obex.conf" \
		"$pkgdir/usr/share/dbus-1/system.d/obex.conf"
	install -Dm644 "$builddir/src/org.bluez.service" \
		"$pkgdir/usr/share/dbus-1/system-services/org.bluez.service"
	install -Dm644 "$srcdir/org.bluez.obex.service" \
		"$pkgdir/usr/share/dbus-1/services/org.bluez.obex.service"
	install -Dm755 "$srcdir/bluetooth.initd" \
		"$pkgdir/etc/init.d/bluetooth"
	install -Dm644 "$srcdir/modules-load.conf" \
		"$pkgdir/usr/lib/modules-load.d/bluez.conf"
	install -dm700 "$pkgdir/var/lib/bluetooth"
}
