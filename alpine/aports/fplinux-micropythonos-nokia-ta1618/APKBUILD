# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-micropythonos-nokia-ta1618
pkgver=1
pkgrel=0
pkgdesc="Nokia TA-1618 configuration for FPLinux MicroPythonOS"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="MIT"
depends="fplinux-micropythonos"
options="!check"
source="
	micropythonos.conf
"

package() {
	install -Dm644 "$srcdir/micropythonos.conf" \
		"$pkgdir/etc/fplinux/micropythonos.conf"
}

