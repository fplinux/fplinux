msgid "Music"
msgstr "Музыка"

msgid "Left/Right: track · hold: seek"
msgstr "Влево/вправо: трек · удержание: перемотка"

msgid "Left/Right: track · hold: seek\nUp/Down: volume"
msgstr "Влево/вправо: трек · удержание: перемотка\nВверх/вниз: громкость"

#, c-format
msgid "Volume %u/%u"
msgstr "Громкость %u/%u"

#, c-format
msgid "Vol %u/%u"
msgstr "Гр. %u/%u"

msgid "Volume unavailable"
msgstr "Громкость недоступна"

msgid "Vol n/a"
msgstr "Гр. нед."

msgid "Volume --"
msgstr "Громкость --"

msgid "Vol --"
msgstr "Гр. --"

msgid "Choose your music"
msgstr "Выберите музыку"

msgid "Open a file or folder in Options"
msgstr "Откройте файл или папку через «Функции»"

msgid "Memory card removed. Connect it and open the track again."
msgstr "Карта памяти извлечена. Подключите её и откройте трек снова."

msgid "File is unavailable. Open the file or folder again."
msgstr "Файл недоступен. Откройте файл или папку снова."

msgid "This folder contains no MP3 or WAV files."
msgstr "В этой папке нет файлов MP3 или WAV."

msgid "This audio format is not supported."
msgstr "Этот звуковой формат не поддерживается."

msgid "Permission to read this file was denied."
msgstr "Нет разрешения на чтение этого файла."

msgid "The file is busy. Try again after the other operation finishes."
msgstr "Файл занят. Дождитесь завершения другой операции и повторите попытку."

msgid "Could not read this audio file. Open another file or try again."
msgstr "Не удалось прочитать звуковой файл. Откройте другой файл или повторите попытку."

msgid "Opening music"
msgstr "Открытие музыки"

msgid "Open folder"
msgstr "Открыть папку"

msgid "Open file"
msgstr "Открыть файл"

msgid "Play folder"
msgstr "Играть папку"

msgid "Current track"
msgstr "Текущий трек"

msgid "Queue"
msgstr "Очередь"

msgid "Play"
msgstr "Играть"

msgid "Details"
msgstr "Сведения"

msgid "File"
msgstr "Файл"

msgid "No file selected"
msgstr "Файл не выбран"

msgid "Title"
msgstr "Название"

msgid "Artist"
msgstr "Исполнитель"

msgid "Album"
msgstr "Альбом"

msgid "Mono"
msgstr "Моно"

msgid "Stereo"
msgstr "Стерео"

msgid "Format"
msgstr "Формат"

msgid "Status"
msgstr "Состояние"

msgid "Sound is unavailable"
msgstr "Звук недоступен"

msgid "File unavailable"
msgstr "Файл недоступен"

msgid "Opening…"
msgstr "Открытие…"

msgid "Seeking…"
msgstr "Перемотка…"

msgid "Stopped"
msgstr "Остановлено"

msgid "Finished"
msgstr "Завершено"

msgid "Paused"
msgstr "Пауза"

msgid "Waiting for audio output"
msgstr "Ожидание звука"

msgid "Audio output unavailable"
msgstr "Звук недоступен"

msgid "Starting…"
msgstr "Запуск…"

msgid "Resuming…"
msgstr "Возобновление…"

msgid "Waiting for FM radio"
msgstr "Ожидание FM-радио"

msgid "Paused for alarm"
msgstr "Пауза: будильник"

msgid "Playback paused by system"
msgstr "Системная пауза"

msgid "Playing"
msgstr "Воспроизведение"

msgid "Open"
msgstr "Открыть"

msgid "Pause"
msgstr "Пауза"

msgid "Repeat: track"
msgstr "Повтор: трек"

msgid "Repeat: queue"
msgstr "Повтор: очередь"

msgid "Repeat: off"
msgstr "Повтор: выкл."

msgid "Settings not saved"
msgstr "Настройки не сохранены"

msgid "Settings could not be loaded"
msgstr "Не удалось загрузить настройки"

msgid "Stop"
msgstr "Стоп"
