# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-music
pkgver=1.0.0
pkgrel=0
pkgdesc="Local MP3 and WAV music player for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui fplinux-media"
makedepends_build="clang23 lld23 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev fplinux-media-dev"
options="!check"
source="
	fplinux-music.c
	music-player.c
	music-player.h
	music-model.c
	music-model.h
	music-view.c
	music-view.h
	fplinux-cli.c
	fplinux-cli.h
	org.fplinux.music.desktop
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -pthread \
		$(pkg-config --cflags fplinux-ui fplinux-media) \
		fplinux-music.c music-player.c music-model.c music-view.c fplinux-cli.c \
		$(pkg-config --libs fplinux-ui fplinux-media) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-music
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 fplinux-music "$pkgdir/usr/bin/fplinux-music"
	install -Dm644 org.fplinux.music.desktop \
		"$pkgdir/usr/share/applications/org.fplinux.music.desktop"
	install -Dm644 ru.mo "$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.music.mo"
}

