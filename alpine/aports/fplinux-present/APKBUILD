# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-present
pkgver=1
pkgrel=0
pkgdesc="Native UMS9117 framebuffer presentation tool for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev linux-headers"
options="!check"
source="
	fplinux-present.c
	fplinux-fb-session.c
	fplinux-fb-session.h
	fplinux-cli.c
	fplinux-cli.h
	ums9117-present.h
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -O2 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" \
		"$srcdir/fplinux-present.c" \
		"$srcdir/fplinux-fb-session.c" \
		"$srcdir/fplinux-cli.c" $LDFLAGS -Wl,--gc-sections -o fplinux-present
}

package() {
	install -Dm755 "$builddir/fplinux-present" \
		"$pkgdir/usr/bin/fplinux-present"
}

