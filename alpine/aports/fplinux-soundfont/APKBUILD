# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-soundfont
pkgver=@version:aport_timgm6mb_1_3_tar_gz@
pkgrel=0
pkgdesc="Compact General MIDI SoundFont for FPLinux media applications"
url="https://musescore.org"
arch="noarch"
license="GPL-2.0-only"
options="!check"
source="
	@source:aport_timgm6mb_1_3_tar_gz@
	COPYRIGHT
	GPL-2.0-only.txt
"
builddir="$srcdir/timgm6mb-soundfont_$pkgver"

package() {
	install -Dm644 TimGM6mb.sf2 "$pkgdir/usr/share/fplinux/soundfonts/TimGM6mb.sf2"
	install -Dm644 "$srcdir/COPYRIGHT" "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
	install -Dm644 "$srcdir/GPL-2.0-only.txt" "$pkgdir/usr/share/licenses/$pkgname/GPL-2.0.txt"
}

