# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-calculator
pkgver=1
pkgrel=0
pkgdesc="Keypad calculator for the FPLinux graphical session"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev"
options="!check"
source="
	fplinux-calculator.c
	calculator.c
	calculator.h
	fplinux-cli.c
	fplinux-cli.h
	org.fplinux.calculator.desktop
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		$(pkg-config --cflags fplinux-ui) \
		fplinux-calculator.c calculator.c fplinux-cli.c \
		$(pkg-config --libs fplinux-ui) -lm $LDFLAGS \
		-Wl,--gc-sections -o fplinux-calculator
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-calculator" \
		"$pkgdir/usr/bin/fplinux-calculator"
	install -Dm644 "$srcdir/org.fplinux.calculator.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.calculator.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.calculator.mo"
}

