# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-xkb-ru
pkgver=2.47
pkgrel=0
pkgdesc="Russian keyboard layout data for FPLinux applications"
url="https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config"
arch="noarch"
license="HPND AND HPND-sell-variant AND X11 AND X11-distribute-modifications-variant AND MIT AND MIT-open-group AND xkeyboard-config-Zinoviev"
depends="fplinux-xkb"
options="!check"
source="https://www.x.org/releases/individual/data/xkeyboard-config/xkeyboard-config-$pkgver.tar.xz"
builddir="$srcdir/xkeyboard-config-$pkgver"

package() {
	install -Dm644 "$builddir/symbols/ru" \
		"$pkgdir/usr/share/fplinux/xkb/symbols/ru"
	# The empty registration file adds "ru" to the optional layout groups.
	mkdir -p "$pkgdir/usr/share/fplinux/xkb/layouts"
	touch "$pkgdir/usr/share/fplinux/xkb/layouts/ru"
	install -Dm644 "$builddir/COPYING" \
		"$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
sha512sums="
bd9b70ec5c8957e087f6c12272725044e6e124c15c7cbbfffb7f3c231944984d3302adda604da05464b7be6c91b5461e74fbec8544ac21b06e3bd8c748fd04e3  xkeyboard-config-2.47.tar.xz
"
