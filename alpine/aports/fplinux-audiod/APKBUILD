# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-audiod
pkgver=1
pkgrel=0
pkgdesc="System audio service for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-alsa-lib fplinux-base"
makedepends_build="clang22 lld22"
makedepends_host="fplinux-alsa-lib-dev musl-dev"
subpackages="$pkgname-openrc"
options="!check"
source="
	audiod.c
	audio-device.c
	audio-device.h
	audio-mixer.c
	audio-mixer.h
	audio-streams.c
	audio-streams.h
	fplinux-audio-protocol.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-audiod.initd
	fplinux-audiod.confd
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -I"$srcdir" \
		"$srcdir/audiod.c" "$srcdir/audio-device.c" \
		"$srcdir/audio-mixer.c" "$srcdir/audio-streams.c" \
		"$srcdir/fplinux-cli.c" \
		$LDFLAGS -Wl,--gc-sections -lasound -o audiod
}

package() {
	install -Dm755 "$builddir/audiod" "$pkgdir/usr/libexec/fplinux/audiod"
	install -Dm755 "$srcdir/fplinux-audiod.initd" \
		"$pkgdir/etc/init.d/fplinux-audiod"
	install -Dm644 "$srcdir/fplinux-audiod.confd" \
		"$pkgdir/etc/conf.d/fplinux-audiod"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-audiod \
		"$pkgdir/etc/runlevels/default/fplinux-audiod"
}
