# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-runtime-media
pkgver=1
pkgrel=0
pkgdesc="Bounded guest media playback for FPLinux runtimes"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="LGPL-2.1-or-later"
depends="fplinux-ui fplinux-media fplinux-midi"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev fplinux-ui-dev fplinux-media-dev fplinux-midi-dev"
subpackages="$pkgname-dev"
options="!check"
source="
	fplinux-runtime-media.c
	fplinux-runtime-media.h
	fplinux-runtime-media.pc
	fplinux-runtime-media.map
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		$(pkg-config --cflags fplinux-ui fplinux-media fplinux-midi) \
		-I. -shared fplinux-runtime-media.c \
		$(pkg-config --libs fplinux-ui fplinux-media fplinux-midi) -pthread \
		$LDFLAGS -Wl,-soname,libfplinux-runtime-media.so.1 \
		-Wl,--version-script=fplinux-runtime-media.map \
		-o libfplinux-runtime-media.so.1
}

package() {
	install -Dm755 libfplinux-runtime-media.so.1 \
		"$pkgdir/usr/lib/libfplinux-runtime-media.so.1"
	ln -s libfplinux-runtime-media.so.1 "$pkgdir/usr/lib/libfplinux-runtime-media.so"
	install -Dm644 fplinux-runtime-media.h \
		"$pkgdir/usr/include/fplinux/fplinux-runtime-media.h"
	install -Dm644 fplinux-runtime-media.pc \
		"$pkgdir/usr/lib/pkgconfig/fplinux-runtime-media.pc"
}

