#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

fail() {
	printf '%s\n' "$*" >&2
	exit 1
}

read_ext4_mount() {
	record=$(awk -v target="$1" '
		$5 == target {
			if (seen++) exit 1
			for (i = 7; i <= NF - 3; i++) {
				if ($i != "-") continue
				if ($(i + 1) != "ext4") exit 1
				print $3, $4, $6, $(i + 3)
				break
			}
		}
	' /proc/self/mountinfo) || return
	[ -n "$record" ] || return 1
	IFS=' ' read -r device fs_root mount_options super_options <<-EOF
		$record
	EOF
}

find_card_mount() {
	card_profile=$(awk '
		/^FPLINUX_SYSTEM_CARD_PROFILE=/ {
			if (seen++) exit 1
			print
		}
	' /etc/os-release) || fail "Cannot read the system-card profile"
	mountpoint=/
	read_ext4_mount "$mountpoint" || fail "Cannot identify the system-card root mount"
	root_options=$mount_options
	case "$card_profile:$fs_root" in
	:/system/[ab]/root | FPLINUX_SYSTEM_CARD_PROFILE=microsd-uboot:/system/[ab]/root)
		# Existing slot roots without a profile still need matching mount evidence.
		root_device=$device
		mountpoint=/run/fplinux-card
		read_ext4_mount "$mountpoint" && [ "$fs_root" = / ] && [ "$device" = "$root_device" ] ||
			fail "The backing system-card mount does not match the running slot"
		;;
	FPLINUX_SYSTEM_CARD_PROFILE=microsd-root:/)
		awk '$5 == "/run/fplinux-card" { exit 1 }' /proc/self/mountinfo ||
			fail "The mounted system-card backing path conflicts with a direct root"
		;;
	*)
		fail "The system-card profile does not match the running root"
		;;
	esac
}

resolve_partition() {
	# Resolve the kernel device number even when mountinfo calls the source /dev/root.
	partition=$(awk -F= '$1 == "DEVNAME" { print $2 }' "/sys/dev/block/$device/uevent") ||
		fail "Cannot resolve the mounted system-card partition"
	case "$partition" in
	mmcblk*p2) disk=${partition%p2} ;;
	*) fail "The mounted system-card filesystem is not on an SD partition 2" ;;
	esac
	case "${disk#mmcblk}" in
	"" | *[!0-9]*) fail "The mounted system-card filesystem is not on an SD partition 2" ;;
	esac
	[ "$(cat "/sys/class/block/$disk/device/type")" = SD ] ||
		fail "The mounted system-card partition is not on a removable SD card"
}

card_mount_is_readonly() {
	case ",$super_options," in
	*,ro,*) return 0 ;;
	esac
	return 1
}

confirm_card_readonly() {
	# A read-only bind mount leaves the ext4 superblock writable.
	card_device=$device
	read_ext4_mount "$mountpoint" && [ "$device" = "$card_device" ] && [ "$fs_root" = / ] ||
		fail "Cannot verify the backing system-card mount after remounting"
	card_mount_is_readonly || fail "The backing system-card filesystem is still writable"
}

remount_card_readonly() {
	mount -o remount,ro "/dev/$partition" "$mountpoint" || return
	confirm_card_readonly
}

check_card_storage() {
	# Compare device numbers so a mounted partition cannot be hidden by a /dev alias.
	shared_mounts=$(awk -v disk="$disk" -v root_device="$device" -v mode="$1" '
		FNR == NR {
			if ($4 == disk || $4 ~ ("^" disk "p[0-9]+$")) parts[$1 ":" $2] = $4
			next
		}
		FNR == 1 { mountinfo = 1 }
		$5 == "/mnt/card" { bind_paths++ }
		$5 == "/run/fplinux-shared-card/fat" { fat_paths++ }
		($3 in parts) && $3 != root_device {
			if (mode == "shared" && parts[$3] == disk "p1") {
				options = "," $6 ","
				for (i = 7; i <= NF - 3; i++) {
					if ($i != "-") continue
					if ($(i + 1) != "vfat" ||
					    options !~ /,nodev,/ || options !~ /,nosuid,/ ||
					    options !~ /,noexec,/) break
					if ($5 == "/run/fplinux-shared-card/fat" && $4 == "/") {
						fat_source = $(i + 2)
						fat_id = $1
					} else if ($5 == "/mnt/card" && tolower($4) == "/shared") {
						bind_source = $(i + 2)
						bind_id = $1
					}
					break
				}
				if (fat_id == $1 || bind_id == $1) next
			}
			print "Unmount the system card filesystem at " $5 " before shutdown" > "/dev/stderr"
			busy = 1
		}
		END {
			if (!mountinfo || !(root_device in parts)) {
				print "Cannot verify which system card partitions are mounted" > "/dev/stderr"
				exit 1
			}
			if ((fat_id && fat_paths != 1) ||
			    (bind_id && (bind_paths != 1 || !fat_id ||
					bind_id == fat_id || bind_source != fat_source))) {
				print "Cannot verify the shared system-card mounts" > "/dev/stderr"
				exit 1
			}
			if (!busy) print (bind_id != ""), (fat_id != "")
			exit busy
		}
	' /proc/partitions /proc/self/mountinfo) || exit 1
	IFS=' ' read -r shared_bind shared_fat <<-EOF
		$shared_mounts
	EOF
	# The standard zram swap has no backing filesystem. A swapfile can use any card alias.
	awk '
		NR == 1 && $1 == "Filename" { header = 1; next }
		$1 == "/dev/zram0" && $2 == "partition" { next }
		{ print "Disable disk-backed swap " $1 " before shutdown"; busy = 1 }
		END {
			if (!header) {
				print "Cannot verify active swap"
				exit 1
			}
			exit busy
		}
	' /proc/swaps >&2 || exit 1
}

unmount_shared_storage() {
	if [ "$shared_bind" = 1 ]; then
		umount /mnt/card || fail "Cannot disconnect shared files"
	fi
	if [ "$shared_fat" = 1 ]; then
		umount /run/fplinux-shared-card/fat || fail "Cannot unmount the shared system-card partition"
	fi
	check_card_storage inactive
}

case "$#:${1-}" in
0: | 1:shutdown | 1:prepare-poweroff | 1:poweroff) ;;
*) fail "Usage: microsd-grow [shutdown|prepare-poweroff|poweroff]" ;;
esac

find_card_mount
resolve_partition
case "${1-}" in
shutdown)
	check_card_storage shared
	# OpenRC already handles a directly mounted ext4 root.
	if [ "$shared_fat" = 0 ] && { [ "$mountpoint" = / ] || card_mount_is_readonly; }; then
		exit 0
	fi
	sync || exit $?
	unmount_shared_storage
	if [ "$mountpoint" = / ] || card_mount_is_readonly; then
		exit 0
	fi
	remount_card_readonly
	exit $?
	;;
prepare-poweroff)
	check_card_storage shared
	rc-service fplinux-session stop >&2 || fail "Cannot stop the graphical session"
	check_card_storage shared
	sync || fail "Cannot synchronize the system card"
	unmount_shared_storage
	if card_mount_is_readonly; then
		confirm_card_readonly
	else
		remount_card_readonly || fail "Cannot remount the system card read-only"
	fi
	printf 'readonly %s\n' "$mountpoint"
	exit 0
	;;
poweroff)
	check_card_storage inactive
	confirm_card_readonly
	exec poweroff
	;;
esac

case ",$root_options,$mount_options,$super_options," in
*,ro,*)
	printf '%s\n' "Skipping growth of the read-only system-card filesystem"
	exit 0
	;;
esac

status=0
growpart --update=on "/dev/$disk" 2 || status=$?
case $status in
0 | 1)
	exec resize2fs "/dev/$partition"
	;;
*)
	exit "$status"
	;;
esac
