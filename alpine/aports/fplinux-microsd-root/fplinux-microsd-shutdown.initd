#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

description="Finalize the FPLinux microSD backing filesystem"

depend() {
	after killprocs savecache
	before mount-ro
}

start() {
	ebegin "Finalizing the system-card filesystem"
	/usr/libexec/fplinux/microsd-grow shutdown
	eend $?
}
