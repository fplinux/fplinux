# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-microsd-root
pkgver=1
pkgrel=0
pkgdesc="Persistent microSD root filesystem support for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
depends="cloud-utils-growpart fplinux-resize2fs openrc"
options="!check"
source="
	card-slots.sh
	fplinux-card-boot
	fplinux-card-confirm.initd
	fplinux-microsd-grow
	fplinux-microsd-grow.initd
	fplinux-microsd-shutdown.initd
	fplinux-microsd-root.conf
"

package() {
	install -Dm755 "$srcdir/card-slots.sh" \
		"$pkgdir/usr/libexec/fplinux/card-slots.sh"
	install -Dm755 "$srcdir/fplinux-card-boot" \
		"$pkgdir/usr/libexec/fplinux/card-boot"
	install -Dm755 "$srcdir/fplinux-card-confirm.initd" \
		"$pkgdir/etc/init.d/fplinux-card-confirm"
	install -Dm755 "$srcdir/fplinux-microsd-grow" \
		"$pkgdir/usr/libexec/fplinux/microsd-grow"
	install -Dm755 "$srcdir/fplinux-microsd-grow.initd" \
		"$pkgdir/etc/init.d/fplinux-microsd-grow"
	install -Dm755 "$srcdir/fplinux-microsd-shutdown.initd" \
		"$pkgdir/etc/init.d/fplinux-microsd-shutdown"
	install -Dm644 "$srcdir/fplinux-microsd-root.conf" \
		"$pkgdir/etc/rc.conf.d/fplinux-microsd-root.conf"
	mkdir -p "$pkgdir/etc/runlevels/boot" "$pkgdir/etc/runlevels/default" \
		"$pkgdir/etc/runlevels/shutdown"
	ln -s /etc/init.d/fplinux-card-confirm \
		"$pkgdir/etc/runlevels/default/fplinux-card-confirm"
	ln -s /etc/init.d/fplinux-microsd-grow \
		"$pkgdir/etc/runlevels/boot/fplinux-microsd-grow"
	for service in killprocs savecache fplinux-microsd-shutdown mount-ro; do
		ln -s "/etc/init.d/$service" \
			"$pkgdir/etc/runlevels/shutdown/$service"
	done
}

