# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-microsd-root
pkgver=1
pkgrel=0
pkgdesc="Persistent microSD root filesystem support for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
depends="cloud-utils-growpart e2fsprogs-extra openrc"
options="!check"
source="fplinux-microsd-grow fplinux-microsd-grow.initd"

package() {
	install -Dm755 "$srcdir/fplinux-microsd-grow" \
		"$pkgdir/usr/libexec/fplinux/microsd-grow"
	install -Dm755 "$srcdir/fplinux-microsd-grow.initd" \
		"$pkgdir/etc/init.d/fplinux-microsd-grow"
	mkdir -p "$pkgdir/etc/runlevels/boot" "$pkgdir/etc/runlevels/shutdown"
	ln -s /etc/init.d/fplinux-microsd-grow \
		"$pkgdir/etc/runlevels/boot/fplinux-microsd-grow"
	for service in killprocs savecache mount-ro; do
		ln -s "/etc/init.d/$service" \
			"$pkgdir/etc/runlevels/shutdown/$service"
	done
}

