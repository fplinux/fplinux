# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-brightness-ui
pkgver=1
pkgrel=0
pkgdesc="Keypad control for the phone LCD level"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-base fplinux-input fplinux-font-terminus-data"
makedepends_build="clang22 lld22 pkgconf llvm22"
makedepends_host="musl-dev linux-headers fplinux-libdrm-dev libevdev-dev eudev-dev"
options="!check"
source="
	fplinux-brightness-ui.c
	brightness-ui.c
	brightness-ui.h
	fplinux-brightness-client.c
	fplinux-brightness-client.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-font.c
	fplinux-font.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-input-session.c
	fplinux-input-session.h
	fplinux-input-device.h
	fplinux-keypad.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
	fplinux-ui-session.h
	fplinux-ui-document.h
	fplinux-volumes.h
	fplinux-ui-vibration.h
	fplinux-storage.h
"
builddir="$srcdir"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"

	"$CC" $CPPFLAGS $CFLAGS -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm libevdev) \
		"$srcdir/fplinux-brightness-ui.c" \
		"$srcdir/brightness-ui.c" \
		"$srcdir/fplinux-brightness-client.c" \
		"$srcdir/fplinux-cli.c" \
		"$srcdir/fplinux-font.c" \
		"$srcdir/fplinux-utf8.c" \
		"$srcdir/fplinux-drm-session.c" \
		"$srcdir/fplinux-input-session.c" \
		"$srcdir/fplinux-ui-profile.c" \
		$(pkg-config --libs libdrm libevdev) -ludev \
		$LDFLAGS -Wl,--gc-sections -o fplinux-brightness-ui
}

package() {
	install -Dm755 "$builddir/fplinux-brightness-ui" \
		"$pkgdir/usr/bin/fplinux-brightness-ui"
}

