# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-media
pkgver=1
pkgrel=0
pkgdesc="Shared bounded media decoders for FPLinux applications"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only AND LGPL-2.1-or-later"
depends="fplinux-amr-nb fplinux-mpg123"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev fplinux-amr-nb-dev fplinux-mpg123-dev"
subpackages="$pkgname-dev"
options="!check"
source="
	fplinux-media.c
	fplinux-media.h
	fplinux-media-amr-nb.c
	fplinux-media-amr-nb.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-media.pc
	fplinux-media.map
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		$(pkg-config --cflags libmpg123 libavcodec-fplinux-amr libavutil-fplinux-amr) \
		-I. -shared fplinux-media.c fplinux-media-amr-nb.c fplinux-utf8.c \
		$(pkg-config --libs libmpg123 libavcodec-fplinux-amr libavutil-fplinux-amr) \
		-lm $LDFLAGS \
		-Wl,-soname,libfplinux-media.so.1 -Wl,--version-script=fplinux-media.map \
		-o libfplinux-media.so.1
}

package() {
	install -Dm755 libfplinux-media.so.1 "$pkgdir/usr/lib/libfplinux-media.so.1"
	ln -s libfplinux-media.so.1 "$pkgdir/usr/lib/libfplinux-media.so"
	install -Dm644 fplinux-media.h "$pkgdir/usr/include/fplinux/fplinux-media.h"
	install -Dm644 fplinux-media.pc "$pkgdir/usr/lib/pkgconfig/fplinux-media.pc"
}

