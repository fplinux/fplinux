# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-lvgl
pkgver=9.6.0
pkgrel=0
pkgdesc="RGB565 LVGL runtime for FPLinux applications"
url="https://lvgl.io"
arch="armv7"
license="MIT AND GPL-2.0-only AND Zlib AND OFL-1.1"
makedepends_build="clang22 lld22 cmake samurai pkgconf"
makedepends_host="musl-dev linux-headers gcc"
subpackages="$pkgname-dev"
options="!check"
source="
	lvgl-$pkgver.tar.gz::https://github.com/lvgl/lvgl/archive/refs/tags/v$pkgver.tar.gz
	lv_conf.h
	shared-abi.patch
	canvas-cache-drop.patch
	LICENSE
"
builddir="$srcdir/lvgl-$pkgver"

# -ffile-prefix-map keeps the build directory out of the file names in LVGL's
# log messages. -Bsymbolic-functions binds LVGL's calls to its own functions
# without the PLT, so applications cannot replace an LVGL function.
build() {
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	SYSROOT="$CBUILDROOT" cmake -S . -B output -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX" \
		-DCMAKE_ASM_COMPILER="$CC" \
		-DCMAKE_ASM_FLAGS="--target=$CHOST --sysroot=$CBUILDROOT $CFLAGS" \
		-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=armv7 \
		-DCMAKE_SYSROOT="$CBUILDROOT" \
		-DCMAKE_C_FLAGS="$CFLAGS -ffile-prefix-map=$builddir=lvgl-$pkgver" \
		-DCMAKE_CXX_FLAGS="$CXXFLAGS -nostdlib++" \
		-DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
		-DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS -Wl,-Bsymbolic-functions" \
		-DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
		-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY \
		-DBUILD_SHARED_LIBS=ON \
		-DLV_BUILD_CONF_PATH="$srcdir/lv_conf.h" \
		-DLV_BUILD_SET_CONFIG_OPTS=ON \
		-DLV_BUILD_LVGL_H_SYSTEM_INCLUDE=ON \
		-DLV_FETCH_DEPENDENCIES=OFF -DLV_USE_FIND_PACKAGE=OFF \
		-DCONFIG_LV_BUILD_DEMOS=OFF -DCONFIG_LV_BUILD_EXAMPLES=OFF \
		-DCONFIG_LV_USE_SNAPSHOT=ON \
		-DCONFIG_LV_USE_THORVG=OFF -DCONFIG_LV_USE_THORVG_INTERNAL=OFF
	cmake --build output
}

package() {
	DESTDIR="$pkgdir" cmake --install output
	rm -f "$pkgdir/usr/include/lvgl/config/lv_conf.h"
	install -Dm644 "$srcdir/lv_conf.h" \
		"$pkgdir/usr/include/lvgl/config/lv_conf.h"
	install -Dm644 src/libs/lodepng/lodepng.h \
		"$pkgdir/usr/include/lvgl/src/libs/lodepng/lodepng.h"
	install -Dm644 LICENCE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENCE.txt"
	install -Dm644 "$srcdir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/FPLinux-GPL-2.0.txt"
	# COPYRIGHTS.md lists the bundled third-party code. The texts of the
	# licences that must travel with it are installed next to it: OFL-1.1 for
	# the built-in fonts (Montserrat, Font Awesome) and Zlib for LodePNG.
	install -Dm644 COPYRIGHTS.md \
		"$pkgdir/usr/share/licenses/$pkgname/COPYRIGHTS.md"
	_fontlic=scripts/generators/built_in_font/font_license
	install -Dm644 "$_fontlic/Montserrat/OFL.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/Montserrat-OFL.txt"
	install -Dm644 "$_fontlic/FontAwesome5/LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/FontAwesome5-LICENSE.txt"
	# LodePNG carries its licence as the comment at the top of lodepng.h.
	sed -n '2,/^\*\//{/^\*\//!p}' src/libs/lodepng/lodepng.h \
		>"$pkgdir/usr/share/licenses/$pkgname/LodePNG-LICENSE.txt"
	chmod 644 "$pkgdir/usr/share/licenses/$pkgname/LodePNG-LICENSE.txt"
}

