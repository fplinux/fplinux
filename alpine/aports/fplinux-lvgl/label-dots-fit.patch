+/**
+ * Get where the dots begin on the last visible line: after the longest part of
+ * the line, without trailing spaces, that fits `max_width` with the dots
+ * @param line          the text from the start of the last visible line
+ * @param max_width     the width of the line
+ * @param font          the font of the text
+ * @param attributes    the letter space and flags of the text
+ * @return              the byte offset in `line`, or LV_LABEL_DOT_BEGIN_INV
+ */
+static uint32_t get_dot_begin(const char * line, int32_t max_width, const lv_font_t * font,
+                              const lv_text_attributes_t * attributes)
+{
+    uint32_t length = 0;
+    while(line[length] != '\0' && line[length] != '\n') length++;
+
+    char * candidate = lv_malloc(length + LV_LABEL_DOT_NUM + 1);
+    LV_ASSERT_MALLOC(candidate);
+    if(candidate == NULL) return LV_LABEL_DOT_BEGIN_INV;
+
+    uint32_t end = length;
+    while(end > 0) {
+        lv_text_encoded_prev(line, &end);
+        uint32_t kept = end;
+        while(kept > 0 && line[kept - 1] == ' ') kept--;
+        lv_memcpy(candidate, line, kept);
+        lv_memset(&candidate[kept], '.', LV_LABEL_DOT_NUM);
+        candidate[kept + LV_LABEL_DOT_NUM] = '\0';
+        if(lv_text_get_width(candidate, kept + LV_LABEL_DOT_NUM, font, attributes) <= max_width) {
+            end = kept;
+            break;
         }
-        label->text[dot_begin + i] = '\0';
     }
+    lv_free(candidate);
+    return end;
 }
 
