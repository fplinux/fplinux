# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-qin1splus-config
pkgver=1
pkgrel=0
pkgdesc="Board configuration for Xiaomi Qin 1s+"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
depends="fplinux-audio fplinux-mesa"
options="!check"
source="
	drirc
	alsa.conf
"
builddir="$srcdir"

package() {
	install -Dm644 "$srcdir/drirc" "$pkgdir/etc/drirc"
	install -Dm644 "$srcdir/alsa.conf" "$pkgdir/etc/alsa/conf.d/99-fplinux-qin1splus.conf"
}

