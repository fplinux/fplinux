# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-rotate
pkgver=1
pkgrel=0
pkgdesc="V4L2 ROTA image rotation and verification tool for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-base"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev linux-headers fplinux-libdrm-dev"
options="!check"
source="
	fplinux-rotate.c
	fplinux-rotate-core.c
	rotate-rota.c
	rotate-rota.h
	fplinux-rotate.h
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-cli.c
	fplinux-cli.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"

	"$CC" $CPPFLAGS $CFLAGS -O3 -mfpu=neon-vfpv4 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm) \
		"$srcdir/fplinux-rotate.c" \
		"$srcdir/fplinux-rotate-core.c" \
		"$srcdir/rotate-rota.c" \
		"$srcdir/fplinux-drm-session.c" \
		"$srcdir/fplinux-cli.c" $(pkg-config --libs libdrm) $LDFLAGS -Wl,--gc-sections -o fplinux-rotate
}

package() {
	install -Dm755 "$builddir/fplinux-rotate" \
		"$pkgdir/usr/bin/fplinux-rotate"
}

