# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-rotate
pkgver=1
pkgrel=0
pkgdesc="V4L2 ROTA image rotation and verification tool for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev linux-headers"
options="!check"
source="
	fplinux-rotate.c
	fplinux-rotate-core.c
	fplinux-rotate.h
	fplinux-fb-session.c
	fplinux-fb-session.h
	fplinux-cli.c
	fplinux-cli.h
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -O2 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" \
		"$srcdir/fplinux-rotate.c" \
		"$srcdir/fplinux-rotate-core.c" \
		"$srcdir/fplinux-fb-session.c" \
		"$srcdir/fplinux-cli.c" $LDFLAGS -Wl,--gc-sections -o fplinux-rotate
}

package() {
	install -Dm755 "$builddir/fplinux-rotate" \
		"$pkgdir/usr/bin/fplinux-rotate"
}

