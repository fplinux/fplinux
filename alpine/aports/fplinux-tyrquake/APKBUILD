# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-tyrquake
pkgver=@version:aport_tyrquake_0_71_tar_gz@
pkgrel=0
pkgdesc="TyrQuake native DRM/evdev port for FPLinux"
url="https://disenchant.net/tyrquake/"
arch="armv7"
license="GPL-2.0-or-later AND MIT-0 AND CC0-1.0 AND MIT"
depends="fplinux-base fplinux-input"
subpackages="$pkgname-gpu:gpu"
makedepends_build="clang22 lld22 make patch pkgconf llvm22"
makedepends_host="musl-dev linux-headers gcc libevdev-dev eudev-dev fplinux-libdrm-dev fplinux-mesa-headers"
options="!check"
source="
	@source:aport_tyrquake_0_71_tar_gz@
	0001-FPLinux-add-native-runtime-support.patch
	fplinux-quake.c
	fplinux-quake-internal.h
	fplinux-quake-stats.c
	fplinux-quake-stats.h
	fplinux-quake-gl.c
	fplinux-quake-gl.h
	fplinux-gpu.c
	fplinux-gpu.h
	fplinux-gpu-output.c
	fplinux-gpu-output.h
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-input-device.h
	fplinux-input-session.c
	fplinux-input-session.h
	fplinux-keypad.h
	in_fplinux.c
	vid_fplinux.c
	vid_fplinux_gl.c
"
builddir="$srcdir/tyrquake-$pkgver"

prepare() {
	default_prepare
	install -Dm644 "$srcdir/fplinux-drm-session.c" common/fplinux-drm-session.c
	install -Dm644 "$srcdir/fplinux-drm-session.h" common/fplinux-drm-session.h
	install -Dm644 "$srcdir/fplinux-quake-internal.h" common/fplinux-quake-internal.h
	install -Dm644 "$srcdir/fplinux-quake-stats.c" common/fplinux-quake-stats.c
	install -Dm644 "$srcdir/fplinux-quake-stats.h" common/fplinux-quake-stats.h
	install -Dm644 "$srcdir/fplinux-quake-gl.c" common/fplinux-quake-gl.c
	install -Dm644 "$srcdir/fplinux-quake-gl.h" include/fplinux-quake-gl.h
	install -Dm644 "$srcdir/fplinux-gpu.c" common/fplinux-gpu.c
	install -Dm644 "$srcdir/fplinux-gpu.h" common/fplinux-gpu.h
	install -Dm644 "$srcdir/fplinux-gpu-output.c" common/fplinux-gpu-output.c
	install -Dm644 "$srcdir/fplinux-gpu-output.h" common/fplinux-gpu-output.h
	install -Dm644 "$srcdir/fplinux-input-device.h" \
		common/fplinux-input-device.h
	install -Dm644 "$srcdir/fplinux-input-session.c" \
		common/fplinux-input-session.c
	install -Dm644 "$srcdir/fplinux-input-session.h" \
		common/fplinux-input-session.h
	install -Dm644 "$srcdir/fplinux-keypad.h" common/fplinux-keypad.h
	install -Dm644 "$srcdir/in_fplinux.c" common/in_fplinux.c
	install -Dm644 "$srcdir/vid_fplinux.c" common/vid_fplinux.c
	install -Dm644 "$srcdir/vid_fplinux_gl.c" common/vid_fplinux_gl.c
}

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"

	make -j"${JOBS:-1}" \
		CC="$CC" \
		STRIP="$CHOST-strip" \
		CL_CPPFLAGS="$CPPFLAGS $(pkg-config --cflags libdrm libevdev)" \
		CFLAGS="$CFLAGS -std=gnu99 -Wall -Wno-trigraphs -Wwrite-strings -DFPLINUX_DEFAULT_HEAP_MB=32 -DFPLINUX_NO_STDIN=1" \
		COMMON_LFLAGS="$LDFLAGS" \
		TARGET_OS=UNIX \
		TARGET_UNIX=linux \
		LOCALBASE= \
		USE_X86_ASM=N \
		VID_TARGET=fplinux \
		IN_TARGET=fplinux \
		SND_TARGET=null \
		CD_TARGET=null \
		QBASEDIR=/tmp/fplinux-quake \
		TYR_VERSION=v$pkgver \
		TYR_VERSION_TIME="$SOURCE_DATE_EPOCH" \
		bin/tyr-quake bin/tyr-glquake
	"$CC" $CPPFLAGS $CFLAGS -std=gnu11 -Wall -Wextra -Werror \
		-I"$srcdir" \
		"$srcdir/fplinux-quake.c" \
		"$srcdir/fplinux-cli.c" $LDFLAGS -Wl,--gc-sections -o bin/fplinux-quake
}

package() {
	install -Dm755 bin/tyr-quake "$pkgdir/usr/bin/tyr-quake"
	install -Dm755 bin/tyr-glquake "$pkgdir/usr/bin/tyr-glquake"
	install -Dm755 bin/fplinux-quake "$pkgdir/usr/bin/quake"
}

gpu() {
	pkgdesc="GPU renderer for TyrQuake on FPLinux"
	depends="$pkgname=$pkgver-r$pkgrel fplinux-mesa"
	amove usr/bin/tyr-glquake
}

