# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-input
pkgver=1
pkgrel=0
pkgdesc="USB host-keyboard input bridge for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev linux-headers gcc"
subpackages="$pkgname-openrc"
options="!check"
source="fplinux-input.c fplinux-input.initd"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		"$srcdir/fplinux-input.c" $LDFLAGS -o fplinux-input
}

package() {
	install -Dm755 "$builddir/fplinux-input" "$pkgdir/usr/bin/fplinux-input"
	install -Dm755 "$srcdir/fplinux-input.initd" \
		"$pkgdir/etc/init.d/fplinux-input"
}

openrc() {
	default_openrc
}

sha512sums="
aa0777dab58f7f2cbde9a673ad4063026b227575c8fbeb73ac1e89e6c1b99624116bc33bf2748a9b2b0a0756f366256e0b012a8df545723d3ffaeac6fa810be4  fplinux-input.c
26e6f35394d14a9789bc703f720c9047dddfebda2ce7a640f3961e01a5baa50c4bbc3065dd1cb0c4ff5bca317385b04b95780b090069bd926640abc1d25d0749  fplinux-input.initd
"
