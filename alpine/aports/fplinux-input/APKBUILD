# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-input
pkgver=1
pkgrel=0
pkgdesc="Input device runtime and USB host-keyboard bridge for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-base fplinux-libudev fplinux-usb-gadget libinput-libs mdevd"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev linux-headers gcc"
subpackages="$pkgname-openrc"
options="!check"
source="
	fplinux-input.c
	fplinux-input.initd
	fplinux-mdevd.initd
	mdevd.conf
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		"$srcdir/fplinux-input.c" $LDFLAGS -o fplinux-input
}

package() {
	install -Dm755 "$builddir/fplinux-input" "$pkgdir/usr/bin/fplinux-input"
	install -Dm755 "$srcdir/fplinux-input.initd" \
		"$pkgdir/etc/init.d/fplinux-input"
	install -Dm755 "$srcdir/fplinux-mdevd.initd" \
		"$pkgdir/etc/init.d/fplinux-mdevd"
	install -Dm644 "$srcdir/mdevd.conf" "$pkgdir/etc/fplinux/mdevd.conf"
	mkdir -p "$pkgdir/etc/runlevels/sysinit"
	ln -s /etc/init.d/fplinux-mdevd \
		"$pkgdir/etc/runlevels/sysinit/fplinux-mdevd"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-input \
		"$pkgdir/etc/runlevels/default/fplinux-input"
}

openrc() {
	default_openrc
}

