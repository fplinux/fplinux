#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

name="FPLinux host keyboard bridge"
description="Forward USB host keyboard input"
supervisor=supervise-daemon
command=/usr/bin/fplinux-input
input_file=/dev/null
output_logger="/usr/libexec/fplinux/kmsg --level 6 --tag fplinux-input"
error_logger="/usr/libexec/fplinux/kmsg --level 3 --tag fplinux-input"
respawn_delay=1
respawn_max=0
retry="TERM/2/KILL/2"

depend() {
	need devfs fplinux-usb-gadget
}
