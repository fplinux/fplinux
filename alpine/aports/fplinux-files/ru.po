msgid "Files"
msgstr "Файлы"

msgid "Help"
msgstr "Справка"

msgid "Access denied. Choose another folder."
msgstr "Нет доступа. Выберите другую папку."

msgid "The file or storage is no longer available. Refresh Places."
msgstr "Файл или накопитель недоступен. Обновите список мест."

msgid "This storage is read-only."
msgstr "Накопитель доступен только для чтения."

msgid "The file name is not valid text. Rename it before opening."
msgstr "Имя файла содержит недопустимые символы. Переименуйте файл перед открытием."

msgid "That name already exists. Nothing was overwritten."
msgstr "Такое имя уже есть. Файл не перезаписан."

msgid "The folder is not empty. Only empty folders can be deleted."
msgstr "Папка не пуста. Можно удалить только пустую папку."

msgid "Not enough free space. Free some space and try again."
msgstr "Недостаточно места. Освободите место и повторите."

msgid "The name is too long. The limit is 255 bytes."
msgstr "Слишком длинное имя. Допустимо не более 255 байт."

msgid "Enter a name without / or line breaks, other than . or .. ."
msgstr "Введите имя без / и перевода строки, кроме . и .. ."

msgid "Symbolic links can be inspected but are not followed."
msgstr "Можно посмотреть сведения о ссылке, но перейти по ней нельзя."

msgid "This operation is not supported by the storage or file type."
msgstr "Операция не поддерживается накопителем или типом файла."

msgid "Copy and move are available for files only."
msgstr "Копирование и перенос доступны только для файлов."

msgid "This folder has more than 4096 entries."
msgstr "В папке больше 4096 записей."

msgid "Operation cancelled."
msgstr "Операция отменена."

msgid "Storage is busy. Close applications using it and try again."
msgstr "Накопитель занят. Закройте использующие его приложения и повторите."

msgid "Not enough memory. Close and try again."
msgstr "Недостаточно памяти. Закройте приложение и повторите."

msgid "The operation failed. Check the storage and try again."
msgstr "Операция не выполнена. Проверьте накопитель и повторите."

msgid "Open folders and files with the centre key. Back returns to the parent. Left and Right scroll a page."
msgstr "Центральная клавиша открывает папки и файлы. Назад — в родительскую папку. Влево и вправо — прокрутка на страницу."

msgid "Options offers file actions and Find in folder. Copy and move select a destination first. Existing files are never replaced."
msgstr "В меню «Опции» доступны действия с файлами и поиск в папке. Для копирования и переноса выберите папку назначения. Существующие файлы не перезаписываются."

msgid "My files are in your home directory. Safely eject a memory card from Places before removing it."
msgstr "«Мои файлы» находятся в домашней папке. Перед извлечением карты выберите безопасное извлечение в списке мест."

