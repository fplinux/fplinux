# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-files
pkgver=1
pkgrel=0
pkgdesc="File manager for the FPLinux graphical session"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="0BSD AND GPL-2.0-only"
depends="fplinux-ui"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev"
options="!check"
source="
	fplinux-files.c
	files-core.c
	files-core.h
	files-job.c
	files-job.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-storage.h
	org.fplinux.files.desktop
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -pthread \
		$(pkg-config --cflags fplinux-ui) \
		fplinux-files.c files-core.c files-job.c fplinux-cli.c \
		$(pkg-config --libs fplinux-ui) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-files
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-files" "$pkgdir/usr/bin/fplinux-files"
	install -Dm644 "$srcdir/org.fplinux.files.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.files.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.files.mo"
}

