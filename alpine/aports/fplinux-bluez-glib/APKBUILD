# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-bluez-glib
pkgver=2.88.1
pkgrel=0
pkgdesc="Private GLib core library for the BlueZ daemons and client"
url="https://gitlab.gnome.org/GNOME/glib"
arch="armv7"
license="LGPL-2.1-or-later"
makedepends_build="clang22 lld22 meson python3 samurai llvm22"
makedepends_host="libffi-dev musl-dev musl-libintl zlib-dev"
subpackages="$pkgname-dev"
options="!check"
source="https://download.gnome.org/sources/glib/${pkgver%.*}/glib-$pkgver.tar.xz
	0001-private-bluez-library.patch
	bluez-glib.map
	install-private-dev.py
"
builddir="$srcdir/glib-$pkgver"
_minor="${pkgver#*.}"
_library="libfplinux-bluez-glib-2.0.so.0.$((${_minor%.*} * 100)).${pkgver##*.}"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '/usr/lib/llvm22/bin/llvm-ar'
		[properties]
		pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
		have_c99_vsnprintf = true
		have_c99_snprintf = true
		have_unix98_printf = true
		have_proc_self_cmdline = true
		growing_stack = false
	EOF
	# The export map defines the private consumer boundary. Linker section
	# collection retains its internal calls, callback tables and constructors.
	cp "$srcdir/bluez-glib.map" "$builddir/glib/bluez-glib.map"
	CFLAGS="$CFLAGS -mthumb -ffunction-sections -fdata-sections" \
	LDFLAGS="$LDFLAGS -Wl,--gc-sections" \
	env -u CXX abuild-meson \
		-Db_lto=true -Db_lto_mode=thin -Db_lto_threads=2 \
		--cross-file fplinux-cross.meson \
		-Dglib_debug=disabled \
		-Dintrospection=disabled \
		-Dlibelf=disabled \
		-Dlibmount=disabled \
		-Dman-pages=disabled \
		-Dnls=disabled \
		-Dselinux=disabled \
		-Dsysprof=disabled \
		-Dtests=false \
		-Dxattr=false \
		output
	ninja -j"${JOBS:-1}" -C output "glib/$_library"
}

package() {
	install -Dm755 "$builddir/output/glib/$_library" "$pkgdir/usr/lib/$_library"
	ln -s "$_library" "$pkgdir/usr/lib/libfplinux-bluez-glib-2.0.so.0"
	install -Dm644 "$builddir/LICENSES/LGPL-2.1-or-later.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/LGPL-2.1-or-later.txt"
}

dev() {
	pkgdesc="$pkgdesc (private development files)"
	depends="$pkgname=$pkgver-r$pkgrel"
	meson introspect --installed "$builddir/output" | \
		python3 "$srcdir/install-private-dev.py" "$subpkgdir"
	ln -s libfplinux-bluez-glib-2.0.so.0 \
		"$subpkgdir/usr/lib/libfplinux-bluez-glib-2.0.so"
}

