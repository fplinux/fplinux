# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-gpu-probe
pkgver=1
pkgrel=0
pkgdesc="Offscreen Panfrost rendering check for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-mesa fplinux-libdrm"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev linux-headers fplinux-mesa-dev fplinux-libdrm-dev"
options="!check"
source="fplinux-gpu-probe.c fplinux-cli.c fplinux-cli.h fplinux-gpu.c fplinux-gpu.h"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -O2 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags egl glesv2 libdrm) \
		"$srcdir/fplinux-gpu-probe.c" "$srcdir/fplinux-cli.c" \
		"$srcdir/fplinux-gpu.c" \
		$(pkg-config --libs glesv2 libdrm) -ldl $LDFLAGS \
		-o fplinux-gpu-probe
}

package() {
	install -Dm755 "$builddir/fplinux-gpu-probe" \
		"$pkgdir/usr/bin/fplinux-gpu-probe"
}

