# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-glib
pkgver=2.88.1
pkgrel=0
pkgdesc="GLib core library for BlueZ without GIO, GObject and introspection"
url="https://gitlab.gnome.org/GNOME/glib"
arch="armv7"
license="LGPL-2.1-or-later"
makedepends_build="clang22 lld22 llvm22 meson python3 samurai"
makedepends_host="libffi-dev musl-dev musl-libintl pcre2-dev pcre2-static zlib-dev zlib-static"
subpackages="$pkgname-static-dev:static_dev"
options="!check"
source="https://download.gnome.org/sources/glib/${pkgver%.*}/glib-$pkgver.tar.xz
	install-static-dev.py
"
builddir="$srcdir/glib-$pkgver"
# GLib names its shared library 0.<minor * 100>.<micro>.
_minor="${pkgver#*.}"
_library="libglib-2.0.so.0.$((${_minor%.*} * 100)).${pkgver##*.}"

build() {
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	# abuild-meson describes the target machine and sysroot; this file adds
	# the archiver, keeps pkg-config inside the sysroot and answers the
	# run-time probes that a cross build cannot execute (musl passes them).
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '$CHOST-ar'
		[properties]
		pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
		have_c99_vsnprintf = true
		have_c99_snprintf = true
		have_unix98_printf = true
		have_proc_self_cmdline = true
		growing_stack = false
	EOF
	# GLib needs no C++. Without CXX, meson skips the optional C++ probe
	# whose driver would otherwise run the C library checks and fail on the
	# sysroot without a C++ standard library. Thumb-2 keeps the library
	# smaller than the ARM instruction set, as in the Alpine build.
	CFLAGS="$CFLAGS -mthumb" env -u CXX abuild-meson \
		--cross-file fplinux-cross.meson \
		-Dglib_debug=disabled \
		-Dintrospection=disabled \
		-Dlibelf=disabled \
		-Dlibmount=disabled \
		-Dman-pages=disabled \
		-Dnls=disabled \
		-Dselinux=disabled \
		-Dsysprof=disabled \
		-Dtests=false \
		-Dxattr=false \
		output
	ninja -C output "glib/$_library"
	export CFLAGS="$CFLAGS -Oz -flto=thin -mthumb -ffunction-sections -fdata-sections"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	sed "s|ar = '$CHOST-ar'|ar = '/usr/lib/llvm22/bin/llvm-ar'|" \
		fplinux-cross.meson >fplinux-static-cross.meson
	env -u CXX abuild-meson \
		--cross-file fplinux-static-cross.meson \
		--default-library=static \
		--libdir=lib/fplinux-glib-static \
		-Dprefer_static=true \
		-Dglib_debug=disabled \
		-Dintrospection=disabled \
		-Dlibelf=disabled \
		-Dlibmount=disabled \
		-Dman-pages=disabled \
		-Dnls=disabled \
		-Dselinux=disabled \
		-Dsysprof=disabled \
		-Dtests=false \
		-Dxattr=false \
		output-static
	ninja -j"${JOBS:-1}" -C output-static \
		glib/libglib-2.0.a \
		gobject/libgobject-2.0.a \
		gmodule/libgmodule-2.0.a \
		gio/libgio-2.0.a
}

package() {
	install -Dm755 "$builddir/output/glib/$_library" "$pkgdir/usr/lib/$_library"
	ln -s "$_library" "$pkgdir/usr/lib/libglib-2.0.so.0"
}

static_dev() {
	pkgdesc="Static GLib, GObject and GIO development files for FPLinux consumers"
	depends="libffi-dev pcre2-static zlib-static"
	meson introspect --installed "$builddir/output-static" | \
		python3 "$srcdir/install-static-dev.py" "$subpkgdir" "$CBUILDROOT"
	install -Dm644 "$builddir/LICENSES/LGPL-2.1-or-later.txt" \
		"$subpkgdir/usr/share/licenses/$subpkgname/LGPL-2.1-or-later.txt"
}

sha512sums="
74e6d6086081e5dfb5b7fd3b74f59171033be0c340ff2dd798fea9cb42e5f680e13b2ac3dde8dd423bceb9c6556103005f9542aeda166e9a3b89da8bacecca23  glib-2.88.1.tar.xz
4c9f5e5ad70208ad5c8b5bdbf79ac2077c88f2fdfecc5a48ebd642c6c50349cdcd829f2a9ea45daf6203a25b27fa05991c3d70819d1344582cc383f385b1d093  install-static-dev.py
"
