# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-libweston
pkgver=@version:weston@
pkgrel=0
pkgdesc="DRM compositor libraries for FPLinux"
url="https://wayland.freedesktop.org"
arch="armv7"
license="MIT AND GPL-2.0-only"
depends="fplinux-wayland fplinux-libdrm fplinux-libxkbcommon fplinux-mesa-gbm libinput-libs pixman libdisplay-info"
makedepends_build="clang22 lld22 meson samurai wayland-dev"
makedepends_host="musl-dev linux-headers fplinux-wayland-dev fplinux-libdrm-dev fplinux-libxkbcommon-dev fplinux-mesa-gbm-dev fplinux-mesa-headers libinput-dev libevdev-dev eudev-dev pixman-dev libdisplay-info-dev"
subpackages="$pkgname-dev"
options="!check"
_seatver=@version:aport_seatd_0_9_3_tar_gz@
source="
	@source:weston@
	@source:aport_seatd_0_9_3_tar_gz@
	minimal-cairo.patch
	internal-pixels.patch
	presentation-completion.patch
	yuv-plane-color.patch
	drm-gbm-renderer.patch
	pixel-format-gl-metadata.patch
	renderer-gl-install.patch
	fplinux-pixman-buffer.h
	fplinux-weston-presentation.h
	LICENSE
"
builddir="$srcdir/weston-$pkgver"

build() {
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '$CHOST-ar'
		[properties]
		pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
	EOF
	# Build the embedded seat backend without the seatd daemon, launcher or
	# socket client.
	abuild-meson --cross-file fplinux-cross.meson \
		-Dwerror=false \
		-Dlibseat-logind=disabled -Dlibseat-builtin=enabled \
		-Dlibseat-seatd=disabled -Dserver=disabled -Dexamples=disabled \
		-Dman-pages=disabled seat-output "$srcdir/seatd-$_seatver"
	meson compile -C seat-output
	DESTDIR="$builddir/seat-root" meson install --no-rebuild -C seat-output
	cat >>fplinux-cross.meson <<-EOF
		[built-in options]
		pkg_config_path = ['$builddir/seat-root/usr/lib/pkgconfig']
	EOF
	CFLAGS="$CFLAGS -I$builddir/seat-root/usr/include -I$srcdir" \
		LDFLAGS="$LDFLAGS -L$builddir/seat-root/usr/lib" \
		abuild-meson --cross-file fplinux-cross.meson \
		-Ddefault_library=shared \
		-Dbackend-drm=true -Dbackend-default=drm \
		-Dbackend-headless=false -Dbackend-pipewire=false \
		-Dbackend-rdp=false -Dbackend-vnc=false \
		-Dbackend-wayland=false -Dbackend-x11=false \
		-Drenderer-gl=false -Drenderer-vulkan=false \
		-Dxwayland=false -Dsystemd=false \
		-Dshell-desktop=false -Dshell-ivi=false -Dshell-kiosk=false \
		-Dshell-lua=false -Dcolor-management-lcms=false \
		-Dimage-cairo=disabled -Dimage-jpeg=false -Dimage-webp=false \
		-Dtools= -Ddemo-clients=false -Dsimple-clients= \
		-Dtests=false -Ddoc=false output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C seat-output
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	rm -rf "$pkgdir/usr/share/wayland-sessions" "$pkgdir/usr/share/weston" \
		"$pkgdir/usr/share/man"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
	install -Dm644 "$srcdir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/FPLinux-GPL-2.0.txt"
	install -Dm644 "$srcdir/seatd-$_seatver/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/seatd-LICENSE"
}

dev() {
	default_dev
	amove usr/share/libweston-16
}

