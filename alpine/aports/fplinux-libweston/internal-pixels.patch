+/* FPLinux's compositor-owned pixels never create a Wayland client buffer. */
+WL_EXPORT struct weston_buffer_reference *
+weston_buffer_create_internal_image(struct weston_compositor *compositor,
+                                   pixman_image_t *image)
+{
+	struct weston_buffer_reference *ret;
+	struct weston_buffer *buffer;
+	pixman_format_code_t format;
+
+	if (!image ||
+	    (compositor->renderer->type != WESTON_RENDERER_PIXMAN &&
+	     compositor->renderer->type != WESTON_RENDERER_GL))
+		return NULL;
+	format = pixman_image_get_format(image);
+	if (format != PIXMAN_r5g6b5 && format != PIXMAN_a8r8g8b8)
+		return NULL;
+	ret = zalloc(sizeof(*ret));
+	if (!ret)
+		return NULL;
+	buffer = zalloc(sizeof(*buffer));
+	if (!buffer) {
+		free(ret);
+		return NULL;
+	}
+	wl_signal_init(&buffer->destroy_signal);
+	buffer->type = WESTON_BUFFER_PIXMAN;
+	buffer->pixman_image = pixman_image_ref(image);
+	buffer->width = pixman_image_get_width(image);
+	buffer->height = pixman_image_get_height(image);
+	buffer->stride = pixman_image_get_stride(image);
+	buffer->buffer_origin = ORIGIN_TOP_LEFT;
+	buffer->pixel_format = pixel_format_get_info_by_pixman(format);
+	buffer->format_modifier = DRM_FORMAT_MOD_LINEAR;
+	buffer->format_modifier_name =
+		pixel_format_get_modifier(buffer->format_modifier);
+	weston_buffer_reference(ret, buffer, BUFFER_MAY_BE_ACCESSED);
+	return ret;
+}
+
+WL_EXPORT void
+weston_surface_attach_internal_image(struct weston_surface *surface,
+                                    struct weston_buffer_reference *buffer_ref)
+{
+	struct weston_buffer *buffer = buffer_ref->buffer;
+	struct weston_paint_node *node;
+
+	assert(!surface->resource);
+	assert(buffer && buffer->type == WESTON_BUFFER_PIXMAN);
+	weston_buffer_reference(&surface->buffer_ref, buffer,
+				BUFFER_MAY_BE_ACCESSED);
+	surface->width_from_buffer = buffer->width;
+	surface->height_from_buffer = buffer->height;
+	weston_surface_set_size(surface, buffer->width, buffer->height);
+
+	pixman_region32_fini(&surface->opaque);
+	surface->is_opaque =
+		pixman_image_get_format(buffer->pixman_image) == PIXMAN_r5g6b5 &&
+		surface->alpha_modifier == 1.0f;
+	if (surface->is_opaque)
+		pixman_region32_init_rect(&surface->opaque, 0, 0,
+					 buffer->width, buffer->height);
+	else
+		pixman_region32_init(&surface->opaque);
+
+	weston_surface_build_buffer_matrix(surface,
+					   &surface->surface_to_buffer_matrix);
+	weston_matrix_invert(&surface->buffer_to_surface_matrix,
+			     &surface->surface_to_buffer_matrix);
+	wl_list_for_each(node, &surface->paint_node_list, surface_link)
+		node->status |= WESTON_PAINT_NODE_BUFFER_DIRTY |
+				WESTON_PAINT_NODE_BUFFER_PARAMS_DIRTY |
+				WESTON_PAINT_NODE_VIEW_DIRTY;
+}
+
+WL_EXPORT void
+weston_buffer_destroy_internal_image(struct weston_buffer_reference *buffer_ref)
+{
+	assert(buffer_ref && buffer_ref->buffer);
+	assert(buffer_ref->type == BUFFER_MAY_BE_ACCESSED);
+	assert(buffer_ref->buffer->type == WESTON_BUFFER_PIXMAN);
+	weston_buffer_reference(buffer_ref, NULL, BUFFER_WILL_NOT_BE_ACCESSED);
+	free(buffer_ref);
+}
