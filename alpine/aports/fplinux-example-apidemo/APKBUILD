builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	# shellcheck disable=SC2086 # _sources is a list of file names.
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		$(pkg-config --cflags fplinux-ui) $_sources \
		$(pkg-config --libs fplinux-ui) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-example-apidemo
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	local image
	install -Dm755 "$builddir/fplinux-example-apidemo" \
		"$pkgdir/usr/bin/fplinux-example-apidemo"
	install -Dm644 "$srcdir/org.fplinux.example.apidemo.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.example.apidemo.desktop"
	install -Dm644 "$srcdir/org.fplinux.example.apidemo.png" \
		"$pkgdir/usr/share/icons/hicolor/48x48/apps/org.fplinux.example.apidemo.png"
	install -Dm644 "$srcdir/org.fplinux.example.apidemo-24.png" \
		"$pkgdir/usr/share/icons/hicolor/24x24/apps/org.fplinux.example.apidemo.png"
	install -Dm644 "$srcdir/org.fplinux.example.apidemo-60.png" \
		"$pkgdir/usr/share/icons/hicolor/60x60/apps/org.fplinux.example.apidemo.png"
	for image in $_images; do
		install -Dm644 "$srcdir/$image" \
			"$pkgdir/usr/share/fplinux-example-apidemo/$image"
	done
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.example.apidemo.mo"
	install -Dm644 "$srcdir/LICENSE-tabler" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE-tabler"
}

