# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-example-apidemo
pkgver=1
pkgrel=0
pkgdesc="Explore the FPLinux application API"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="0BSD AND GPL-2.0-only AND MIT"
depends="fplinux-ui"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev"
options="!check"
_sources="fplinux-example-apidemo.c apidemo-lists.c apidemo-forms.c
	apidemo-alerts.c apidemo-text.c apidemo-commands.c apidemo-canvas.c
	apidemo-frame.c apidemo-look.c apidemo-locale.c apidemo-lifecycle.c
	apidemo-vibration.c
	apidemo-sound.c apidemo-softkeys.c fplinux-cli.c"
_images="lists-symbolic.png forms-symbolic.png
	commands-symbolic.png canvas-symbolic.png
	look-symbolic.png locale-symbolic.png lifecycle-symbolic.png
	sound-symbolic.png photo.png
	star-symbolic.png"
source="
	apidemo.h
	fplinux-example-apidemo.c
	apidemo-lists.c
	apidemo-forms.c
	apidemo-alerts.c
	apidemo-text.c
	apidemo-commands.c
	apidemo-softkeys.c
	apidemo-canvas.c
	apidemo-frame.c
	apidemo-look.c
	apidemo-locale.c
