	org.fplinux.example.apidemo.desktop
	org.fplinux.example.apidemo.png
	org.fplinux.example.apidemo-24.png
	org.fplinux.example.apidemo-60.png
	lists-symbolic.png
	forms-symbolic.png
	commands-symbolic.png
	canvas-symbolic.png
	look-symbolic.png
	locale-symbolic.png
