# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-clocks
pkgver=1
pkgrel=0
pkgdesc="Alarms, countdown timer, stopwatch and world clocks"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev json-c-dev"
options="!check"
source="
	fplinux-clocks.c
	clock-client.c
	clock-client.h
	clock-model.c
	clock-model.h
	clock-presentation.c
	clock-presentation.h
	clock-wire.c
	clock-wire.h
	fplinux-storage.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-cli.c
	fplinux-cli.h
	org.fplinux.clock.desktop
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		$(pkg-config --cflags fplinux-ui json-c) \
		fplinux-clocks.c clock-client.c clock-model.c \
		clock-presentation.c clock-wire.c fplinux-cli.c fplinux-utf8.c \
		$(pkg-config --libs fplinux-ui json-c) -lm $LDFLAGS \
		-flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe -o fplinux-clocks
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-clocks" "$pkgdir/usr/bin/fplinux-clocks"
	install -Dm644 "$srcdir/org.fplinux.clock.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.clock.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.clock.mo"
}
