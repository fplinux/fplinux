# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-ffmpeg
pkgver=7.1.5
pkgrel=0
pkgdesc="MPEG-4, H.263 and H.264 software video decoding for FPLinux"
url="https://ffmpeg.org"
arch="armv7"
license="LGPL-2.1-or-later AND IJG"
makedepends_build="clang22 lld22 llvm22 make"
makedepends_host="musl-dev"
options="!check"
source="https://ffmpeg.org/releases/ffmpeg-$pkgver.tar.xz"
builddir="$srcdir/ffmpeg-$pkgver"

build() {
	: "${CC:?missing target CC}" \
		"${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	./configure \
		--prefix=/usr \
		--target-os=linux --arch=arm --cpu=cortex-a7 --enable-cross-compile \
		--cc="$CC" \
		--ar=/usr/lib/llvm22/bin/llvm-ar \
		--nm=/usr/lib/llvm22/bin/llvm-nm \
		--ranlib=/usr/lib/llvm22/bin/llvm-ranlib \
		--strip=/usr/lib/llvm22/bin/llvm-strip \
		--sysroot="$CBUILDROOT" \
		--extra-cflags="--target=$CHOST --gcc-toolchain=$CBUILDROOT/usr $CPPFLAGS $CFLAGS -march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=hard -marm" \
		--extra-ldflags="--target=$CHOST --gcc-toolchain=$CBUILDROOT/usr $LDFLAGS -static" \
		--disable-autodetect --disable-everything --disable-network --disable-iconv \
		--disable-devices --disable-hwaccels --disable-doc --disable-debug \
		--disable-shared --enable-static --disable-ffplay --disable-ffprobe \
		--disable-avdevice --disable-postproc --disable-swresample --disable-swscale \
		--enable-ffmpeg --enable-neon \
		--enable-decoder=mpeg4,h263,h264 \
		--enable-parser=mpeg4video,h263,h264 \
		--enable-demuxer=mov,avi,matroska,m4v,h263,h264 \
		--enable-encoder=wrapped_avframe,rawvideo \
		--enable-muxer=rawvideo,null,md5,framecrc,framemd5 \
		--enable-protocol=file,pipe
	make -j"${JOBS:-1}" ffmpeg
}

package() {
	install -Dm755 "$builddir/ffmpeg" "$pkgdir/usr/bin/ffmpeg"
	install -Dm644 "$builddir/LICENSE.md" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
	install -Dm644 "$builddir/COPYING.LGPLv2.1" \
		"$pkgdir/usr/share/licenses/$pkgname/COPYING.LGPLv2.1"
	printf '%s\n' \
		'This software is based in part on the work of the Independent JPEG Group.' \
		>"$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
sha512sums="
c0649ef9edd4176b90459e92b636be18077ca898f24fe1a8dc60f3c5fd58cf718db9720bbe804c6f6894453e21c0625d706ea37d3523fcb40d61779763d7d965  ffmpeg-7.1.5.tar.xz
"
