# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-wpa-supplicant
pkgver=@version:aport_wpa_supplicant_2_11_tar_gz@
pkgrel=0
pkgdesc="WPA wireless station authentication runtime"
url="https://w1.fi/wpa_supplicant/"
arch="armv7"
license="BSD-3-Clause"
_alpine_version="@version:aport_wpa_supplicant_cli_sh@"
provides="wpa_supplicant=$_alpine_version nm-wifi-backend"
provider_priority=10
replaces="wpa_supplicant"
makedepends_build="clang23 lld23 pkgconf"
makedepends_host="dbus-dev libnl3-dev linux-headers musl-dev openssl-dev"
options="!check"
source="
	@source:aport_wpa_supplicant_2_11_tar_gz@
	@source:aport_wpa_supplicant_nl80211_scan_patch@
	@source:aport_wpa_supplicant_ap_ft_sae_patch@
	@source:aport_wpa_supplicant_authorization_patch@
	@source:aport_wpa_supplicant_cli_sh@
	keep-p2p-disabled-setting.patch
"
builddir="$srcdir/wpa_supplicant-$pkgver"

prepare() {
	default_prepare
	cat > wpa_supplicant/.config <<-EOF
		CONFIG_DRIVER_NL80211=y
		CONFIG_LIBNL32=y
		CONFIG_CTRL_IFACE=y
		CONFIG_CTRL_IFACE_DBUS_NEW=y
		CONFIG_CTRL_IFACE_DBUS_INTRO=y
		CONFIG_WPA_CLI_EDIT=y
		CONFIG_BACKEND=file
		CONFIG_AP=y
		CONFIG_AUTOSCAN_PERIODIC=y
		CONFIG_BGSCAN_SIMPLE=y
		CONFIG_HT_OVERRIDES=y
		CONFIG_IEEE80211N=y
		CONFIG_DEBUG_SYSLOG=y
		CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
		CONFIG_GETRANDOM=y
		CONFIG_IPV6=y
		CONFIG_SAE=y
		CONFIG_TLS=openssl
	EOF
}

build() {
	export CFLAGS="$CFLAGS -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin"
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	make -C wpa_supplicant CC="$CC" LIBDIR=/lib BINDIR=/sbin \
		wpa_supplicant wpa_cli wpa_passphrase dbus/fi.w1.wpa_supplicant1.service
}

package() {
	install -Dm755 -t "$pkgdir/sbin" wpa_supplicant/wpa_cli \
		wpa_supplicant/wpa_passphrase wpa_supplicant/wpa_supplicant
	install -Dm755 "$srcdir/wpa_cli.sh" "$pkgdir/etc/wpa_supplicant/wpa_cli.sh"
	install -Dm644 wpa_supplicant/dbus/fi.w1.wpa_supplicant1.service \
		"$pkgdir/usr/share/dbus-1/system-services/fi.w1.wpa_supplicant1.service"
	install -Dm644 wpa_supplicant/dbus/dbus-wpa_supplicant.conf \
		"$pkgdir/usr/share/dbus-1/system.d/wpa_supplicant.conf"
	install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING README
}

sha512sums="
51f7357b1900412331049293ffc44da8275a601b409953aca1dd40c0aa8c8683ff93ead884d466fe2fc4283a3c974c29e74e293d7ac69115e9a476f1a534bc86  keep-p2p-disabled-setting.patch
"
