# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-sbc
pkgver=@version:aport_sbc_2_2_tar_xz@
pkgrel=0
pkgdesc="SBC audio codec library for Bluetooth audio"
url="https://www.bluez.org/"
arch="armv7"
license="LGPL-2.1-or-later"
makedepends_build="clang22 lld22 llvm22 make"
makedepends_host="musl-dev"
subpackages="$pkgname-dev"
options="!check"
source="
	@source:aport_sbc_2_2_tar_xz@
"
builddir="$srcdir/sbc-$pkgver"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--disable-static \
		--disable-tools \
		--disable-tester
	make -j"${JOBS:-1}"
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 "$builddir/COPYING.LIB" \
		"$pkgdir/usr/share/licenses/$pkgname/COPYING.LIB"
}
sha512sums="
"
