# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-showcase
pkgver=1
pkgrel=0
pkgdesc="FPLinux ARMADA synchronized hardware showcase"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev linux-headers fplinux-libdrm-dev"
options="!check"
source="
	armada-scene.c
	armada-scene.h
	fplinux-showcase.c
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-keypad.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"

	"$CC" $CPPFLAGS $CFLAGS -O2 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm) \
		"$srcdir/armada-scene.c" \
		"$srcdir/fplinux-showcase.c" \
		"$srcdir/fplinux-drm-session.c" \
		"$srcdir/fplinux-cli.c" $(pkg-config --libs libdrm) $LDFLAGS -Wl,--gc-sections -o fplinux-showcase
}

package() {
	install -Dm755 "$builddir/fplinux-showcase" \
		"$pkgdir/usr/bin/fplinux-showcase"
}

