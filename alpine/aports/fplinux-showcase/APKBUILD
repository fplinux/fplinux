# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-showcase
pkgver=1
pkgrel=0
pkgdesc="FPLinux ARMADA synchronized hardware showcase"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-base fplinux-font-terminus-data"
makedepends_build="clang22 lld22 pkgconf"
makedepends_host="musl-dev linux-headers fplinux-libdrm-dev fplinux-mesa-dev"
options="!check"
source="
	armada-scene.c
	armada-scene.h
	armada-frame.h
	armada-math.h
	armada-geometry.c
	armada-geometry.h
	armada-overlay.c
	armada-overlay.h
	armada-gpu-renderer.c
	armada-gpu-renderer.h
	armada-scene.vert
	armada-scene.frag
	armada-renderer.c
	armada-renderer.h
	armada-storyboard.c
	armada-storyboard.h
	showcase-hardware.c
	showcase-hardware.h
	fplinux-showcase.c
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-gpu.c
	fplinux-gpu.h
	fplinux-gpu-output.c
	fplinux-gpu-output.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-font.c
	fplinux-font.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-brightness-client.c
	fplinux-brightness-client.h
	fplinux-keypad.h
	fplinux-keypad-light.c
	fplinux-keypad-light.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"

	"$CC" $CPPFLAGS $CFLAGS -O2 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags libdrm) \
		"$srcdir/armada-scene.c" \
		"$srcdir/armada-renderer.c" \
		"$srcdir/armada-geometry.c" \
		"$srcdir/armada-overlay.c" \
		"$srcdir/armada-gpu-renderer.c" \
		"$srcdir/armada-storyboard.c" \
		"$srcdir/showcase-hardware.c" \
		"$srcdir/fplinux-showcase.c" \
		"$srcdir/fplinux-drm-session.c" \
		"$srcdir/fplinux-gpu.c" \
		"$srcdir/fplinux-gpu-output.c" \
		"$srcdir/fplinux-brightness-client.c" \
		"$srcdir/fplinux-keypad-light.c" \
		"$srcdir/fplinux-font.c" \
		"$srcdir/fplinux-utf8.c" \
		"$srcdir/fplinux-cli.c" $(pkg-config --libs libdrm) -ldl $LDFLAGS -Wl,--gc-sections -o fplinux-showcase
}

package() {
	install -Dm755 "$builddir/fplinux-showcase" \
		"$pkgdir/usr/bin/fplinux-showcase"
	install -Dm644 "$srcdir/armada-scene.vert" \
		"$pkgdir/usr/share/fplinux/armada/armada-scene.vert"
	install -Dm644 "$srcdir/armada-scene.frag" \
		"$pkgdir/usr/share/fplinux/armada/armada-scene.frag"
}

