# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-showcase
pkgver=1
pkgrel=0
pkgdesc="FPLinux ARMADA scene with rendering statistics"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui"
subpackages="$pkgname-gpu:gpu"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev fplinux-libdrm-dev fplinux-mesa-headers"
options="!check"
source="
	armada-scene.c
	armada-scene.h
	armada-frame.h
	armada-math.h
	armada-geometry.c
	armada-geometry.h
	armada-gpu-renderer.c
	armada-gpu-renderer.h
	armada-scene.vert
	armada-scene.frag
	armada-renderer.c
	armada-renderer.h
	armada-storyboard.c
	armada-storyboard.h
	fplinux-showcase.c
	showcase-app.h
	showcase-setup.c
	showcase-results.c
	org.fplinux.showcase.desktop
	ru.po
	fplinux-gpu.c
	fplinux-gpu.h
	fplinux-gpu-frame.c
	fplinux-gpu-frame.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-system-info.c
	fplinux-system-info.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"

	"$CC" $CPPFLAGS $CFLAGS -O2 -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags fplinux-ui libdrm) \
		"$srcdir/armada-scene.c" \
		"$srcdir/armada-renderer.c" \
		"$srcdir/armada-geometry.c" \
		"$srcdir/armada-gpu-renderer.c" \
		"$srcdir/armada-storyboard.c" \
		"$srcdir/fplinux-showcase.c" \
		"$srcdir/showcase-setup.c" \
		"$srcdir/showcase-results.c" \
		"$srcdir/fplinux-gpu.c" \
		"$srcdir/fplinux-gpu-frame.c" \
		"$srcdir/fplinux-cli.c" \
		"$srcdir/fplinux-system-info.c" $(pkg-config --libs fplinux-ui libdrm) \
		-ldl $LDFLAGS -Wl,--gc-sections -o fplinux-showcase
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-showcase" \
		"$pkgdir/usr/bin/fplinux-showcase"
	install -Dm644 "$srcdir/org.fplinux.showcase.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.showcase.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.showcase.mo"
	install -Dm644 "$srcdir/armada-scene.vert" \
		"$pkgdir/usr/share/fplinux/armada/armada-scene.vert"
	install -Dm644 "$srcdir/armada-scene.frag" \
		"$pkgdir/usr/share/fplinux/armada/armada-scene.frag"
}

gpu() {
	pkgdesc="GPU scene resources for the FPLinux ARMADA showcase"
	depends="$pkgname=$pkgver-r$pkgrel fplinux-mesa"
	amove usr/share/fplinux/armada/armada-scene.vert \
		usr/share/fplinux/armada/armada-scene.frag
}

