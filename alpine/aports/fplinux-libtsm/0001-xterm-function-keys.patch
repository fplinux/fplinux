+static bool vte_write_function(struct tsm_vte *vte, uint32_t keysym,
+			       unsigned int mods)
+{
+	static const unsigned int numbers[] = { 15, 17, 18, 19, 20, 21, 23, 24 };
+	char sequence[16];
+	char modifier;
+	int length;
+
+	if (keysym >= XKB_KEY_KP_F1 && keysym <= XKB_KEY_KP_F4)
+		keysym -= XKB_KEY_KP_F1 - XKB_KEY_F1;
+	if (keysym >= XKB_KEY_F13 && keysym <= XKB_KEY_F24) {
+		keysym -= XKB_KEY_F13 - XKB_KEY_F1;
+		mods |= TSM_SHIFT_MASK;
+	}
+	if (keysym < XKB_KEY_F1 || keysym > XKB_KEY_F12)
+		return false;
+	modifier = csi_modifier_from_mask(mods);
+	if (keysym <= XKB_KEY_F4) {
+		char final = 'P' + keysym - XKB_KEY_F1;
+
+		if (modifier)
+			length = snprintf(sequence, sizeof(sequence), "\e[1;%c%c", modifier, final);
+		else
+			length = snprintf(sequence, sizeof(sequence), "\eO%c", final);
+	} else {
+		unsigned int number = numbers[keysym - XKB_KEY_F5];
+
+		if (modifier)
+			length = snprintf(sequence, sizeof(sequence), "\e[%u;%c~", number, modifier);
+		else
+			length = snprintf(sequence, sizeof(sequence), "\e[%u~", number);
+	}
+	vte_write(vte, sequence, length);
+	return true;
+}
