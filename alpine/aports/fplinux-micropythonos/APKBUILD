prepare() {
	local file

	install -d \
		"$builddir/freezeFS" \
		"$builddir/lvgl_micropython/lib/lvgl" \
		"$builddir/lvgl_micropython/lib/micropython" \
		"$builddir/lvgl_micropython/lib/pycparser"
	cp -a "$srcdir/freezefs-$_freezefs_commit/." "$builddir/freezeFS/"
	cp -a "$srcdir/lvgl_micropython-$_lvgl_micropython_commit/." \
		"$builddir/lvgl_micropython/"
	cp -a "$srcdir/micropython-$_micropython_commit/." \
		"$builddir/lvgl_micropython/lib/micropython/"
	install -d \
		"$builddir/lvgl_micropython/lib/micropython/lib/micropython-lib"
	cp -a "$srcdir/micropython-lib-$_micropython_lib_commit/." \
		"$builddir/lvgl_micropython/lib/micropython/lib/micropython-lib/"
	cp -a "$srcdir/lvgl-$_lvgl_commit/." \
		"$builddir/lvgl_micropython/lib/lvgl/"
	cp -a "$srcdir/pycparser-$_pycparser_commit/." \
		"$builddir/lvgl_micropython/lib/pycparser/"

	tr -d '\015' < "$builddir/freezeFS/freezefs/archive.py" \
		> "$builddir/freezeFS/freezefs/archive.py.lf"
	mv "$builddir/freezeFS/freezefs/archive.py.lf" \
		"$builddir/freezeFS/freezefs/archive.py"
	default_prepare
	install -d \
		"$builddir/internal_filesystem/apps/org.fplinux.keypadtest"
	install -m644 "$srcdir/fplinux-keypad-test.MANIFEST.JSON" \
		"$builddir/internal_filesystem/apps/org.fplinux.keypadtest/MANIFEST.JSON"
	install -m644 "$srcdir/fplinux-keypad-test.py" \
		"$builddir/internal_filesystem/apps/org.fplinux.keypadtest/fplinux-keypad-test.py"
	install -m644 \
		"$builddir/internal_filesystem/apps/com.micropythonos.texteditor/icon_64x64.png" \
		"$builddir/internal_filesystem/apps/org.fplinux.keypadtest/icon_64x64.png"
	python3 "$srcdir/fplinux-select-builtin.py" "$builddir" \
		"$srcdir/fplinux-builtin-apps.list"
	mv "$builddir/lvgl_micropython/ext_mod/lcd_bus/micropython.mk" \
		"$builddir/lvgl_micropython/ext_mod/lcd_bus/micropython.mk.disabled"
	cp -a "$builddir/lvgl_micropython/lib_lvgl_src_font/." \
		"$builddir/lvgl_micropython/lib/lvgl/src/font/"
	rm -f \
		"$builddir/lvgl_micropython/lib/lvgl/src/font/lv_font_simsun_14_cjk.c" \
		"$builddir/lvgl_micropython/lib/lvgl/src/font/lv_font_simsun_16_cjk.c"
	patch --batch --forward -d "$builddir/lvgl_micropython/lib/lvgl" -p1 \
		-i "$builddir/lvgl_micropython/lib_lvgl_lv_bmp.c.patch"
	patch --batch --forward -d "$builddir/lvgl_micropython/lib/lvgl" -p1 \
		-i "$builddir/lvgl_micropython/lib_lvgl_src_libs_tjpgd_fix_scaling.patch"
	patch --batch --forward -d "$builddir/lvgl_micropython/lib/lvgl" -p1 \
		-i "$builddir/lvgl_micropython/imgfont_set_range.patch"
	install -Dm644 "$srcdir/manifest.py" "$builddir/manifests/manifest-fplinux.py"
	install -Dm644 "$srcdir/mpconfigvariant.h" \
		"$builddir/lvgl_micropython/lib/micropython/ports/unix/variants/fplinux/mpconfigvariant.h"
	install -Dm644 "$srcdir/mpconfigvariant.mk" \
		"$builddir/lvgl_micropython/lib/micropython/ports/unix/variants/fplinux/mpconfigvariant.mk"
	install -Dm644 "$srcdir/fplinux_keypad.c" \
		"$builddir/lvgl_micropython/ext_mod/fplinux_keypad/fplinux_keypad.c"
	for file in \
		fplinux-input-device.h fplinux-input-session.c \
		fplinux-input-session.h fplinux-keyboard-text.c \
		fplinux-keyboard-text.h fplinux-keypad.h; do
		install -Dm644 "$srcdir/$file" \
			"$builddir/lvgl_micropython/ext_mod/fplinux_keypad/$file"
	done
	install -Dm644 "$srcdir/fplinux-multitap.c" \
		"$builddir/lvgl_micropython/ext_mod/fplinux_keypad/fplinux-multitap.c"
	install -Dm644 "$srcdir/fplinux-multitap.h" \
		"$builddir/lvgl_micropython/ext_mod/fplinux_keypad/fplinux-multitap.h"
	install -Dm644 "$srcdir/fplinux_multitap_native.c" \
		"$builddir/lvgl_micropython/ext_mod/fplinux_keypad/fplinux_multitap_native.c"
	install -Dm644 "$srcdir/micropython.mk" \
		"$builddir/lvgl_micropython/ext_mod/fplinux_keypad/micropython.mk"
	install -Dm644 "$srcdir/fplinux.py" \
		"$builddir/internal_filesystem/lib/mpos/board/fplinux.py"
	install -Dm644 "$srcdir/fplinux_storage.py" \
		"$builddir/internal_filesystem/lib/mpos/fplinux_storage.py"
	install -Dm644 "$srcdir/fplinux-multitap.py" \
		"$builddir/internal_filesystem/lib/mpos/fplinux_multitap.py"
	install -Dm644 "$srcdir/fplinux-small-screen-layout.py" \
		"$builddir/internal_filesystem/lib/mpos/ui/fplinux_small_screen_layout.py"
	python3 "$srcdir/fplinux-select-libraries.py" "$builddir"
	python3 "$srcdir/fplinux-verify-app-imports.py" "$builddir" \
		"$srcdir/fplinux-packaged-apps.list"
	rm -f \
		"$builddir/internal_filesystem/apps/com.micropythonos.showfonts/Rancourt-SmallCaps.ttf"
}

# The keyboard module links a static libxkbcommon without X11, Wayland, the
# layout registry or tools. Its configured data root only matters for
# default include paths, which the module disables.
_build_xkbcommon() {
	local source="$srcdir/libxkbcommon-xkbcommon-$_xkbcommon_ver"
	local staged="$builddir/lvgl_micropython/ext_mod/fplinux_keypad/xkbcommon"

	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	(
		cd "$source"
		# abuild-meson describes the target machine; this file adds the
		# archiver and keeps pkg-config inside the sysroot.
		cat >fplinux-cross.meson <<-EOF
			[binaries]
			ar = '$CHOST-ar'
			[properties]
			pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
		EOF
		abuild-meson \
			--cross-file fplinux-cross.meson \
			-Ddefault_library=static \
			-Denable-bash-completion=false \
			-Denable-docs=false \
			-Denable-tools=false \
			-Denable-wayland=false \
			-Denable-x11=false \
			-Denable-xkbregistry=false \
			-Dxkb-config-root=/usr/share/fplinux/xkb \
			output
		ninja -C output libxkbcommon.a
	)
	install -Dm644 "$source/output/libxkbcommon.a" "$staged/libxkbcommon.a"
	install -d "$staged/include/xkbcommon"
	install -m644 "$source"/include/xkbcommon/*.h "$staged/include/xkbcommon/"
}

build() {
	_build_xkbcommon
	env -u CPPFLAGS -u CFLAGS -u LDFLAGS \
		make -j"${JOBS:-1}" \
		-C "$builddir/lvgl_micropython/lib/micropython/mpy-cross" \
		CC=cc CROSS_COMPILE=
	install -d "$builddir/.tmp/builtin"
	"$builddir/scripts/compile_dir.sh" \
		"$builddir/internal_filesystem/builtin" "$builddir/.tmp/builtin"
	(
		cd "$builddir/freezeFS"
		python3 -m freezefs --target /builtin --on-import mount \
			"$builddir/.tmp/builtin" freezefs_mount_builtin.py
	)
	test -f "$builddir/freezeFS/freezefs_mount_builtin.py"
	(
		cd "$builddir/lvgl_micropython"
		MPOS_FPLINUX=1 \
		CROSS_COMPILE="$CHOST-" \
		CC="$CC" \
		STRIP="$CHOST-strip" \
		CFLAGS="$CFLAGS" \
		CPPFLAGS="$CPPFLAGS" \
		LDFLAGS="$LDFLAGS" \
		python3 make.py unix \
			VARIANT=fplinux \
			--heap-size=4194304 \
			'LV_CFLAGS=-O2 -g0 -DMICROPY_FB=1 -DLV_LINUX_FBDEV_RENDER_MODE=LV_DISPLAY_RENDER_MODE_FULL -DLV_LINUX_FBDEV_BUFFER_COUNT=1' \
			"FROZEN_MANIFEST=$builddir/manifests/manifest-fplinux.py"
	)
	grep -Fq '#define MODULE_DEF_FPLINUX_MULTITAP_NATIVE {' \
		"$builddir/lvgl_micropython/lib/micropython/ports/unix/build-fplinux/genhdr/moduledefs.h"
	"$CC" $CPPFLAGS $CFLAGS -std=c11 -Wall -Wextra -Werror \
		"$srcdir/fplinux-micropythonos-launcher.c" $LDFLAGS \
		"$srcdir/fplinux-fb-session.c" \
		-o fplinux-micropythonos-launcher
}

package() {
	local app

	install -Dm755 "$builddir/lvgl_micropython/build/lvgl_micropy_unix" \
		"$pkgdir/usr/libexec/fplinux-micropythonos/micropythonos"
	install -Dm755 fplinux-micropythonos-launcher \
		"$pkgdir/usr/libexec/fplinux-micropythonos/fplinux-micropythonos-launcher"
	install -Dm644 "$srcdir/micropythonos-wrapper.sh" \
		"$pkgdir/usr/libexec/fplinux-micropythonos/micropythonos-wrapper.sh"
	install -Dm755 "$srcdir/micropythonos" "$pkgdir/usr/bin/micropythonos"
	install -d -m 0755 \
		"$pkgdir/var/lib/micropythonos/apps" \
		"$pkgdir/var/lib/micropythonos/cache" \
		"$pkgdir/var/lib/micropythonos/data" \
		"$pkgdir/var/lib/micropythonos/lib" \
		"$pkgdir/var/lib/micropythonos/prefs"

	while IFS= read -r app || [ -n "$app" ]; do
		case "$app" in
			"" | \#*) continue ;;
			*[!A-Za-z0-9._-]*) return 1 ;;
		esac
		test -d "$builddir/internal_filesystem/apps/$app" || return 1
		install -d "$pkgdir/usr/share/micropythonos/apps/$app"
		cp -a "$builddir/internal_filesystem/apps/$app/." \
			"$pkgdir/usr/share/micropythonos/apps/$app/"
	done < "$srcdir/fplinux-packaged-apps.list"

	install -Dm644 "$builddir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/MicroPythonOS-MIT.txt"
	install -Dm644 "$builddir/lvgl_micropython/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/lvgl_micropython-MIT.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/micropython/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/MicroPython-MIT.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/micropython/lib/micropython-lib/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/micropython-lib-LICENSE.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/LICENCE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/LVGL-MIT.txt"
	install -Dm644 "$builddir/freezeFS/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/freezeFS-MIT.txt"
	install -Dm644 "$srcdir/libxkbcommon-xkbcommon-$_xkbcommon_ver/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/libxkbcommon-LICENSE.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/scripts/built_in_font/font_license/Montserrat/OFL.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/Montserrat-OFL-1.1.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/scripts/built_in_font/font_license/FontAwesome5/LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/FontAwesome5-OFL-1.1.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/scripts/built_in_font/font_license/unscii/unscii.html" \
		"$pkgdir/usr/share/licenses/$pkgname/Unscii-public-domain.html"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/src/libs/lodepng/LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/LodePNG-Zlib.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/src/libs/tjpgd/LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/TJpgDec-ChaN.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/src/libs/qrcode/LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/QRCode-MIT.txt"
	install -Dm644 "$builddir/lvgl_micropython/lib/lvgl/src/stdlib/builtin/LICENSE_SPRINTF.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/sprintf-MIT.txt"
	install -Dm644 "$srcdir/COPYING.GPL-2.0" \
		"$pkgdir/usr/share/licenses/$pkgname/GPL-2.0-only.txt"
	install -Dm644 "$srcdir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/FPLinux-MIT.txt"
	install -Dm644 "$srcdir/NOTICE" \
		"$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}

