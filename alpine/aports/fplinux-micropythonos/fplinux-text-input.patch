+        self._multitap_timer = lv.timer_create(self._expire_multitap, 50, None)
+
+    def _render_multitap(self):
+        if self._textarea is None:
+            return
+        text = self._multitap.display_text
+        if self._textarea.get_text() != text:
+            self._textarea.set_text(text)
+
+    def handle_physical_key(self, key, now_ms):
+        if self._textarea is None or not self._multitap.handle(key, now_ms):
+            return False
+        self._render_multitap()
+        return True
+
+    def commit_physical_input(self):
+        if self._multitap.commit():
+            self._render_multitap()
+
+    def submit_physical_input(self):
+        self.commit_physical_input()
+        self._keyboard.send_event(lv.EVENT.READY, None)
+
+    def dismiss_physical_input(self):
+        self.hide_keyboard()
+
+    def _expire_multitap(self, timer):
+        del timer
+        if fplinux_multitap.is_active(self) and self._multitap.expire(time.ticks_ms()):
+            self._render_multitap()
+
+    def _activate_multitap(self):
+        if self._textarea is None or fplinux_multitap.is_active(self):
+            return
+        self._multitap.reset(self._textarea.get_text())
+        fplinux_multitap.activate(self)
+
+        group = lv.group_get_default()
+        if group is not None:
+            present = any(
+                group.get_obj_by_index(index) is self._textarea
+                for index in range(group.get_obj_count())
+            )
+            if not present:
+                group.add_obj(self._textarea)
+            lv.group_focus_obj(self._textarea)
+
+    def _deactivate_multitap(self):
+        if not fplinux_multitap.is_active(self):
+            return
+        self.commit_physical_input()
+        fplinux_multitap.deactivate(self)
