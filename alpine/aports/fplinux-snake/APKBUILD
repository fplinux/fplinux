# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-snake
pkgver=1
pkgrel=0
pkgdesc="Fullscreen keypad Snake for the FPLinux graphical session"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev"
options="!check"
source="
	fplinux-snake.c
	fplinux-cli.c
	fplinux-cli.h
	snake.c
	snake.h
	org.fplinux.snake.desktop
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		$(pkg-config --cflags fplinux-ui) \
		fplinux-snake.c snake.c fplinux-cli.c \
		$(pkg-config --libs fplinux-ui) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-snake
	# English is the source text; other languages are catalogues.
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-snake" \
		"$pkgdir/usr/bin/fplinux-snake"
	install -Dm644 "$srcdir/org.fplinux.snake.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.snake.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.snake.mo"
}

