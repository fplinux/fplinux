# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-usb-gadget
pkgver=1
pkgrel=0
pkgdesc="ConfigFS USB gadget for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
depends="busybox-extras openrc"
subpackages="$pkgname-openrc"
options="!check"
source="fplinux-usb-gadget fplinux-usb-gadget.initd fplinux-usb-dhcp.initd"

package() {
	install -Dm755 "$srcdir/fplinux-usb-gadget" \
		"$pkgdir/usr/libexec/fplinux/usb-gadget"
	install -Dm755 "$srcdir/fplinux-usb-gadget.initd" \
		"$pkgdir/etc/init.d/fplinux-usb-gadget"
	install -Dm755 "$srcdir/fplinux-usb-dhcp.initd" \
		"$pkgdir/etc/init.d/fplinux-usb-dhcp"
	mkdir -p "$pkgdir/etc/runlevels/sysinit"
	ln -s /etc/init.d/fplinux-usb-gadget \
		"$pkgdir/etc/runlevels/sysinit/fplinux-usb-gadget"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-usb-dhcp \
		"$pkgdir/etc/runlevels/default/fplinux-usb-dhcp"
}

openrc() {
	default_openrc
}

