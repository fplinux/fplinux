# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-ui
pkgver=1
pkgrel=0
pkgdesc="Shared LVGL keypad UI and Wayland SHM application runtime"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only AND LGPL-2.1-or-later AND OFL-1.1"
depends="fplinux-lvgl fplinux-wayland fplinux-libxkbcommon json-c fplinux-icons"
# The UI fonts also need lv_font_conv 1.5.3, which the build image pins in its
# npm tools (/opt/quality/node-tools, run by nodejs) rather than an Alpine
# package.
makedepends_build="clang22 lld22 pkgconf wayland-dev wayland-protocols gettext python3
	py3-fonttools nodejs"
makedepends_host="musl-dev musl-libintl linux-headers gcc fplinux-lvgl-dev fplinux-wayland-dev fplinux-libxkbcommon-dev json-c-dev"
subpackages="$pkgname-dev"
options="!check"
# Noto Sans v2.015 (hinted), Noto Sans Symbols 2 v2.008 and Noto Sans Math
# v3.000 from Noto's distribution repository at the commit that published
# Noto Sans v2.015; fplinux_ui_fonts.py also pins each file's SHA-256 and the
# release archive it equals.
_noto=https://raw.githubusercontent.com/notofonts/notofonts.github.io/28b15b4b43b7bed62b5cf6e6b0b5ff5846270535/fonts
_notogh=https://raw.githubusercontent.com/notofonts
source="
	NotoSans-Regular-2.015.ttf::$_noto/NotoSans/hinted/ttf/NotoSans-Regular.ttf
	NotoSans-Bold-2.015.ttf::$_noto/NotoSans/hinted/ttf/NotoSans-Bold.ttf
	NotoSans-SemiCondensed-2.015.ttf::$_noto/NotoSans/hinted/ttf/NotoSans-SemiCondensed.ttf
	NotoSans-SemiCondensedBold-2.015.ttf::$_noto/NotoSans/hinted/ttf/NotoSans-SemiCondensedBold.ttf
	NotoSans-Condensed-2.015.ttf::$_noto/NotoSans/hinted/ttf/NotoSans-Condensed.ttf
	NotoSansSymbols2-Regular-2.008.ttf::$_noto/NotoSansSymbols2/hinted/ttf/NotoSansSymbols2-Regular.ttf
	NotoSansMath-Regular-3.000.ttf::$_noto/NotoSansMath/hinted/ttf/NotoSansMath-Regular.ttf
	NotoSans-OFL-2.015.txt::$_notogh/latin-greek-cyrillic/NotoSans-v2.015/OFL.txt
	NotoSansSymbols2-OFL-2.008.txt::$_notogh/symbols/NotoSansSymbols2-v2.008/OFL.txt
	NotoSansMath-OFL-3.000.txt::$_notogh/math/NotoSansMath-v3.000/OFL.txt
	fplinux-ui.c
	fplinux-ui.h
	fplinux-ui-session.c
	fplinux-ui-session.h
	fplinux-ui-text.c
	fplinux-ui-text.h
	fplinux-ui-text-model.c
	fplinux-ui-text-model.h
	fplinux-ui-listview.c
	fplinux-ui-listview.h
	fplinux-ui-menu.c
	fplinux-ui-menu.h
	fplinux-ui-prefs.c
	fplinux-ui-prefs.h
	fplinux-ui-screen.c
	fplinux-ui-screen.h
	fplinux-ui-screen-model.c
	fplinux-ui-screen-model.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
	fplinux-ui-profile.json
	fplinux_ui_profile.py
	fplinux_ui_fonts.py
	fplinux-ui-fonts.h
	fplinux-ui-internal.h
	fplinux-ui-locale.c
	fplinux-ui-locale.h
	fplinux-language.c
	fplinux-language.h
	fplinux-multitap.c
	fplinux-multitap.h
	fplinux-ui.pc
	fplinux-ui.map
	ru.po
	LGPL-2.1-or-later.txt
	GPL-2.0-only.txt
	fplinux-ui-softkey-layout.c
	fplinux-ui-softkey-layout.h
	fplinux-ui-style-internal.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	wayland-scanner client-header \
		/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
		xdg-shell-client-protocol.h
	wayland-scanner private-code \
		/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
		xdg-shell-protocol.c
	# The models, the profile table, the soft-key layout, the list view, the
	# language reader and the multi-tap engine stay private to the library.
	# The library exports exactly the functions of its installed headers,
	# listed in fplinux-ui.map.
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-fvisibility=hidden -I"$srcdir" \
		-c fplinux-language.c fplinux-multitap.c \
		fplinux-ui-text-model.c fplinux-ui-screen-model.c \
		fplinux-ui-profile.c fplinux-ui-softkey-layout.c
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-fvisibility=hidden -I"$srcdir" $(pkg-config --cflags lvgl) \
		-c fplinux-ui-listview.c
	# Rasterize each profile's Noto Sans fonts at 4 bpp.
	python3 fplinux_ui_fonts.py --tokens fplinux-ui-profile.json \
		--sources "$srcdir" --output fonts \
		--lv-font-conv /opt/quality/node-tools/node_modules/.bin/lv_font_conv
	for font in fonts/*.c; do
		"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
			-fvisibility=hidden -I"$srcdir" $(pkg-config --cflags lvgl) \
			-c "$font" -o "${font%.c}.o"
	done
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-I"$srcdir" $(pkg-config --cflags lvgl wayland-client xkbcommon json-c) \
		-shared fplinux-ui.c fplinux-ui-session.c fplinux-ui-text.c \
		fplinux-ui-menu.c fplinux-ui-prefs.c fplinux-ui-screen.c \
		fplinux-ui-locale.c \
		fplinux-ui-listview.o \
		fplinux-language.o fplinux-multitap.o \
		fplinux-ui-text-model.o fplinux-ui-screen-model.o \
		fplinux-ui-profile.o fplinux-ui-softkey-layout.o fonts/*.o \
		xdg-shell-protocol.c $LDFLAGS \
		$(pkg-config --libs lvgl wayland-client xkbcommon json-c) \
		-Wl,--version-script=fplinux-ui.map \
		-Wl,-soname,libfplinux-ui.so.1 -o libfplinux-ui.so.1
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 libfplinux-ui.so.1 "$pkgdir/usr/lib/libfplinux-ui.so.1"
	ln -s libfplinux-ui.so.1 "$pkgdir/usr/lib/libfplinux-ui.so"
	install -Dm644 fplinux-ui.h "$pkgdir/usr/include/fplinux/fplinux-ui.h"
	install -Dm644 fplinux-ui-session.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-session.h"
	install -Dm644 fplinux-ui-text.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-text.h"
	install -Dm644 fplinux-ui-menu.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-menu.h"
	install -Dm644 fplinux-ui-prefs.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-prefs.h"
	install -Dm644 fplinux-ui-screen.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-screen.h"
	install -Dm644 fplinux-ui-locale.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-locale.h"
	install -Dm644 fplinux-ui.pc "$pkgdir/usr/lib/pkgconfig/fplinux-ui.pc"
	# musl looks for LANG=ru_RU.UTF-8 in ru_RU, then in ru.
	install -Dm644 ru.mo \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/fplinux-ui.mo"
	install -Dm644 LGPL-2.1-or-later.txt \
		"$pkgdir/usr/share/licenses/$pkgname/LGPL-2.1-or-later.txt"
	install -Dm644 GPL-2.0-only.txt \
		"$pkgdir/usr/share/licenses/$pkgname/GPL-2.0-only.txt"
	install -Dm644 NotoSans-OFL-2.015.txt \
		"$pkgdir/usr/share/licenses/$pkgname/NotoSans-OFL.txt"
	install -Dm644 NotoSansSymbols2-OFL-2.008.txt \
		"$pkgdir/usr/share/licenses/$pkgname/NotoSansSymbols2-OFL.txt"
	install -Dm644 NotoSansMath-OFL-3.000.txt \
		"$pkgdir/usr/share/licenses/$pkgname/NotoSansMath-OFL.txt"
}

