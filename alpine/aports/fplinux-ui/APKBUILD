builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	wayland-scanner client-header \
		/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
		xdg-shell-client-protocol.h
	wayland-scanner private-code \
		/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
		xdg-shell-protocol.c
	# The models, the profile table, the soft-key layout, the list view, the
	# language reader and the text-input engine stay private to the library.
	# The library exports exactly the functions of its installed headers,
	# listed in fplinux-ui.map.
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-fvisibility=hidden -I"$srcdir" \
		-c fplinux-language.c fplinux-multitap.c fplinux-text-input.c \
		fplinux-ui-text-model.c fplinux-ui-screen-model.c \
		fplinux-ui-profile.c fplinux-ui-softkey-layout.c
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-fvisibility=hidden -I"$srcdir" $(pkg-config --cflags lvgl) \
		-c fplinux-ui-listview.c
	# Rasterize each profile's fonts at 4 bpp.
	python3 fplinux_ui_fonts.py --tokens fplinux-ui-profile.json \
		--sources "$srcdir" --output fonts \
		--lv-font-conv /opt/quality/node-tools/node_modules/.bin/lv_font_conv
	for font in fonts/*.c; do
		"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
			-fvisibility=hidden -I"$srcdir" $(pkg-config --cflags lvgl) \
			-c "$font" -o "${font%.c}.o"
	done
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-I"$srcdir" $(pkg-config --cflags lvgl wayland-client xkbcommon json-c) \
		-shared fplinux-ui.c fplinux-ui-style.c fplinux-ui-session.c fplinux-ui-text.c \
		fplinux-audio-client.c fplinux-ui-frame.c \
		fplinux-ui-menu.c fplinux-ui-prefs.c fplinux-ui-screen.c \
		fplinux-ui-locale.c fplinux-ui-symbol-picker.c \
		fplinux-ui-listview.o \
		fplinux-language.o fplinux-multitap.o fplinux-text-input.o fplinux-utf8.c \
		fplinux-ui-text-model.o fplinux-ui-screen-model.o \
		fplinux-ui-profile.o fplinux-ui-softkey-layout.o fonts/*.o \
		xdg-shell-protocol.c $LDFLAGS \
		$(pkg-config --libs lvgl wayland-client xkbcommon json-c) \
		-Wl,--version-script=fplinux-ui.map \
		-Wl,-soname,libfplinux-ui.so.1 -o libfplinux-ui.so.1
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 libfplinux-ui.so.1 "$pkgdir/usr/lib/libfplinux-ui.so.1"
	ln -s libfplinux-ui.so.1 "$pkgdir/usr/lib/libfplinux-ui.so"
	install -Dm644 fplinux-ui.h "$pkgdir/usr/include/fplinux/fplinux-ui.h"
	install -Dm644 fplinux-gettext.h "$pkgdir/usr/include/fplinux/fplinux-gettext.h"
	install -Dm644 fplinux-storage.h "$pkgdir/usr/include/fplinux/fplinux-storage.h"
	install -Dm644 fplinux-ui-audio.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-audio.h"
	install -Dm644 fplinux-ui-vibration.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-vibration.h"
	install -Dm644 fplinux-ui-frame.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-frame.h"
	install -Dm644 fplinux-ui-session.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-session.h"
	install -Dm644 fplinux-ui-document.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-document.h"
	install -Dm644 fplinux-ui-storage.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-storage.h"
	install -Dm644 fplinux-volumes.h \
		"$pkgdir/usr/include/fplinux/fplinux-volumes.h"
	install -Dm644 fplinux-utf8.h \
		"$pkgdir/usr/include/fplinux/fplinux-utf8.h"
	install -Dm644 fplinux-ui-text.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-text.h"
	install -Dm644 fplinux-ui-symbol-picker.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-symbol-picker.h"
	install -Dm644 fplinux-ui-menu.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-menu.h"
	install -Dm644 fplinux-ui-prefs.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-prefs.h"
	install -Dm644 fplinux-ui-screen.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-screen.h"
	install -Dm644 fplinux-ui-locale.h \
		"$pkgdir/usr/include/fplinux/fplinux-ui-locale.h"
	install -Dm644 fplinux-ui.pc "$pkgdir/usr/lib/pkgconfig/fplinux-ui.pc"
	# musl looks for LANG=ru_RU.UTF-8 in ru_RU, then in ru.
	install -Dm644 ru.mo \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/fplinux-ui.mo"
	install -Dm644 LGPL-2.1-or-later.txt \
		"$pkgdir/usr/share/licenses/$pkgname/LGPL-2.1-or-later.txt"
	install -Dm644 GPL-2.0-only.txt \
		"$pkgdir/usr/share/licenses/$pkgname/GPL-2.0-only.txt"
	install -Dm644 NotoSans-OFL-2.015.txt \
		"$pkgdir/usr/share/licenses/$pkgname/NotoSans-OFL.txt"
	install -Dm644 NotoSansSymbols2-OFL-2.008.txt \
		"$pkgdir/usr/share/licenses/$pkgname/NotoSansSymbols2-OFL.txt"
	install -Dm644 NotoSansMath-OFL-3.000.txt \
		"$pkgdir/usr/share/licenses/$pkgname/NotoSansMath-OFL.txt"
	install -Dm644 Galmuri-OFL-2.40.4.txt \
		"$pkgdir/usr/share/licenses/$pkgname/Galmuri-OFL.txt"
}

