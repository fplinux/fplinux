# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-ui
pkgver=1
pkgrel=0
pkgdesc="Shared LVGL keypad UI and Wayland SHM application runtime"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only AND LGPL-2.1-or-later AND OFL-1.1"
depends="fplinux-lvgl fplinux-wayland fplinux-libxkbcommon json-c fplinux-icons"
# The UI fonts also need lv_font_conv, which the build image pins in its
# npm tools (/opt/quality/node-tools, run by nodejs) rather than an Alpine
# package.
makedepends_build="clang22 lld22 pkgconf wayland-dev wayland-protocols gettext python3
	py3-fonttools nodejs"
makedepends_host="musl-dev musl-libintl linux-headers gcc fplinux-lvgl-dev fplinux-wayland-dev fplinux-libxkbcommon-dev json-c-dev"
subpackages="$pkgname-dev"
options="!check"
source="
