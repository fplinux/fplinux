# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-mre
pkgver=1
pkgrel=0
pkgdesc="MRE runtime for native ARM VXP applications"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only AND 0BSD AND MIT AND Zlib AND libpng-2.0 AND IJG AND BSD-3-Clause"
depends="fplinux-ui fplinux-font-terminus-8x16 libcurl"
makedepends_build="clang22 lld22 pkgconf cmake samurai gettext"
makedepends_host="musl-dev musl-libintl linux-headers gcc zlib-dev zlib-static libpng-dev libpng-static curl-dev openssl-dev fplinux-ui-dev"
options="!check"
source="
	@source:mre_gif@
	@source:mre_gif_license@
	@source:mre_png_license@
	@source:aport_libjpeg_turbo_3_2_0_tar_gz@
	subblock-length.patch
	fplinux-mre.c
	runtime-paths.c
	runtime-paths.h
	text-codec.c
	text-codec.h
	vfs-broker.c
	vfs-broker.h
	http-broker.c
	http-broker.h
	mre-http.h
	mre-ipc.h
	org.fplinux.mre.desktop
	ru.po
	fplinux-font.c
	fplinux-font.h
	fplinux-utf8.c
	fplinux-utf8.h
	fplinux-cli.c
	fplinux-cli.h
	fplinux-keypad.h
	fplinux-multitap.h
	fplinux-language.h
	LICENSE
	0BSD.txt
"
builddir="$srcdir"

prepare() {
	# abuild links loose downloads into srcdir. Patch an owned regular copy,
	# keeping the checksum-verified cache member unchanged.
	cp -L "$srcdir/gif.h" "$srcdir/gif.h.prepared"
	mv -f "$srcdir/gif.h.prepared" "$srcdir/gif.h"
	default_prepare
	# The UI and the engine use project headers outside the public UI ABI.
	install -Dm644 fplinux-font.h include/fplinux/fplinux-font.h
	install -Dm644 fplinux-keypad.h include/fplinux/fplinux-keypad.h
	install -Dm644 fplinux-multitap.h include/fplinux/fplinux-multitap.h
	install -Dm644 fplinux-language.h include/fplinux/fplinux-language.h
}

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir/include" -I"$startdir" $(pkg-config --cflags fplinux-ui libcurl) \
		fplinux-mre.c runtime-paths.c text-codec.c vfs-broker.c http-broker.c fplinux-cli.c \
		$(pkg-config --libs fplinux-ui libcurl libcrypto) $LDFLAGS \
		-o fplinux-mre
	msgfmt --check --output-file=ru.mo ru.po

	# ARM SIMD dispatch can open /proc/cpuinfo inside the sandboxed engine.
	# Build a separate portable JPEG library from the pinned upstream source.
	: "${CC:?missing target CC}" \
		"${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	local jpeg_ar
	jpeg_ar="$(command -v "$CHOST-ar")"
	cmake -S "$srcdir/libjpeg-turbo-3.2.0" -B jpeg-build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=armv7 \
		-DCMAKE_C_COMPILER="$CC" -DCMAKE_ASM_COMPILER="$CC" \
		-DCMAKE_C_COMPILER_TARGET="$CHOST" -DCMAKE_ASM_COMPILER_TARGET="$CHOST" \
		-DCMAKE_C_FLAGS="$CPPFLAGS $CFLAGS -marm" \
		-DCMAKE_AR="$jpeg_ar" -DCMAKE_SYSROOT="$CBUILDROOT" \
		-DCMAKE_FIND_ROOT_PATH="$CBUILDROOT" \
		-DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
		-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY \
		-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
		-DENABLE_SHARED=OFF -DENABLE_STATIC=ON -DWITH_SIMD=OFF \
		-DWITH_JPEG8=OFF -DWITH_JPEG7=OFF \
		-DWITH_TURBOJPEG=OFF -DWITH_TOOLS=OFF -DWITH_TESTS=OFF
	cmake --build jpeg-build --target jpeg-static --parallel "${JOBS:-1}"

	mkdir -p engine-objects
	local unit
	for unit in engine/engine ads/ads_image memory/mre-memory gif/resize-image text-codec; do
		"$CC" $CPPFLAGS $CFLAGS -marm -std=c11 -Wall -Wextra -Werror \
			-I"$srcdir/include" -I"$srcdir" -I"$startdir" \
			-c "$startdir/$unit.c" -o "engine-objects/${unit##*/}.o"
	done
	"$CC" $CPPFLAGS $CFLAGS -marm -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir/libjpeg-turbo-3.2.0/src" -Ijpeg-build \
		$(pkg-config --cflags libpng) \
		-c "$startdir/image/image-decode.c" -o engine-objects/image-decode.o
	# The unchanged upstream header contains unused static helper functions.
	# This suppression applies only to the decoder translation unit.
	"$CC" $CPPFLAGS $CFLAGS -marm -std=c11 -Wall -Wextra -Werror \
		-Wno-unused-function -I"$srcdir" \
		-c "$startdir/gif/gif-image.c" -o engine-objects/gif-image.o
	"$CC" $CPPFLAGS $CFLAGS -marm -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" -c fplinux-font.c -o engine-objects/fplinux-font.o
	"$CC" $CPPFLAGS $CFLAGS -marm -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" -c fplinux-utf8.c -o engine-objects/fplinux-utf8.o
	for unit in engine/guest_call engine/ads-host ads/ads_call; do
		"$CC" $CPPFLAGS $CFLAGS -marm -Wa,-I"$startdir/ads" \
			-c "$startdir/$unit.S" -o "engine-objects/${unit##*/}.o"
	done
	"$CC" $CFLAGS -marm -static \
		engine-objects/engine.o \
		engine-objects/text-codec.o \
		engine-objects/ads_image.o engine-objects/fplinux-font.o \
		engine-objects/fplinux-utf8.o \
		engine-objects/mre-memory.o engine-objects/gif-image.o \
		engine-objects/resize-image.o engine-objects/image-decode.o \
		engine-objects/guest_call.o engine-objects/ads-host.o \
		engine-objects/ads_call.o jpeg-build/libjpeg.a \
		"$CBUILDROOT/usr/lib/libpng.a" "$CBUILDROOT/usr/lib/libz.a" -lm \
		$LDFLAGS -o mre-engine
}

package() {
	install -Dm755 "$builddir/fplinux-mre" "$pkgdir/usr/bin/fplinux-mre"
	install -Dm755 "$builddir/mre-engine" \
		"$pkgdir/usr/libexec/fplinux/mre-engine"
	install -Dm644 "$srcdir/org.fplinux.mre.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.mre.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.mre.mo"
	install -Dm644 "$srcdir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/GPL-2.0-only.txt"
	install -Dm644 "$srcdir/0BSD.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/0BSD.txt"
	install -Dm644 "$srcdir/TurboStitchGIF-LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/TurboStitchGIF-MIT.txt"
	install -Dm644 "$startdir/gif/LICENSE-adapter" \
		"$pkgdir/usr/share/licenses/$pkgname/GIF-adapter-0BSD.txt"
	install -Dm644 "$srcdir/libpng-LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/libpng-LICENSE.txt"
	install -Dm644 "$srcdir/libjpeg-turbo-3.2.0/LICENSE.md" \
		"$pkgdir/usr/share/licenses/$pkgname/libjpeg-turbo-LICENSE.md"
	install -Dm644 "$srcdir/libjpeg-turbo-3.2.0/README.ijg" \
		"$pkgdir/usr/share/licenses/$pkgname/README.ijg"
}

