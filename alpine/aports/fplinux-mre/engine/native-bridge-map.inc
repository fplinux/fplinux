static uintptr_t adapt_api_address(uintptr_t address)
{
	if (!guest_uses_ads_abi())
		return address;
	for (size_t i = 0; i < sizeof(sdk_bridges) / sizeof(sdk_bridges[0]);
	     ++i)
		if (sdk_bridges[i].base == address)
			return sdk_bridges[i].ads;
	fail("SDK implementation has no ADS ABI bridge: 0x%08" PRIxPTR,
	     address);
}
