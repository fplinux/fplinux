# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-xkb
pkgver=2.48
pkgrel=0
pkgdesc="US keyboard layout data for FPLinux applications"
url="https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config"
arch="noarch"
license="HPND AND HPND-sell-variant AND X11 AND X11-distribute-modifications-variant AND MIT AND MIT-open-group AND xkeyboard-config-Zinoviev"
options="!check"
source="
	https://www.x.org/releases/individual/data/xkeyboard-config/xkeyboard-config-$pkgver.tar.xz
	fplinux
"
builddir="$srcdir/xkeyboard-config-$pkgver"

# Every file included by keycodes "evdev+aliases(qwerty)", types and compat
# "complete", and symbols "pc+us+fplinux(function_keys)+group(alt_shift_toggle)" when the data root is
# the only include path, plus symbols/kpdl, which many locale layouts include,
# so that locale packages never ship the same file.
package() {
	local file
	for file in \
		keycodes/aliases keycodes/evdev \
		types/basic types/complete types/extra types/iso9995 types/level5 \
		types/mousekeys types/numpad types/pc \
		compat/accessx compat/basic compat/caps compat/complete \
		compat/iso9995 compat/ledcaps compat/lednum compat/ledscroll \
		compat/level5 compat/misc compat/mousekeys compat/xfree86 \
		symbols/group symbols/keypad symbols/kpdl symbols/pc \
		symbols/srvr_ctrl symbols/us; do
		install -Dm644 "$builddir/$file" "$pkgdir/usr/share/fplinux/xkb/$file"
	done
	install -Dm644 "$srcdir/fplinux" "$pkgdir/usr/share/fplinux/xkb/symbols/fplinux"
	install -Dm644 "$builddir/COPYING" \
		"$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
sha512sums="
2c24f9cca97b8863ff2e71fc3780e9c3e22e4486c80d45022e2208d559bdb40824bdb8a4037e0d5690900b6e080ddef4eacfc8bff843e04ba5ab86940f1fb6ea  xkeyboard-config-2.48.tar.xz
82facea83a5f6b6b6fccb9c42b5e7eff92c26689456f5d53d95171092c6874d2f32ea3f5fcda35d162f937e1e503afe468016efa86a9927d0f1430802d010294  fplinux
"
