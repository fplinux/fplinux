// SPDX-License-Identifier: MIT
// Minimal rules for the layouts shipped by FPLinux keyboard packages. The
// compositor names US first and up to three registered layouts after it, each
// in its own group.
! model = keycodes
  * = evdev+aliases(qwerty)

! model = types
  * = complete

! model = compat
  * = complete

! layout = symbols
  * = pc+%l+fplinux(function_keys)

! layout[1] = symbols
  * = pc+%l[1]+fplinux(function_keys)

! layout[2] = symbols
  * = +%l[2]:2

! layout[3] = symbols
  * = +%l[3]:3

! layout[4] = symbols
  * = +%l[4]:4

! option = symbols
  group:alt_shift_toggle = +group(alt_shift_toggle)
