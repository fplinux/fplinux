#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

description="Wi-Fi station control"
command="/sbin/wpa_supplicant"
command_args="-u"
supervisor=supervise-daemon
respawn_delay=2
respawn_max=5
respawn_period=60
retry="TERM/5/KILL/2"

depend() {
	need dbus fplinux-devices
}
