# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-brand
pkgver=1
pkgrel=0
pkgdesc="FPLinux brand marks and lockups for the session"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="CC-BY-ND-4.0"
makedepends_build="nodejs python3"
options="!check"
# The build copies svgraster.py from alpine/aports/fplinux-icons,
# fplinux-ui-profile.json from lib/fplinux and CC-BY-ND-4.0.txt from LICENSES.
source="
	fplinux-mark-light.svg
	fplinux-mark-dark.svg
	fplinux-lockup-light.svg
	fplinux-lockup-dark.svg
	generate-brand.py
	svgraster.py
	fplinux-ui-profile.json
	CC-BY-ND-4.0.txt
"
builddir="$srcdir"

build() {
	# Sizes come from the profiles' logo table; resvg is pinned in the image.
	NODE_PATH=/opt/quality/node-tools/node_modules PYTHONDONTWRITEBYTECODE=1 \
		python3 generate-brand.py --profile fplinux-ui-profile.json \
		--out "$builddir/brand"
}

package() {
	local file
	# mark-{light,dark}-N.png and lockup-{light,dark}-W.png; consumers keep
	# 1/8 of the mark height free around them.
	for file in "$builddir"/brand/*.png "$builddir"/brand/*.rgb565; do
		install -Dm644 "$file" "$pkgdir/usr/share/fplinux/brand/${file##*/}"
	done
	install -Dm644 "$srcdir/CC-BY-ND-4.0.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/CC-BY-ND-4.0.txt"
}

