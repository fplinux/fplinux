# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-launcher
pkgver=1
pkgrel=0
pkgdesc="Keypad home, system bars and package-driven FPLinux app catalogue"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui fplinux-icons fplinux-brand"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers gcc fplinux-ui-dev"
options="!check"
source="
	fplinux-launcher.c
	launcher-catalogue.c
	launcher-catalogue.h
	launcher-layout.c
	launcher-layout.h
	launcher-launch.c
	launcher-launch.h
	launcher-power.c
	launcher-power.h
	launcher-text.c
	launcher-text.h
	launcher-tasks.c
	launcher-tasks.h
	org.fplinux.launcher.desktop
	ru.po
	fplinux-cli.c
	fplinux-cli.h
	fplinux-desktop-entry.c
	fplinux-desktop-entry.h
	fplinux-ui-session.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags fplinux-ui) \
		fplinux-launcher.c launcher-catalogue.c launcher-layout.c \
		launcher-power.c launcher-text.c launcher-tasks.c launcher-launch.c fplinux-cli.c \
		fplinux-ui-profile.c fplinux-desktop-entry.c $LDFLAGS \
		$(pkg-config --libs fplinux-ui) -o fplinux-launcher
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 fplinux-launcher "$pkgdir/usr/bin/fplinux-launcher"
	install -Dm644 org.fplinux.launcher.desktop \
		"$pkgdir/usr/share/applications/org.fplinux.launcher.desktop"
	install -Dm644 ru.mo \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.launcher.mo"
	# The launcher watches the tile directories of every profile's sizes
	# (fplinux-ui-profile.json row_icon_size and app_icon_size).
	for size in 16 20 24 32 40 48 56 60; do
		install -d "$pkgdir/usr/share/icons/hicolor/${size}x$size/apps"
	done
}

