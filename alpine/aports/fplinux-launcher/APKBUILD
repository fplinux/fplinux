# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-launcher
pkgver=1.0.0
pkgrel=0
pkgdesc="Keypad home, system bars and package-driven FPLinux app catalogue"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui fplinux-icons fplinux-brand"
makedepends_build="clang23 lld23 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers gcc fplinux-ui-dev json-c-dev dbus-dev"
options="!check"
source="
	fplinux-launcher.c
	launcher-catalogue.c
	launcher-catalogue.h
	launcher-clock.c
	launcher-clock.h
	launcher-icons.c
	launcher-icons.h
	launcher-layout.c
	launcher-layout.h
	launcher-launch.c
	launcher-launch.h
	launcher-power.c
	launcher-power.h
	launcher-text.c
	launcher-text.h
	launcher-tasks.c
	launcher-tasks.h
	launcher-quick-settings.c
	launcher-quick-settings.h
	fplinux-clock-model.c
	fplinux-clock-model.h
	clock-face.c
	clock-face.h
	fplinux-clock-wire.c
	fplinux-clock-wire.h
	fplinux-storage.h
	fplinux-utf8.c
	fplinux-utf8.h
	org.fplinux.launcher.desktop
	ru.po
	fplinux-cli.c
	fplinux-cli.h
	fplinux-desktop-entry.c
	fplinux-desktop-entry.h
	fplinux-ui-session.h
	fplinux-system-levels.h
	fplinux-ui-document.h
	fplinux-volumes.h
	fplinux-ui-vibration.h
	fplinux-ui-lights.h
	fplinux-ui-profile.c
	fplinux-ui-profile.h
	fplinux-settings-values.h
	fplinux-bluez-adapter.c
	fplinux-bluez-adapter.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags fplinux-ui json-c dbus-1) \
		fplinux-launcher.c launcher-catalogue.c launcher-icons.c launcher-layout.c \
		launcher-power.c launcher-text.c launcher-tasks.c launcher-launch.c launcher-clock.c \
		launcher-quick-settings.c fplinux-bluez-adapter.c \
		fplinux-clock-model.c fplinux-clock-wire.c clock-face.c fplinux-cli.c fplinux-utf8.c \
		fplinux-ui-profile.c fplinux-desktop-entry.c $LDFLAGS \
		$(pkg-config --libs fplinux-ui json-c dbus-1) -lm -o fplinux-launcher
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 fplinux-launcher "$pkgdir/usr/bin/fplinux-launcher"
	install -Dm644 org.fplinux.launcher.desktop \
		"$pkgdir/usr/share/applications/org.fplinux.launcher.desktop"
	install -Dm644 ru.mo \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.launcher.mo"
	# The launcher watches the tile directories of every profile's sizes
	# (fplinux-ui-profile.json row_icon_size and app_icon_size).
	for size in 16 20 24 32 40 48 56 60; do
		install -d "$pkgdir/usr/share/icons/hicolor/${size}x$size/apps"
	done
}

