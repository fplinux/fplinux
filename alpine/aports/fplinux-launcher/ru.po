# Russian translation of the FPLinux launcher.
msgid ""
msgstr ""
"Project-Id-Version: org.fplinux.launcher\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && "
"n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#, c-format
msgid "Starting %s…"
msgstr "Запуск %s…"

msgid "Cancel"
msgstr "Отмена"

msgid "Menu"
msgstr "Меню"

msgid "Open"
msgstr "Открыть"

msgid "Back"
msgstr "Назад"

msgid "List"
msgstr "Список"

msgid "Icons"
msgstr "Значки"

msgid "Close"
msgstr "Закрыть"

msgid "Unlock"
msgstr "Разблокировать"

msgid "Apps"
msgstr "Приложения"

msgid "No apps installed"
msgstr "Приложения не установлены"

msgid "App stopped"
msgstr "Приложение остановлено"

msgid "It closed unexpectedly. Open it again from the menu."
msgstr "Оно неожиданно закрылось. Откройте его снова из меню."

msgid "App unavailable"
msgstr "Приложение недоступно"

msgid "It is missing or cannot run. Reinstall its package."
msgstr "Оно удалено или не может работать. Переустановите его пакет."

msgid "App did not start"
msgstr "Приложение не запустилось"

msgid "Try again. If it fails again, reinstall it."
msgstr "Попробуйте ещё раз. Если не поможет, переустановите его."

msgid "Now press *"
msgstr "Теперь нажмите *"

msgid "Press Unlock, then *"
msgstr "«Разблокировать», затем *"

msgid "Battery low"
msgstr "Низкий заряд"

msgid "Connect the charger soon."
msgstr "Скоро подключите зарядное устройство."

msgid "Battery almost empty"
msgstr "Батарея почти разряжена"

msgid "Connect the charger now."
msgstr "Подключите зарядное устройство сейчас."

msgid "Action failed"
msgstr "Не выполнено"

msgid "Try again."
msgstr "Попробуйте ещё раз."

msgid "Tasks"
msgstr "Задачи"

msgid "Open apps"
msgstr "Открытые приложения"

msgid "No open apps"
msgstr "Нет открытых приложений"

msgid "Foreground"
msgstr "На экране"

msgid "Background"
msgstr "В фоне"

msgid "Closing"
msgstr "Закрывается"

msgid "Close app"
msgstr "Закрыть приложение"

#, c-format
msgid "Close %s? Unsaved changes may be lost."
msgstr "Закрыть %s? Несохранённые изменения могут быть потеряны."

msgid "Cannot close the application. Try again."
msgstr "Не удалось закрыть приложение. Попробуйте ещё раз."

msgid "Cannot switch applications. Try again."
msgstr "Не удалось переключить приложение. Попробуйте ещё раз."

msgid "Cannot read open applications. Try again."
msgstr "Не удалось получить список приложений. Попробуйте ещё раз."

msgid "This application is no longer available. Choose another."
msgstr "Это приложение уже недоступно. Выберите другое."

msgid "Too many open apps"
msgstr "Слишком много открытых приложений"

msgid "Close an application in Tasks, then try again. Your open applications were kept."
msgstr "Закройте приложение в «Задачах» и попробуйте ещё раз. Открытые приложения не закрыты."

msgid "Alarm"
msgstr "Будильник"

msgid "Time is up"
msgstr "Время вышло"

msgid "Timer"
msgstr "Таймер"

msgid "Stop"
msgstr "Стоп"

msgid "Snooze"
msgstr "Отложить"

#, c-format
msgid "Snooze: %u min"
msgstr "Повтор: %u мин"

#, c-format
msgid "Missed: %llu"
msgstr "Пропущено: %llu"

msgid "Waiting…"
msgstr "Ожидание…"

msgid "Action failed. Try again."
msgstr "Не удалось выполнить действие. Попробуйте ещё раз."
