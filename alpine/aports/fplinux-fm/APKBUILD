# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-fm
pkgver=1.0.0
pkgrel=0
pkgdesc="FM radio tuning and playback for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-audiod"
makedepends_build="clang23 lld23 llvm23"
makedepends_host="musl-dev linux-headers"
options="!check"
source="
	fplinux-fm.c
	fplinux-audio-protocol.h
	fplinux-audio-route.h
	fplinux-audio-radio.c
	fplinux-audio-radio.h
	fplinux-cli.c
	fplinux-cli.h
"
builddir="$srcdir"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm23/bin/llvm-ar
	export RANLIB=/usr/lib/llvm23/bin/llvm-ranlib
	"$CC" $CPPFLAGS $CFLAGS -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-fm.c" "$srcdir/fplinux-cli.c" \
		"$srcdir/fplinux-audio-radio.c" \
		$LDFLAGS -Wl,--gc-sections -o fplinux-fm
}

package() {
	install -Dm755 "$builddir/fplinux-fm" "$pkgdir/usr/bin/fplinux-fm"
}

