# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-fm
pkgver=1
pkgrel=0
pkgdesc="FM radio tuning and playback for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="alsa-lib"
makedepends_build="clang22 lld22"
makedepends_host="alsa-lib-dev musl-dev linux-headers"
options="!check"
source="
	fplinux-fm.c
	fplinux-cli.c
	fplinux-cli.h
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-fm.c" "$srcdir/fplinux-cli.c" \
		$LDFLAGS -Wl,--gc-sections -lasound -o fplinux-fm
}

package() {
	install -Dm755 "$builddir/fplinux-fm" "$pkgdir/usr/bin/fplinux-fm"
}

