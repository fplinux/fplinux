60be1ccccf0215ea13bc64fd442a0498e7db203234ce74f92cec502295e8ac703a089438848b9a1850102836855537f561e9bd8313751574a069eb0ec6dcf31a  fplinux-cli.c
9677a324ea1cbcca154f472c83eb0660badfa11c2b444116f27080bd839dee2ab9ea6ef3b0c495f6074207559b813c843f284786f8b1e3c89023121b5aacb453  fplinux-cli.h
be3ce49e0e93e0cd040cd3b0be0b6091a9420d24d822b5b4921c63c2dd1b9e76a392854ee0b22d15581f0e913d41252599a571cb9dfb63114d7242d8bf9f198c  fplinux-jack.initd
