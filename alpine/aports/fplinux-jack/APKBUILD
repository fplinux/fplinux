# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-jack
pkgver=1
pkgrel=0
pkgdesc="Headphone jack output switching for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="alsa-lib fplinux-base"
makedepends_build="clang22 lld22"
makedepends_host="alsa-lib-dev musl-dev"
options="!check"
source="
	fplinux-jack.c
	fplinux-cli.c
	fplinux-cli.h
	fplinux-jack.initd
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" "$srcdir/fplinux-jack.c" "$srcdir/fplinux-cli.c" \
		$LDFLAGS -Wl,--gc-sections -lasound -o fplinux-jack
}

package() {
	install -Dm755 "$builddir/fplinux-jack" "$pkgdir/usr/bin/fplinux-jack"
	install -Dm755 "$srcdir/fplinux-jack.initd" \
		"$pkgdir/etc/init.d/fplinux-jack"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-jack \
		"$pkgdir/etc/runlevels/default/fplinux-jack"
}

