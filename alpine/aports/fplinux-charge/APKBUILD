# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-charge
pkgver=1
pkgrel=0
pkgdesc="Application charge measurement helper for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev"
options="!check"
source="fplinux-charge.c"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		"$srcdir/fplinux-charge.c" $LDFLAGS -o fplinux-charge
}

package() {
	install -Dm755 "$builddir/fplinux-charge" \
		"$pkgdir/usr/bin/fplinux-charge"
}

sha512sums="
ad2a4019578f5696bd69f00bf9dfc42e3642272c484d5f4f79bd46836b6ea1bec9ebd1781b007501ac0ea85509564688f10ee5bfddf7499ee1b2b87e0c6882f7  fplinux-charge.c
"
