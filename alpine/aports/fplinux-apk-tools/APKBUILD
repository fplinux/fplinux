# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-apk-tools
pkgver=3.0.8
pkgrel=0
pkgdesc="Alpine Package Keeper for FPLinux built with Mbed TLS instead of OpenSSL"
url="https://gitlab.alpinelinux.org/alpine/apk-tools"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-uclient"
makedepends_build="clang22 lld22 llvm22 meson samurai"
makedepends_host="linux-headers fplinux-mbedtls-static-dev musl-dev zlib-dev"
options="!check"
source="https://gitlab.alpinelinux.org/alpine/apk-tools/-/archive/v$pkgver/apk-tools-v$pkgver.tar.gz
	0001-static-mbedtls.patch
	"
builddir="$srcdir/apk-tools-v$pkgver"

build() {
	: "${CHOST:?missing target CHOST}" "${CBUILDROOT:?missing target sysroot}"
	# abuild-meson describes the target machine and sysroot; this file adds
	# the archiver and keeps pkg-config inside the sysroot.
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '/usr/lib/llvm22/bin/llvm-ar'
		[properties]
		pkg_config_libdir = ['$CBUILDROOT/usr/lib/pkgconfig', '$CBUILDROOT/usr/share/pkgconfig']
	EOF
	# Mbed TLS provides the digests and signatures; downloads go through
	# uclient-fetch with its Mbed TLS backend. Help text needs Lua and is
	# left out. Thumb-2 keeps the binaries smaller than the ARM instruction
	# set, as in the Alpine build.
	CFLAGS="$CFLAGS -mthumb" VERSION="$pkgver-r$pkgrel" abuild-meson \
		--cross-file fplinux-cross.meson \
		--auto-features=disabled \
		--bindir=/sbin \
		-Ddefault_library=static \
		-Darch=armv7 \
		-Dcrypto_backend=mbedtls \
		-Ddocs=disabled \
		-Dhelp=disabled \
		-Dlua=disabled \
		-Dminimal=true \
		-Dpython=disabled \
		-Dtests=disabled \
		-Durl_backend=wget \
		-Dzstd=disabled \
		output
	ninja -j"${JOBS:-1}" -C output
}

package() {
	install -Dm755 output/src/apk "$pkgdir/sbin/apk"
	install -Dm644 "$CBUILDROOT/usr/share/licenses/fplinux-mbedtls-static-dev/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/MbedTLS-LICENSE"
}

