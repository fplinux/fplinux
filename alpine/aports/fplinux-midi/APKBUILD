# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-midi
pkgver=1.0.0
pkgrel=0
pkgdesc="Shared bounded MIDI and tone renderer for FPLinux applications"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="LGPL-2.1-or-later AND MIT"
makedepends_build="clang23 lld23 patch"
makedepends_host="musl-dev"
subpackages="$pkgname-dev"
options="!check"
source="
	fplinux-midi.c
	fplinux-midi-smf.c
	fplinux-midi-tone.c
	fplinux-midi-synth.c
	fplinux-midi-internal.h
	fplinux-midi.h
	fplinux-midi.pc
	fplinux-midi.map
	@source:aport_tinysoundfont_853a0a17_h@
	borrowed-s16.patch
"
builddir="$srcdir"

prepare() {
	mkdir -p upstream
	sed 's/\r$//' tsf.h > upstream/tsf.h
	builddir="$srcdir/upstream"
	default_prepare
	builddir="$srcdir"
}

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-isystem upstream -shared \
		fplinux-midi.c fplinux-midi-smf.c fplinux-midi-tone.c fplinux-midi-synth.c \
		-pthread -lm $LDFLAGS \
		-Wl,-soname,libfplinux-midi.so.1 -Wl,--version-script=fplinux-midi.map \
		-o libfplinux-midi.so.1
}

package() {
	install -Dm755 libfplinux-midi.so.1 "$pkgdir/usr/lib/libfplinux-midi.so.1"
	ln -s libfplinux-midi.so.1 "$pkgdir/usr/lib/libfplinux-midi.so"
	install -Dm644 fplinux-midi.h "$pkgdir/usr/include/fplinux/fplinux-midi.h"
	install -Dm644 fplinux-midi.pc "$pkgdir/usr/lib/pkgconfig/fplinux-midi.pc"
	install -d "$pkgdir/usr/share/licenses/$pkgname"
	sed -n '/   LICENSE (MIT)/,/^\*\//p' upstream/tsf.h \
		> "$pkgdir/usr/share/licenses/$pkgname/TinySoundFont.txt"
}

