+static int tsf_region_modulators(struct tsf_region* region, struct tsf_hydra* hydra, unsigned int begin, unsigned int end)
+{
+	unsigned int i;
+	if (end > (unsigned int)hydra->imodNum || begin > end) return 0;
+	for (i = begin; i < end; i++)
+	{
+		struct tsf_hydra_imod* m = &hydra->imods[i];
+		if (!m->modAmtSrcOper && !m->modTransOper)
+		{
+			if (m->modSrcOper == 13 && m->modDestOper == 5 && m->modAmount == 10) region->pressureModPitch = m->modAmount;
+			else if (m->modSrcOper == 13 && m->modDestOper == 6 && !m->modAmount) region->pressureVibPitch = 0;
+			else if (m->modSrcOper == 129 && m->modDestOper == 5 && m->modAmount == -10) region->ccModPitch = m->modAmount;
+			else if (m->modSrcOper == 129 && m->modDestOper == 6 && (m->modAmount == -50 || !m->modAmount)) region->ccVibPitch = m->modAmount;
+			else if (m->modSrcOper == 219 && m->modDestOper == 16 && (m->modAmount == 500 || m->modAmount == 1000)) continue;
+			else if (m->modSrcOper == 221 && m->modDestOper == 15 && m->modAmount == 1000) continue;
+			else if (m->modSrcOper == 650 && m->modDestOper == 17 && m->modAmount == 1000) continue;
+			else return 0;
+		}
+		else if (!(m->modSrcOper == 258 && m->modDestOper == 8 && !m->modAmount && m->modAmtSrcOper == 3330 && !m->modTransOper)) return 0;
+	}
+	return 1;
+}
