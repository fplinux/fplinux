# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-bluealsa
pkgver=@version:aport_bluez_alsa_5_0_0_tar_gz@
pkgrel=0
pkgdesc="ALSA A2DP source with the SBC Bluetooth audio codec"
url="https://github.com/arkq/bluez-alsa"
arch="armv7"
license="MIT AND GPL-2.0-only AND LGPL-2.1-or-later AND BSD-3-Clause AND Zlib"
depends="fplinux-alsa-lib fplinux-bluez fplinux-bluez-libs fplinux-sbc"
makedepends_build="autoconf automake clang22 glib-dev libtool lld22 llvm22 make pkgconf python3"
makedepends_host="dbus-dev fplinux-alsa-lib-dev fplinux-bluez-dev fplinux-glib-static-dev fplinux-sbc-dev musl-dev"
options="!check"
source="
	@source:aport_bluez_alsa_5_0_0_tar_gz@
	@source:aport_libffi_license@
	@source:aport_pcre2_licence@
	@source:aport_zlib_license@
	bluealsa.initd
"
builddir="$srcdir/bluez-alsa-$pkgver"

prepare() {
	default_prepare
	autoreconf -fi
}

_static_glib_libs() {
	local libs library archive
	libs=$(pkg-config --static --libs "$1")
	# Keep these as linker dependencies through the convenience archive.
	# Exact archive selectors prevent choosing the shared counterparts.
	for library in ffi pcre2-8 z atomic; do
		archive="$CBUILDROOT/usr/lib/lib$library.a"
		test -f "$archive"
		libs=$(printf '%s\n' "$libs" | sed -E \
			"s@(^|[[:space:]])-l$library([[:space:]]|$)@\1-l:lib$library.a\2@g")
	done
	printf '%s\n' "$libs"
}

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin -mthumb -ffunction-sections -fdata-sections"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe -Wl,--gc-sections"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	local gio_libs glib_libs
	gio_libs=$(_static_glib_libs gio-unix-2.0)
	glib_libs=$(_static_glib_libs glib-2.0)
	# Keep the GIO closure in the daemon; ALSA clients use the native PCM module.
	GIO2_LIBS="$gio_libs" \
	GLIB2_LIBS="$glib_libs" \
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--with-alsaplugindir=/usr/lib/alsa-lib \
		--with-alsaconfdir=/etc/alsa/conf.d \
		--with-dbusconfdir=/usr/share/dbus-1/system.d \
		--with-dbus-iface-xml=/usr/share/dbus-1/interfaces \
		--disable-static \
		--disable-aplay
	make -j"${JOBS:-1}"
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm755 "$srcdir/bluealsa.initd" "$pkgdir/etc/init.d/bluealsa"
	install -Dm644 "$builddir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$CBUILDROOT/usr/share/licenses/fplinux-glib-static-dev/LGPL-2.1-or-later.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/LGPL-2.1-or-later.txt"
	local name
	for name in libffi-LICENSE pcre2-LICENCE zlib-LICENSE; do
		install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/licenses/$pkgname/$name"
	done
}
sha512sums="
