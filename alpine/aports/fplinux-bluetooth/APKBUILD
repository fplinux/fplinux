# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-bluetooth
pkgver=1
pkgrel=0
pkgdesc="BlueZ OPP and PAN client for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="bluez bluez-obexd bluez-openrc dbus dbus-openrc fplinux-glib fplinux-libical fplinux-libudev"
makedepends_build="clang22 lld22"
makedepends_host="dbus-dev musl-dev pkgconf"
options="!check"
source="
	fplinux-bluetooth.c
	fplinux-cli.c
	fplinux-cli.h
	fplinux-obexd.initd
	fplinux-bluetooth-setup.initd
	bluetooth-options.sh
	fplinux-bluetooth.conf
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" \
		$(pkg-config --cflags dbus-1) "$srcdir/fplinux-bluetooth.c" \
		"$srcdir/fplinux-cli.c" $(pkg-config --libs dbus-1) $LDFLAGS \
		-Wl,--gc-sections -o fplinux-bluetooth
}

package() {
	install -Dm755 "$builddir/fplinux-bluetooth" \
		"$pkgdir/usr/bin/fplinux-bluetooth"
	install -Dm755 "$srcdir/fplinux-obexd.initd" \
		"$pkgdir/etc/init.d/fplinux-obexd"
	install -Dm755 "$srcdir/fplinux-bluetooth-setup.initd" \
		"$pkgdir/etc/init.d/fplinux-bluetooth-setup"
	install -Dm644 "$srcdir/bluetooth-options.sh" \
		"$pkgdir/etc/conf.d/bluetooth"
	install -Dm644 "$srcdir/fplinux-bluetooth.conf" \
		"$pkgdir/etc/bluetooth/fplinux.conf"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/fplinux-obexd \
		"$pkgdir/etc/runlevels/default/fplinux-obexd"
}

