# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-font-terminus
pkgver=@version:aport_terminus_font_4_49_1_tar_gz@
pkgrel=0
pkgdesc="Terminus bitmap fonts for FPLinux applications"
url="https://terminus-font.sourceforge.net/"
arch="noarch"
license="OFL-1.1"
makedepends_build="python3"
subpackages="$pkgname-6x12:font_6x12 $pkgname-8x16:font_8x16"
options="!check"
source="
	@source:aport_terminus_font_4_49_1_tar_gz@
"
builddir="$srcdir/terminus-font-$pkgver"

build() {
	python3 bin/bdftopsf.py -2 -o ter-u12n.psf ter-u12n.bdf
	python3 bin/bdftopsf.py -2 -o ter-u16n.psf ter-u16n.bdf
	patch -p1 -i alt/dv1.diff
	patch -p1 -i alt/ij1.diff
	python3 bin/bdftopsf.py -2 -o ter-u12n-terminal.psf ter-u12n.bdf
	python3 bin/bdftopsf.py -2 -o ter-u16n-terminal.psf ter-u16n.bdf
}

package() {
	install -Dm644 ter-u12n.psf "$pkgdir/usr/share/fplinux/fonts/ter-u12n.psf"
	install -Dm644 ter-u16n.psf "$pkgdir/usr/share/fplinux/fonts/ter-u16n.psf"
	install -Dm644 ter-u12n-terminal.psf "$pkgdir/usr/share/fplinux/fonts/ter-u12n-terminal.psf"
	install -Dm644 ter-u16n-terminal.psf "$pkgdir/usr/share/fplinux/fonts/ter-u16n-terminal.psf"
	install -Dm644 OFL.TXT "$pkgdir/usr/share/licenses/$pkgname/Terminus-OFL.txt"
}

_font() {
	pkgdesc="Terminus $1 bitmap font for FPLinux applications"
	depends=""
	provides="fplinux-font-terminus-data"
	amove "usr/share/fplinux/fonts/$2"
	ln -s "$2" "$subpkgdir/usr/share/fplinux/fonts/default.psf"
	install -Dm644 "$srcdir/terminus-font-$pkgver/OFL.TXT" \
		"$subpkgdir/usr/share/licenses/$subpkgname/Terminus-OFL.txt"
}

font_6x12() {
	_font 6x12 ter-u12n.psf
}

font_8x16() {
	_font 8x16 ter-u16n.psf
}
sha512sums="
"
