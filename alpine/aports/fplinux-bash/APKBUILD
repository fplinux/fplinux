# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-bash
pkgver=5.3.9
pkgrel=0
_shellver=${pkgver%.*}
_aport_commit=dff61c85c6c68e2c5fb8abac65f0dd97d4ad8763
_aport_source="https://raw.githubusercontent.com/alpinelinux/aports/$_aport_commit/main/bash"
pkgdesc="GNU Bash shell for FPLinux"
url="https://www.gnu.org/software/bash/"
arch="armv7"
license="GPL-3.0-or-later"
provides="bash=$pkgver-r1"
provider_priority=100
replaces="bash"
makedepends_build="bison clang22 flex lld22 make llvm22"
makedepends_host="musl-dev fplinux-readline-dev fplinux-ncurses-dev"
subpackages="$pkgname-dev $pkgname-doc $pkgname-loadables:loadables"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
options="!check"
source="bash-$_shellver.tar.gz::https://ftp.gnu.org/gnu/bash/bash-$_shellver.tar.gz
	bashrc::$_aport_source/bashrc
	bash-noinfo.patch::$_aport_source/bash-noinfo.patch
	profile-bashrc.sh::$_aport_source/profile-bashrc.sh
"
builddir="$srcdir/bash-$_shellver"

for _patch in 001 002 003 004 005 006 007 008 009; do
	source="$source https://ftp.gnu.org/gnu/bash/bash-$_shellver-patches/bash53-$_patch"
done

prepare() {
	local patch
	for patch in "$srcdir"/bash53-*; do
		patch -p0 -i "$patch"
	done
	default_prepare
	sed -i "s/@PACKAGE_VERSION@/$pkgver/" support/bash.pc.in
	# Readline's target include path must not enter native helper builds.
	sed -i '/^CCFLAGS_FOR_BUILD = /s/$(BASE_CCFLAGS)/$(filter-out -I$(RL_INCLUDEDIR),$(BASE_CCFLAGS))/' \
		Makefile.in builtins/Makefile.in
}

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	export CFLAGS="$CFLAGS -std=gnu17 -DSYS_BASHRC='\"/etc/bash/bashrc\"'"
	export CFLAGS_FOR_BUILD="-Os -std=gnu17"
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--bindir=/bin \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--with-curses \
		--disable-nls \
		--enable-readline \
		--without-bash-malloc \
		--with-installed-readline="$CBUILDROOT/usr"
	make y.tab.c
	make builtins/libbuiltins.a
	make
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 "$srcdir/bashrc" "$pkgdir/etc/bash/bashrc"
	install -Dm644 "$srcdir/profile-bashrc.sh" \
		"$pkgdir/etc/profile.d/00-bashrc.sh"
}

dev() {
	default_dev
	provides="bash-dev=$pkgver-r1"
	replaces="bash-dev"
	amove bin/bashbug usr/lib/bash/Makefile*
}

loadables() {
	pkgdesc="Optional loadable builtins for GNU Bash"
	depends="$pkgname=$pkgver-r$pkgrel"
	amove usr/lib/bash
}
