# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-icons
pkgver=1
pkgrel=0
_tablerver=3.48.0
pkgdesc="System glyphs and application tiles for the FPLinux graphical session"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="MIT"
makedepends_build="nodejs python3"
options="!check"
# fplinux-ui-profile.json is copied from lib/fplinux by the build.
source="
	tabler-icons-$_tablerver.tgz::https://registry.npmjs.org/@tabler/icons/-/icons-$_tablerver.tgz
	icons.json
	tile.svg
	generate-icons.py
	svgraster.py
	fplinux-ui-profile.json
"
builddir="$srcdir"

build() {
	# The pinned build image provides node and @resvg/resvg-js 2.6.2.
	NODE_PATH=/opt/quality/node-tools/node_modules PYTHONDONTWRITEBYTECODE=1 \
		python3 generate-icons.py --tabler package/icons \
		--manifest icons.json --profile fplinux-ui-profile.json \
		--tile-template tile.svg --project . \
		--out output --report icons-report.json
}

package() {
	mkdir -p "$pkgdir/usr/share"
	cp -R "$builddir/output/usr/share/fplinux" "$builddir/output/usr/share/icons" \
		"$pkgdir/usr/share/"
	install -Dm644 "$srcdir/package/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

