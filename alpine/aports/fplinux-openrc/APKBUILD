# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-openrc
pkgver=@version:aport_openrc_0_64_1_tar_gz@
pkgrel=0
pkgdesc="OpenRC service management for FPLinux"
url="https://github.com/OpenRC/openrc"
arch="armv7"
license="BSD-2-Clause"
depends="ifupdown-any $pkgname-user=$pkgver-r$pkgrel"
provides="openrc=$pkgver-r$pkgrel ifupdown-ng-openrc=0.12.1-r4"
provider_priority=100
replaces="openrc alpine-baselayout"
makedepends_build="clang22 lld22 meson llvm22"
makedepends_host="musl-dev bsd-compat-headers libcap-dev linux-headers"
subpackages="$pkgname-dev $pkgname-doc $pkgname-init:init $pkgname-user:user"
options="!check"
source="
	@source:aport_openrc_0_64_1_tar_gz@
	@source:aport_0001_call_sbin_mkmntdirs_in_localmount_openrc_service_patch@
	@source:aport_0002_fsck_don_t_add_c0_patch@
	@source:aport_0003_rc_pull_in_sysinit_and_boot_as_stacked_levels_when_n_patch@
	0004-consolefont-busybox.patch
	0005-early-keymap.patch
	0006-service-vrf.patch
	@source:aport_0007_clean_up_staticroute_config_remove_irrelevant_parts_patch@
	0008-keep-tmp-files.patch
	0009-service-netns.patch
	@source:aport_0010_init_d_user_add_a_respawn_delay_value_patch@
	@source:aport_supervise_daemon_defaults_patch@
	@source:aport_sysctl_readme_patch@
	@source:aport_openrc_logrotate@
	@source:aport_hwdrivers_initd@
	@source:aport_modules_initd@
	@source:aport_modloop_initd@
	@source:aport_networking_initd@
	@source:aport_modloop_confd@
	@source:aport_sysfsconf_initd@
	@source:aport_firstboot_initd@
	@source:aport_sysctl_initd@
	@source:aport_machine_id_initd@
"
builddir="$srcdir/openrc-$pkgver"

prepare() {
	default_prepare
	sed -i "s|@VCS_TAG@|$pkgver|" src/shared/version.h.in src/shared/version.in
}

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	cat >fplinux-cross.meson <<-EOF
		[binaries]
		ar = '/usr/lib/llvm22/bin/llvm-ar'
	EOF
	abuild-meson \
		--cross-file fplinux-cross.meson \
		-Db_lto=true -Db_lto_mode=thin -Db_lto_threads=2 \
		-Daudit=disabled \
		-Dselinux=disabled \
		-Dpam=false \
		-Dpkgconfig=true \
		-Dbash-completions=false \
		-Dzsh-completions=false \
		--default-library=shared \
		--prefix=/ \
		--bindir=/bin \
		--sbindir=/sbin \
		--libdir=/usr/lib \
		--libexecdir=/usr/libexec \
		output
	meson compile -j "${JOBS:-1}" -C output
}

package() {
	# The main package contains ELF files despite its service-package suffix.
	allpackages="$pkgname::$CARCH $subpackages"
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	rm -f "$pkgdir"/etc/runlevels/*/*
	rm -f "$pkgdir/etc/conf.d/network" "$pkgdir/etc/init.d/network" \
		"$pkgdir/etc/conf.d/hostname" "$pkgdir/etc/init.d/keymaps" \
		"$pkgdir/etc/conf.d/keymaps" "$pkgdir/etc/init.d/agetty" \
		"$pkgdir/etc/conf.d/agetty"
	local file name
	for file in "$srcdir"/*.initd; do
		name=${file##*/}
		install -Dm755 "$file" "$pkgdir/etc/init.d/${name%.initd}"
	done
	for file in "$srcdir"/*.confd; do
		name=${file##*/}
		install -Dm644 "$file" "$pkgdir/etc/conf.d/${name%.confd}"
	done
	install -Dm644 "$srcdir/openrc.logrotate" "$pkgdir/etc/logrotate.d/openrc"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	mkdir -p "$pkgdir/etc/local.d"
	ln -s rc-service "$pkgdir/sbin/service"

	cd "$pkgdir/usr/libexec/rc/bin"
	for name in einfon ewarnn ewarn eerrorn eerror ebegin eend ewend \
		eindent eoutdent esyslog eval_ecolors ewaitfile veinfo vewarn \
		vebegin veend vewend veindent veoutdent; do
		rm "$name"
		ln -s einfo "$name"
	done
	for name in service_starting service_stopping service_stopped \
		service_inactive service_wasinactive service_hotplugged \
		service_started_daemon service_crashed; do
		rm "$name"
		ln -s service_started "$name"
	done
	for name in service_set_value get_options save_options; do
		rm "$name"
		ln -s service_get_value "$name"
	done
	cd "$pkgdir/usr/libexec/rc/sbin"
	for name in mark_service_starting mark_service_stopping \
		mark_service_stopped mark_service_inactive mark_service_wasinactive \
		mark_service_hotplugged mark_service_failed mark_service_crashed; do
		rm "$name"
		ln -s mark_service_started "$name"
	done
}

init() {
	pkgdesc="Optional OpenRC init process"
	depends="$pkgname=$pkgver-r$pkgrel"
	provides="openrc-init=$pkgver-r$pkgrel"
	replaces="openrc-init"
	amove sbin/openrc-init sbin/openrc-shutdown
}

user() {
	pkgdesc="OpenRC user services without PAM"
	depends=""
	provides="openrc-user=$pkgver-r$pkgrel"
	provider_priority=100
	replaces="openrc-user"
	amove etc/init.d/user usr/libexec/rc/bin/openrc-user
}

dev() {
	default_dev
	provides="openrc-dev=$pkgver-r$pkgrel"
	replaces="openrc-dev"
}

doc() {
	default_doc
	amove usr/share/openrc/support
	mkdir -p "$pkgdir/usr/share"
	mv "$subpkgdir/usr/share/licenses" "$pkgdir/usr/share/"
}
