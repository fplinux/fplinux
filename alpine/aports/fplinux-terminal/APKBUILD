# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-terminal
pkgver=1
pkgrel=0
pkgdesc="Terminal for the FPLinux graphical session"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="bash fplinux-ui fplinux-libtsm ncurses-terminfo-base"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev fplinux-libtsm-dev fplinux-libxkbcommon-dev"
options="!check"
source="
	fplinux-terminal.c
	fplinux-terminal.h
	terminal-engine.c
	terminal-help.c
	terminal-help.h
	terminal-input.c
	terminal-pty.c
	terminal-pty.h
	terminal-pty-supervisor.c
	terminal-pty-supervisor.h
	terminal-render.c
	terminal-render.h
	terminal-session.c
	terminal-session.h
	fplinux-terminal.bashrc
	org.fplinux.terminal.desktop
	ru.po
	fplinux-cli.c
	fplinux-cli.h
	fplinux-keypad.h
	fplinux-multitap.c
	fplinux-multitap.h
	fplinux-language.c
	fplinux-language.h
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" $(pkg-config --cflags fplinux-ui) \
		fplinux-terminal.c terminal-engine.c terminal-help.c terminal-input.c \
		terminal-pty.c terminal-render.c terminal-session.c \
		fplinux-cli.c fplinux-multitap.c fplinux-language.c \
		$(pkg-config --libs fplinux-ui) -ltsm $LDFLAGS \
		-Wl,--gc-sections -o fplinux-terminal
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -static \
		terminal-pty-supervisor.c $LDFLAGS -o fplinux-terminal-pty
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 fplinux-terminal "$pkgdir/usr/bin/fplinux-terminal"
	install -Dm755 fplinux-terminal-pty "$pkgdir/usr/libexec/fplinux-terminal-pty"
	install -Dm644 fplinux-terminal.bashrc "$pkgdir/etc/fplinux/terminal.bashrc"
	install -Dm644 org.fplinux.terminal.desktop \
		"$pkgdir/usr/share/applications/org.fplinux.terminal.desktop"
	install -Dm644 ru.mo \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.terminal.mo"
}

