# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-terminal
pkgver=1
pkgrel=0
pkgdesc="Interactive DRM terminal for FPLinux phones"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="bash fplinux-input fplinux-xkb ncurses-terminfo-base fplinux-font-terminus-data"
makedepends_build="clang22 lld22 llvm22"
makedepends_host="musl-dev linux-headers gcc fplinux-libdrm-dev libevdev-dev eudev-dev fplinux-libxkbcommon-dev fplinux-libxkbcommon-static fplinux-libtsm-dev"
subpackages="$pkgname-openrc"
options="!check"
source="
	fplinux-terminal.c
	fplinux-terminal.h
	terminal-diagnostic.c
	terminal-diagnostic.h
	terminal-engine.c
	terminal-help.c
	terminal-help.h
	terminal-input.c
	terminal-keyboard.c
	terminal-keyboard.h
	terminal-pty.c
	terminal-pty.h
	terminal-render.c
	terminal-render.h
	fplinux-terminal.bashrc
	fplinux-terminal.initd
	fplinux-cli.c
	fplinux-cli.h
	fplinux-font.c
	fplinux-font.h
	fplinux-drm-session.c
	fplinux-drm-session.h
	fplinux-input-session.c
	fplinux-input-session.h
	fplinux-input-device.h
	fplinux-keypad.h
	fplinux-keyboard-text.c
	fplinux-keyboard-text.h
	fplinux-multitap.c
	fplinux-multitap.h
	fplinux-language.c
	fplinux-language.h
"
builddir="$srcdir"

build() {
	export CFLAGS="$CFLAGS -Oz -flto=thin"
	export CXXFLAGS="$CXXFLAGS -Oz -flto=thin"
	export LDFLAGS="$LDFLAGS -flto=thin -Wl,--thinlto-jobs=2 -Wl,--icf=safe"
	export AR=/usr/lib/llvm22/bin/llvm-ar
	export RANLIB=/usr/lib/llvm22/bin/llvm-ranlib
	"$CC" $CPPFLAGS $CFLAGS -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" -I"$CBUILDROOT/usr/include/libdrm" \
		-I"$CBUILDROOT/usr/include/libevdev-1.0" \
		fplinux-terminal.c terminal-diagnostic.c terminal-engine.c terminal-help.c \
		terminal-input.c \
		terminal-keyboard.c terminal-pty.c terminal-render.c \
		fplinux-cli.c fplinux-font.c fplinux-drm-session.c fplinux-input-session.c \
		fplinux-keyboard-text.c fplinux-multitap.c fplinux-language.c \
		$LDFLAGS -ltsm "$CBUILDROOT/usr/lib/libxkbcommon.a" -levdev -ludev -ldrm -o fplinux-terminal
}

package() {
	install -Dm755 fplinux-terminal "$pkgdir/usr/bin/fplinux-terminal"
	install -Dm755 fplinux-terminal.initd "$pkgdir/etc/init.d/fplinux-terminal"
	install -Dm644 fplinux-terminal.bashrc "$pkgdir/etc/fplinux/terminal.bashrc"
	install -Dm644 "$CBUILDROOT/usr/share/licenses/fplinux-libxkbcommon/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/libxkbcommon-LICENSE"
}

openrc() {
	default_openrc
	depends="$depends fplinux-input-openrc"
}

