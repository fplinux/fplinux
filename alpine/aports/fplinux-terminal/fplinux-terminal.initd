#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=sh disable=SC2034

name="FPLinux terminal"
description="Interactive terminal on the phone display"
supervisor=supervise-daemon
command=/usr/bin/fplinux-terminal
input_file=/dev/null
output_logger="/usr/libexec/fplinux/kmsg --level 6 --tag fplinux-terminal"
error_logger="/usr/libexec/fplinux/kmsg --level 3 --tag fplinux-terminal"
respawn_delay=1
respawn_max=0
retry="TERM/3/KILL/2"

depend() {
	need devfs
	after bootmisc fplinux-brightness
}

start_pre() {
	if service_started fplinux-session; then
		eerror "Stop fplinux-session before starting the DRM terminal"
		return 1
	fi
	return 0
}

start() {
	for device in /dev/dri/card[0-9]*; do
		if [ -c "$device" ]; then
			default_start
			return "$?"
		fi
	done
	einfo "No DRM display; terminal remains stopped"
	return 0
}
