# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-language-ru
pkgver=1
pkgrel=0
pkgdesc="Russian language definition for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="noarch"
license="GPL-2.0-only"
# Russian input uses the matching layout for external keyboards.
depends="fplinux-xkb-ru"
options="!check"
source="ru"

package() {
	install -Dm644 "$srcdir/ru" "$pkgdir/usr/share/fplinux/languages/ru"
}
sha512sums="
